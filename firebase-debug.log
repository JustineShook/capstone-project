         ])\n              : false;\n    }\n\n    function hasVerifiedRoleAndCategory(uid) {\n      return request.resource.data.role == \"onsite-mechanic\"\n        ? request.resource.data.category == \"Onsite Mechanics\" && verifiedMechanic(uid)\n        : request.resource.data.role == \"towing-company\"\n          ? request.resource.data.category == \"Towing\" && verifiedTowingCompany(uid)\n          : request.resource.data.role == \"shop-owner\"\n            ? request.resource.data.category == \"Auto Shops\" && verifiedShop(uid) && validShopListingProfile(uid)\n            : request.resource.data.role == \"homegarage\"\n              ? request.resource.data.category == \"Parking Lots\"\n                && get(/databases/$(database)/documents/users/$(uid)).data.role == \"homegarage\"\n                && verifiedHomeGarage(uid) && validHomeGarageListingProfile(uid)\n              : false;\n    }\n\n    function validPublicListingWrite(uid) {\n      return signedIn()\n        && request.auth.uid == uid\n        && hasExactPublicListingShape()\n        && hasValidProviderControlledFields()\n        && hasFixedMapCompatibilityFields(uid)\n        && hasValidRoleSpecificServices()\n        && hasVerifiedRoleAndCategory(uid);\n    }\n\n    function validPublicListingCreate(uid) {\n      return validPublicListingWrite(uid)\n        && (request.resource.data.role != \"shop-owner\"\n          || (request.resource.data.keys().hasAll([\"photoUrls\", \"hoursType\", \"is24Hours\", \"weeklyHours\"])\n            && (!request.resource.data.keys().hasAny([\"contactPhone\"])\n              || (request.resource.data.contactPhone is string && request.resource.data.contactPhone.size() >= 7))\n            && request.resource.data.photoUrls is list\n            && request.resource.data.hoursType in [\"24_7\", \"same_daily\", \"weekly\"]\n            && request.resource.data.is24Hours is bool\n            && request.resource.data.weeklyHours is list));\n    }\n\n    function verifiedVehicleOwner(uid) {\n      return get(/databases/$(database)/documents/users/$(uid)).data.role == \"owner\"\n        && get(/databases/$(database)/documents/users/$(uid)/ownerProfile/profile).data.verificationStatus == \"VERIFIED\";\n    }\n\n    function validBookingBase() {\n      let booking = request.resource.data;\n      return signedIn()\n        && verifiedVehicleOwner(request.auth.uid)\n        && booking.customerId == request.auth.uid\n        && booking.customerId is string\n        && booking.providerId is string\n        && booking.providerId != request.auth.uid\n        && booking.customerName is string\n        && booking.customerName.size() > 0\n        && booking.customerName.size() <= 120\n        && booking.customerEmail is string\n        && booking.customerEmail.size() <= 254\n        // Towing validates providerName against the active listing below; avoid duplicate shape checks here.\n        && (booking.bookingType == \"towing-company\"\n          ? (booking.customerPhone is string\n            && booking.customerPhone.size() > 0\n            && booking.customerPhone.size() <= 30\n            && booking.customerPhone == get(/databases/$(database)/documents/users/$(request.auth.uid)/ownerProfile/profile).data.personal.phone)\n          : (!booking.keys().hasAny([\"customerPhone\"])\n            || (booking.customerPhone is string && booking.customerPhone.size() <= 30)))\n        && (!booking.keys().hasAny([\"customerAddress\"])\n          || (booking.customerAddress is string\n            && booking.customerAddress.size() <= 300))\n        && (booking.bookingType == \"towing-company\"\n          || (booking.providerName is string\n            && booking.providerName.size() > 0\n            && booking.providerName.size() <= 120))\n        && booking.vehicleId is string\n        && booking.vehicleId.size() > 0\n        && booking.vehicle is string\n        && booking.vehicle.size() > 0\n        && booking.vehicle.size() <= 120\n        && booking.ve