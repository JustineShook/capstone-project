event.readAt == null\n        && event.createdAt == request.time && event.updatedAt == request.time\n        && beforeProfile.get(\"verificationStatus\", \"\") != event.status\n        && afterProfile.verificationStatus == event.status\n        && afterProfile.reviewedBy == request.auth.uid\n        && afterProfile.reviewedAt == request.time\n        && afterProfile.lastStatusNotificationId == notificationId;\n    }\n\n    function isPendingVerificationSubmission() {\n      return request.resource.data.verificationStatus == \"PENDING\";\n    }\n\n    function validAdminReview(uid, role, shop) {\n      let before = resource.data;\n      let after = request.resource.data;\n      let notificationPath = /databases/$(database)/documents/users/$(uid)/accountStatusNotifications/$(after.lastStatusNotificationId);\n      return isAdmin()\n        && before.uid == uid && before.role == role\n        && get(/databases/$(database)/documents/users/$(uid)).data.role == role\n        && (before.get(\"verificationStatus\", \"\") == \"PENDING\"\n          || (shop && !(\"verificationStatus\" in before) && before.verified == false))\n        && (!shop || before.verified == false)\n        && after.diff(before).affectedKeys().hasOnly(shop\n          ? [\"verificationStatus\", \"reviewedAt\", \"reviewedBy\", \"rejectionReason\", \"verified\", \"lastStatusNotificationId\",\n            \"businessName\", \"phone\", \"address\", \"latitude\", \"longitude\"]\n          : [\"verificationStatus\", \"reviewedAt\", \"reviewedBy\", \"rejectionReason\", \"verified\", \"lastStatusNotificationId\"])\n        && (shop || !after.diff(before).affectedKeys().hasAny([\"verified\"]))\n        && after.verificationStatus in [\"VERIFIED\", \"REJECTED\"]\n        && after.reviewedAt == request.time && after.reviewedBy == request.auth.uid\n        && after.lastStatusNotificationId is string\n        && existsAfter(notificationPath)\n        && getAfter(notificationPath).data.status == after.verificationStatus\n        && getAfter(notificationPath).data.providerId == uid\n        && getAfter(notificationPath).data.providerRole == role\n        && ((after.verificationStatus == \"VERIFIED\" && after.rejectionReason == \"\")\n          || (after.verificationStatus == \"REJECTED\" && after.rejectionReason is string && after.rejectionReason.size() >= 5 && after.rejectionReason.size() <= 500))\n        && (!shop || after.verified == (after.verificationStatus == \"VERIFIED\"))\n        && listingHiddenAfterReview(uid);\n    }\n\n    function validAdminAccountStatus(uid) {\n      let before = resource.data;\n      let after = request.resource.data;\n      let notificationPath = /databases/$(database)/documents/users/$(uid)/accountStatusNotifications/$(after.accountStatusNotificationId);\n      return isAdmin()\n        && before.uid == uid\n        && before.role in [\"onsite-mechanic\", \"shop-owner\", \"towing-company\", \"homegarage\", \"owner\"]\n        && after.role == before.role && after.uid == before.uid\n        && after.diff(before).affectedKeys().hasOnly([\"accountStatus\", \"accountStatusUpdatedAt\", \"accountStatusUpdatedBy\", \"accountStatusNotificationId\"])\n        && after.accountStatus in [\"active\", \"suspended\"]\n        && after.accountStatus != before.get(\"accountStatus\", \"active\")\n        && after.accountStatusUpdatedAt == request.time\n        && after.accountStatusUpdatedBy == request.auth.uid\n        && after.accountStatusNotificationId is string\n        && existsAfter(notificationPath)\n        && getAfter(notificationPath).data.status == (after.accountStatus == \"suspended\" ? \"SUSPENDED\" : \"ACTIVE\")\n        && getAfter(notificationPath).data.providerId == uid\n        && getAfter(notificationPath).data.providerRole == before.role;\n    }\n\n    function verifiedMechanic(uid) {\n      let profilePath = /databases/$(database)/documents/users/$(uid)/providerProfile/profile;\n      return exists(profilePath)\n        && get(profilePath).data.uid == request.auth.uid\n        && get(profilePath).data.role == \"onsite-mechanic\"\n        && get(profilePath).data.verificationStatus == \"VERIFIED\";\n    }\n\n    function verifiedTowingCompany(uid) {\n      let profilePath = /databases/$(database)/documents/users/$(uid)/towingCompanyProfile/profile;\n      return exists(profilePath)\n        && get(profilePath).data.uid == request.auth.uid\n        && get(profilePath).data.role == \"towing-company\"\n        && get(profilePath).data.verificationStatus == \"VERIFIED\";\n    }\n\n    function verifiedHomeGarage(uid) {\n      let profilePath = /databases/$(database)/documents/users/$(uid)/homeGarageVerification/profile;\n      return exists(profilePath)\n        && get(profilePath).data.uid == request.auth.uid\n        && get(profilePath).data.role == \"homegarage\"\n        && get(profilePath).data.verificationStatus == \"VERIFIED\";\n    }\n\n    function approvedHomeGarage(uid) {\n      let profilePath = /databases/$(database)/documents/users/$(uid)/homeGarageVerification/profile;\n      return exists(profilePath)\n        && get(profilePath).data.uid == uid\n        && get(profilePath).data.role == \"homegarage\"\n        && get(profilePath).data.verificationStatus == \"VERIFIED\";\n    }\n\n    function hasExactPublicListingShape() {\n      return request.resource.data.keys().hasOnly([\n          \"providerId\", \"role\", \"category\", \"businessName\", \"location\",\n          \"availability\", \"visibility\", \"ratingSummary\", \"services\",\n          \"vehicleTypes\", \"serviceAreaLabel\", \"description\", \"contactPhone\", \"startingPrice\", \"operatingHours\",\n          \"emergencyServiceAvailable\", \"acceptsScheduledBookings\", \"photoUrls\", \"hoursType\", \"is24Hours\", \"weeklyHours\", \"totalSlots\", \"availableSlots\"\n        ])\n        && request.resource.data.location.keys().hasOnly([\"latitude\", \"longitude\"])\n        && request.resource.data.ratingSummary.keys().hasOnly([\"average\", \"count\"]);\n    }\n\n    function hasValidProviderControlledFields() {\n      let latitude = request.resource.data.location.latitude;\n      let longitude = request.resource.data.location.longitude;\n      return request.resource.data.businessName is string\n        && request.resource.data.businessName.size() > 0\n        && request.resource.data.businessName.size() <= 120\n        && latitude is number\n        && latitude >= -90\n        && latitude <= 90\n        && longitude is number\n        && longitude >= -180\n        && longitude <= 180\n        && !(latitude == 0 && longitude == 0)\n        && request.resource.data.availability in [\"available\", \"busy\", \"offline\"]\n        && request.resource.data.serviceAreaLabel is string\n        && request.resource.data.serviceAreaLabel.size() >= 2\n        && request.resource.data.serviceAreaLabel.size() <= 120\n        && request.resource.data.description is string\n        && request.resource.data.description.size() <= 600\n        && (!request.resource.data.keys().hasAny([\"contactPhone\"])\n          || (request.resource.data.contactPhone is string\n            && request.resource.data.contactPhone.size() >= 7\n            && request.resource.data.contactPhone.size() <= 30))\n        && request.resource.data.operatingHours is string\n        && request.resource.data.operatingHours.size() >= 2\n        && request.resource.data.operatingHours.size() <= 200\n        && request.resource.data.services is list\n        && request.resource.data.services.size() >= 1\n        && ((request.resource.data.role == \"shop-owner\"\n              && request.resource.data.services.size() <= 7)\n          || (request.resource.data.role != \"shop-owner\"\n              && request.resource.data.services.size() <= 6))\n        && request.resource.data.vehicleTypes is list\n        && request.resource.data.vehicleTypes.size() >= 1\n        && request.resource.data.vehicleTypes.size() <= 6\n        && request.resource.da