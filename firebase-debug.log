  : false;\n    }\n\n    function hasVerifiedRoleAndCategory(uid) {\n      return request.resource.data.role == \"onsite-mechanic\"\n        ? request.resource.data.category == \"Onsite Mechanics\" && verifiedMechanic(uid)\n        : request.resource.data.role == \"towing-company\"\n          ? request.resource.data.category == \"Towing\" && verifiedTowingCompany(uid)\n          : request.resource.data.role == \"shop-owner\"\n            ? request.resource.data.category == \"Auto Shops\" && verifiedShop(uid) && validShopListingProfile(uid)\n            : request.resource.data.role == \"homegarage\"\n              ? request.resource.data.category == \"Parking Lots\"\n                && get(/databases/$(database)/documents/users/$(uid)).data.role == \"homegarage\"\n                && verifiedHomeGarage(uid) && validHomeGarageListingProfile(uid)\n              : false;\n    }\n\n    function validPublicListingUpdate(uid) {\n      let role = resource.data.role;\n      return signedIn()\n        && request.auth.uid == uid\n        && resource.data.providerId == uid\n        && request.resource.data.providerId == uid\n        && request.resource.data.role == role\n        && resource.data.category == request.resource.data.category\n        && request.resource.data.ratingSummary == resource.data.ratingSummary\n        && request.resource.data.visibility == \"active\"\n        && hasValidProviderControlledFields()\n        && hasValidRoleSpecificServices()\n        && hasVerifiedRoleAndCategory(uid);\n    }\n    function validPublicListingWrite(uid) {\n      return signedIn()\n        && request.auth.uid == uid\n        && hasExactPublicListingShape()\n        && hasValidProviderControlledFields()\n        && hasFixedMapCompatibilityFields(uid)\n        && hasValidRoleSpecificServices()\n        && hasVerifiedRoleAndCategory(uid);\n    }\n\n    function validPublicListingCreate(uid) {\n      return validPublicListingWrite(uid)\n        && (request.resource.data.role != \"sh