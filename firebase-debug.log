ta.verificationStatus == \"PENDING\";\n    }\n    match /{path=**}/towingCompanyProfile/{profileId} {\n      allow list: if isAdmin() && resource.data.verificationStatus == \"PENDING\";\n    }\n    match /{path=**}/shopVerification/{profileId} {\n      allow list: if isAdmin() && resource.data.verificationStatus == \"PENDING\";\n    }\n    match /{path=**}/homeGarageVerification/{profileId} {\n      allow list: if isAdmin() && resource.data.verificationStatus == \"PENDING\";\n    }\n\n    // Parking bookings are customer-controlled sessions. Capacity changes are\n    // only accepted alongside the app's Firestore transactions; providers\n    // never need to start or end a customer's parking session.\n    match /parkingBookings/{bookingId} {\n      // Stage 1 stops new sessions while existing sessions remain readable and completable.\n      allow create: if false;\n      allow get, list: if signedIn() && (resource.data.customerId == request.auth.uid || resource.data.providerId == request.auth.uid);\n      allow update: if signedIn() && resource.data.customerId == request.auth.uid\n        && ((resource.data.status == \"reserved\" && request.resource.data.status == \"active\"\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"parkingStartedAt\", \"updatedAt\"])\n          && request.resource.data.parkingStartedAt == request.time && request.resource.data.updatedAt == request.time)\n          || (resource.data.status == \"active\" && request.resource.data.status == \"completed\"\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"parkingEndedAt\", \"updatedAt\"])\n          && request.resource.data.parkingEndedAt == request.time && request.resource.data.updatedAt == request.time\n          && getAfter(/databases/$(database)/documents/parkingSlots/$(resource.data.slotId)).data.status == \"available\"));\n      allow delete: if false;\n    }\n\n    // A slot is the atomic capacity lock. 