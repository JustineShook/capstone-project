.resource.data.year >= 1900\n        && request.resource.data.year <= 2100\n        && request.resource.data.color is string\n        && request.resource.data.color.size() > 0\n        && request.resource.data.color.size() <= 40\n        && request.resource.data.plateNumber is string\n        && request.resource.data.plateNumber.size() > 0\n        && request.resource.data.plateNumber.size() <= 20;\n    }\n\n    function validProviderBookingTransition(bookingId) {\n      let before = resource.data.status;\n      let after = request.resource.data.status;\n      let providerId = resource.data.providerId;\n      let bookingType = resource.data.bookingType;\n      let targeted = bookingType in [\"onsite-mechanic\", \"towing-company\"];\n      return (before == \"pending\" && after == \"rejected\"\n          && optionalRiskEventIsValid(\"provider_decline\", \"pending\")\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"updatedAt\", \"declineReason\", \"riskEventType\", \"riskEventAt\"])\n          && optionalBookingReasonIsValid(request.resource.data, \"declineReason\"))\n        || (before == \"pending\" && after == \"accepted\"\n          && (resource.data.timingMode == \"scheduled\"\n            ? reservationClaimedFor(bookingId, resource.data)\n            : targeted && activeServiceAcquired(providerId, bookingId)))\n        || (before == \"pending\" && after == \"cancelled\")\n        || (before == \"accepted\" && after == \"en_route\"\n          && (targeted\n            ? (resource.data.timingMode == \"scheduled\"\n              ? (resource.data.scheduledAt is timestamp\n                && resource.data.scheduledAt <= request.time\n                && activeServiceAcquired(providerId, bookingId))\n              : (activeServiceOwnedBy(providerId, bookingId)\n                || activeServiceAcquired(providerId, bookingId)))\n            : true))\n        || (before == \"accepted\" && after == \"cancelled\"\n          && (targeted\n            ? (!activeServiceOwnedBy(providerId, bookingId)\n                || activeServiceReleased(providerId, bookingId))\n            : true))\n        || (before == \"en_route\" && after == \"arrived\"\n          && (!targeted || activeServiceOwnedBy(providerId, bookingId)))\n        || (before == \"en_route\" && after == \"cancelled\"\n          && (!targeted || activeServiceReleased(providerId, bookingId)))\n        || (before == \"arrived\" && after == \"in_progress\"\n          && (!targeted || activeServiceOwnedBy(providerId, bookingId)))\n        || (before == \"in_progress\" && after == \"completed\"\n          && (!targeted || activeServiceReleased(providerId, bookingId))\n          && request.resource.data.finalPrice is number\n          && request.resource.data.finalPrice >= 0\n          && request.resource.data.finalPrice <= 100000000\n          && request.resource.data.finalPrice * 100 % 1 == 0\n          && request.resource.data.completedAt == request.time\n          && request.resource.data.diff(resource.data).affectedKeys().hasAll([\"status\", \"updatedAt\", \"finalPrice\", \"completedAt\"]));\n    }\n\n    function validMechanicLocationUpdate() {\n      return resource.data.bookingType == \"onsite-mechanic\"\n        && resource.data.status in [\"accepted\", \"en_route\", \"arrived\", \"in_progress\"]\n        && request.resource.data.mechanicLatitude is number\n        && request.resource.data.mechanicLatitude >= -90\n        && request.resource.data.mechanicLatitude <= 90\n        && request.resource.data.mechanicLongitude is number\n        && request.resource.data.mechanicLongitude >= -180\n        && request.resource.data.mechanicLongitude <= 180\n        && request.resource.data.mechanicLocationUpdatedAt == request.time;\n    }\n\n    function validProviderReview(reviewId) {\n      let bookingPath = /databases/$(database)/documents/bookings/$(reviewId);\n      let booking = get(bookingPath).data;\n      return signedIn()\n        && exists(bookingPath)\n        && request.resource.data.keys().hasOnly([\n          \"bookingId\", \"customerId\", \"providerId\", \"providerRole\", \"rating\",\n          \"comment\", \"createdAt\", \"updatedAt\"\n        ])\n        && request.resource.data.bookingId == reviewId\n        && request.resource.data.customerId == request.auth.uid\n        && booking.customerId == request.auth.uid\n        && booking.status == \"completed\"\n        && request.resource.data.providerId == booking.providerId\n        && request.resource.data.providerId != request.auth.uid\n        && request.resource.data.providerRole == booking.bookingType\n        && request.resource.data.providerRole in [\"onsite-mechanic\", \"towing-company\", \"shop-owner\", \"homegarage\"]\n        && request.resource.data.rating is int\n        && request.resource.data.rating >= 1\n        && request.resource.data.rating <= 5\n        && request.resource.data.comment is string\n        && request.resource.data.comment.size() <= 1000\n        && request.resource.data.createdAt == request.time\n        && request.resource.data.updatedAt == request.time;\n    }\n\n    function validParkingProviderReview(reviewId) {\n      let bookingPath = /databases/$(database)/documents/parkingBookings/$(reviewId);\n      let booking = get(bookingPath).data;\n      return signedIn()\n        && exists(bookingPath)\n        && request.resource.data.keys().hasOnly([\n          \"bookingId\", \"customerId\", \"providerId\", \"providerRole\", \"rating\",\n          \"comment\", \"createdAt\", \"updatedAt\"\n        ])\n        && request.resource.data.bookingId == reviewId\n        && request.resource.data.customerId == request.auth.uid\n        && booking.customerId == request.auth.uid\n        && booking.status == \"completed\"\n        && request.resource.data.providerId == booking.providerId\n        && request.resource.data.providerId != request.auth.uid\n        && request.resource.data.providerRole == \"homegarage\"\n        && request.resource.data.rating is int\n        && request.resource.data.rating >= 1\n        && request.resource.data.rating <= 5\n        && request.resource.data.comment is string\n        && request.resource.data.comment.size() <= 1000\n        && request.resource.data.createdAt == request.time\n        && request.resource.data.updatedAt == request.time;\n    }\n\n    // General account data remains private to its account owner.\n    match /users/{uid} {\n      allow create: if isDocumentOwner(uid)\n        && request.resource.data.uid == uid\n        && request.resource.data.role in [\"owner\", \"onsite-mechanic\", \"shop-owner\", \"towing-company\", \"homegarage\"];\n      allow get: if isDocumentOwner(uid)\n        || (isAdmin() && resource.data.role in [\"onsite-mechanic\", \"shop-owner\", \"towing-company\", \"homegarage\", \"owner\"]);\n      allow list: if isAdmin();\n      allow update: if validAdminAccountStatus(uid);\n      allow update: if isDocumentOwner(uid)\n        && request.resource.data.uid == resource.data.uid\n        && request.resource.data.role == resource.data.role\n        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([\n          \"accountStatus\", \"accountStatusUpdatedAt\", \"accountStatusUpdatedBy\", \"accountStatusNotificationId\"\n        ]);\n      allow delete: if false;\n\n      match /vehicles/{vehicleId} {\n        allow get, list: if isDocumentOwner(uid);\n        allow create: if isDocumentOwner(uid)\n          && validVehicleShape(vehicleId)\n          && request.resource.data.createdAt == request.time\n          && request.resource.data.updatedAt == request.time;\n        allow update: if isDocumentOwner(uid)\n          && validVehicleShape(vehicleId)\n          && request.resource.data.vehicleId == resource.data.vehicleId\n          && request.resource.data.createdAt == resource.data.createdAt\n          && request.resource.data.updatedAt == request.time\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n            \"type\", \"make\", \"model\", \"year\", \"color\", \"plateNumber\", \"updatedAt\"\n          ]);\n        allow delete: if isDocumentOwner(uid);\n      }\n\n      match /notifications/{notificationId} {\n        allow get, list: if isDocumentOwner(uid);\n        allow create: if validCustomerNotificationCreate(uid, notificationId);\n        allow update: if (isDocumentOwner(uid)\n            && resource.data.customerId == uid\n            && resource.data.isRead == false\n            && request.resource.data.isRead == true\n            && request.resource.data.readAt == request.time\n            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"isRead\", \"readAt\"]))\n          || validCustomerNotificationUpdate(uid, notificationId);\n        allow delete: if false;\n      }\n\n      match /mechanicNotifications/{notificationId} {\n        allow get, list: if isDocumentOwner(uid);\n        allow create: if validMechanicNotificationCreate(uid, notificationId);\n        allow update: if (isDocumentOwner(uid)\n            && resource.data.providerId == uid\n            && resource.data.isRead == false\n            && request.resource.data.isRead == true\n            && request.resource.data.readAt == request.time\n            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"isRead\", \"readAt\"]))\n          || validMechanicNotificationUpdate(uid, notificationId);\n        allow delete: if false;\n      }\n\n      match /towingNotifications/{notificationId} {\n        allow get, list: if isDocumentOwner(uid);\n        allow create: if validTowingNotificationCreate(uid, notificationId);\n        allow update: if (isDocumentOwner(uid)\n            && resource.data.providerId == uid\n            && resource.data.isRead == false\n            && request.resource.data.isRead == true\n            && request.resource.data.readAt == request.time\n            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"isRead\", \"readAt\"]))\n          || validTowingNotificationUpdate(uid, notificationId);\n        allow delete: if false;\n      }\n\n      match /shopNotifications/{notificationId} {\n        allow get, list: if isDocumentOwner(uid);\n        allow create: if validShopNotificationCreate(uid, notificationId);\n        allow update: if (isDocumentOwner(uid)\n            && resource.data.providerId == uid\n            && resource.data.isRead == false\n            && request.resource.data.isRead == true\n            && request.resource.data.readAt == request.time\n            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"isRead\", \"readAt\"]))\n          || validShopNotificationUpdate(uid, notificationId);\n        allow delete: if false;\n      }\n\n      match /homeGarageNotifications/{notificationId} {\n        allow get, list: if isDocumentOwner(uid);\n        allow create: if validHomeGarageNotificationCreate(uid, notificationId);\n        allow update: if (isDocumentOwner(uid) && resource.data.providerId == uid\n            && resource.data.isRead == false && request.resource.data.isRead == true\n            && request.resource.data.readAt == request.time\n            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"isRead\", \"readAt\"]))\n          || validHomeGarageNotificationUpdate(uid, notificationId);\n        allow delete: if false;\n      }\n\n      // Account status messages are created by admins in the same batch as a\n      // provider status transition.\n      match /accountStatusNotifications/{notificationId} {\n        allow get, list: if isDocumentOwner(uid);\n        allow create: if request.resource.data.keys().hasOnly([\n            \"notificationId\", \"providerId\", \"providerRole\", \"status\", \"previousStatus\", \"title\", \"message\", \"reason\",\n            \"isRead\", \"readAt\", \"createdAt\", \"updatedAt\"\n          ])\n          && (validAdminVerificationNotification(uid, notificationId)\n            || validAdminAccountStatusNotification(uid, notificationId));\n        allow update: if isDocumentOwner(uid)\n          && resource.data.providerId == uid\n          && resource.data.isRead == false\n          && request.resource.data.isRead == true\n          && request.resource.data.readAt == request.time\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"isRead\", \"readAt\"]);\n        allow update: if isAdmin()\n          && resource.data.providerId == uid\n          && resource.data.status == \"ACTIVE\"\n          && get(/databases/$(database)/documents/users/$(uid)).data.accountStatus == \"active\"\n          && get(/databases/$(database)/documents/users/$(uid)).data.accountStatusNotificationId == notificationId\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"message\", \"updatedAt\"])\n          && request.resource.data.message is string\n          && request.resource.data.updatedAt == request.time;\n        allow delete: if false;\n      }\n\n      // Per-shop idempotency pointer, private to the vehicle owner.\n      match /shopBookingLocks/{providerId} {\n        allow get: if isDocumentOwner(uid);\n        allow list: if false;\n        allow create, update: if validShopBookingLockWrite(uid, providerId);\n        allow delete: if false;\n      }\n\n      match /homeGarageBookingLocks/{providerId} {\n        allow get: if isDocumentOwner(uid);\n        allow list: if false;\n        allow create, update: if validHomeGarageBookingLockWrite(uid, providerId);\n        allow delete: if false;\n      }\n\n      // Providers may submit and resubmit private verification information,\n      // but cannot mark themselves as verified from the client application.\n      match /ownerProfile/profile {\n        allow get: if isDocumentOwner(uid) || isAdmin();\n        allow update: if validAdminReview(uid, \"owner\", false);\n        allow create, update: if isDocumentOwner(uid)\n          && request.resource.data.uid == uid\n          && request.resource.data.role == \"owner\"\n          && isPendingVerificationSubmission();\n        allow update: if isDocumentOwner(uid)\n          && request.resource.data.uid == resource.data.uid\n          && request.resource.data.role == resource.data.role\n          && request.resource.data.verificationStatus == resource.data.verificationStatus\n          && request.resource.data.identification == resource.data.identification\n          && request.resource.data.vehicleDocuments == resource.data.vehicleDocuments\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"personal\", \"updatedAt\"])\n          && request.resource.data.personal.keys().hasOnly([\"fullName\", \"phone\", \"address\", \"cityMunicipality\"])\n          && request.resource.data.personal.fullName is string\n          && request.resource.data.personal.phone is string\n          && request.resource.data.personal.address is string\n          && request.resource.data.personal.cityMunicipality is string;\n        allow delete: if false;\n      }\n\n      match /providerProfile/profile {\n        allow get: if isDocumentOwner(uid) || isAdmin();\n        allow list: if isAdmin() && resource.data.verificationStatus == \"PENDING\";\n        allow create: if isDocumentOwner(uid) && isPendingVerificationSubmission();\n        allow update: if validAdminReview(uid, \"onsite-mechanic\", false)\n          || (isDocumentOwner(uid) && isPendingVerificationSubmission())\n          || validMechanicProfileEdit(uid);\n        allow delete: if false;\n      }\n\n      match /towingCompanyProfile/profile {\n        allow get: if isDocumentOwner(uid) || isAdmin();\n        allow list: if isAdmin() && resource.data.verificationStatus == \"PENDING\";\n        allow create: if isDocumentOwner(uid)\n          && request.resource.data.uid == uid\n          && request.resource.data.role