\"]\n        && request.resource.data.availability == get(lockPath).data.previousAvailability\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"availability\"])\n        && booking.providerId == uid\n        && booking.bookingType in [\"onsite-mechanic\", \"towing-company\"]\n        && booking.status in [\"completed\", \"cancelled\"]\n        && !existsAfter(lockPath)\n        && (providerRelease || customerRelease);\n    }\n\n    function activeServiceOwnedBy(uid, bookingId) {\n      let lockPath = activeServicePath(uid);\n      return exists(lockPath)\n        && get(lockPath).data.providerId == uid\n        && get(lockPath).data.bookingId == bookingId;\n    }\n\n    function activeServiceAcquired(uid, bookingId) {\n      let lockPath = activeServicePath(uid);\n      return existsAfter(lockPath)\n        && getAfter(lockPath).data.providerId == uid\n        && getAfter(lockPath).data.bookingId == bookingId\n        && getAfter(/databases/$(database)/documents/providerListings/$(uid)).data.availability == \"busy\";\n    }\n    function validProviderListingUpdate(uid) {\n      let role = resource.data.role;\n      let changed = request.resource.data.diff(resource.data).affectedKeys();\n      return signedIn()\n        && (!changed.hasAny([\"contactPhone\"]) || request.resource.data.get(\"contactPhone\", \"\") == \"\")\n        && ((request.auth.uid == uid && (role == \"shop-owner\"\n          ? (changed.hasOnly([\"availability\"])\n            ? validShopAvailabilitySync(uid)\n            : changed.hasOnly([\"businessName\", \"location\", \"availability\", \"serviceAreaLabel\", \"description\", \"contactPhone\", \"services\", \"vehicleTypes\", \"operatingHours\", \"startingPrice\", \"emergencyServiceAvailable\", \"acceptsScheduledBookings\", \"photoUrls\", \"hoursType\", \"is24Hours\", \"weeklyHours\", \"visibility\"])\n              && validShopPublicListingUpdate(uid))\n          : role == \"onsite-mechanic\"\n            ? (changed.