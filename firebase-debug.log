tsAfter(lockPath)\n        && getAfter(lockPath).data.keys().hasOnly([\"providerId\", \"bookingId\", \"previousAvailability\", \"acquiredAt\"])\n        && getAfter(lockPath).data.providerId == uid\n        && getAfter(lockPath).data.bookingId is string\n        && getAfter(lockPath).data.previousAvailability == resource.data.availability\n        && getAfter(lockPath).data.acquiredAt == request.time\n        && beforeBooking.providerId == uid\n        && beforeBooking.bookingType == role\n        && afterBooking.providerId == uid\n        && afterBooking.bookingType == role\n        && ((beforeBooking.status == \"pending\" && afterBooking.status == \"accepted\"\n            && afterBooking.timingMode != \"scheduled\")\n          || (beforeBooking.status == \"accepted\" && afterBooking.status == \"en_route\"\n            && afterBooking.timingMode == \"scheduled\"\n            && afterBooking.scheduledAt is timestamp\n            && afterBooking.scheduledAt <= request.time));\n    }\n\n    function validActiveServiceRelease(uid) {\n      let lockPath = activeServicePath(uid);\n      let bookingPath = /databases/$(database)/documents/bookings/$(resource.data.bookingId);\n      let booking = get(bookingPath).data;\n      let afterBooking = getAfter(bookingPath).data;\n      let providerRelease = request.auth.uid == uid && accountIsActive(uid);\n      let customerRelease = request.auth.uid == booking.customerId\n        && booking.status == \"accepted\"\n        && afterBooking.status == \"cancelled\";\n      return signedIn()\n        && resource.data.providerId == uid\n        && resource.data.availability == \"busy\"\n        && request.resource.data.availability == get(lockPath).data.previousAvailability\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"availability\"])\n        && exists(lockPath)\n        && get(lockPath).data.providerId == uid\n        && get(lockPath).data.bookingId == resource.data.bookingId\n        && get(lockPa