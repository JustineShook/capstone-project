st.time\n          && request.resource.data.diff(resource.data).affectedKeys().hasAll([\"status\", \"updatedAt\", \"finalPrice\", \"completedAt\"]));\n    }\n\n    function validMechanicLocationUpdate() {\n      return resource.data.bookingType == \"onsite-mechanic\"\n        && resource.data.status in [\"accepted\", \"en_route\", \"arrived\", \"in_progress\"]\n        && request.resource.data.mechanicLatitude is number\n        && request.resource.data.mechanicLatitude >= -90\n        && request.resource.data.mechanicLatitude <= 90\n        && request.resource.data.mechanicLongitude is number\n        && request.resource.data.mechanicLongitude >= -180\n        && request.resource.data.mechanicLongitude <= 180\n        && request.resource.data.mechanicLocationUpdatedAt == request.time;\n    }\n\n    function validProviderReview(reviewId) {\n      let bookingPath = /databases/$(database)/documents/bookings/$(reviewId);\n      let booking = get(bookingPath).data;\n      return signedIn()\n        && exists(bookingPath)\n        && request.resource.data.keys().hasOnly([\n          \"bookingId\", \"customerId\", \"providerId\", \"providerRole\", \"rating\",\n          \"comment\", \"createdAt\", \"updatedAt\"\n        ])\n        && request.resource.data.bookingId == reviewId\n        && request.resource.data.customerId == request.auth.uid\n        && booking.customerId == request.auth.uid\n        && booking.status == \"completed\"\n        && request.resource.data.providerId == booking.providerId\n        && request.resource.data.providerId != request.auth.uid\n        && request.resource.data.providerRole == booking.bookingType\n        && request.resource.data.providerRole in [\"onsite-mechanic\", \"towing-company\", \"shop-owner\", \"homegarage\"]\n        && request.resource.data.rating is int\n        && request.resource.data.rating >= 1\n        && request.resource.data.rating <= 5\n        && request.resource.data.comment is string\n        && request.resource.data.comment.size() <= 1000\n        && request.resource.data.createdAt == request.time\n        && request.resource.data.updatedAt == request.time;\n    }\n\n    function validParkingProviderReview(reviewId) {\n      let bookingPath = /databases/$(database)/documents/parkingBookings/$(reviewId);\n      let booking = get(bookingPath).data;\n      return signedIn()\n        && exists(bookingPath)\n        && request.resource.data.keys().hasOnly([\n          \"bookingId\", \"customerId\", \"providerId\", \"providerRole\", \"rating\",\n          \"comment\", \"createdAt\", \"updatedAt\"\n        ])\n        && request.resource.data.bookingId == reviewId\n        && request.resource.data.customerId == request.auth.uid\n        && booking.customerId == request.auth.uid\n        && booking.status == \"completed\"\n        && request.resource.data.providerId == booking.providerId\n        && request.resource.data.providerId != request.auth.uid\n        && request.resource.data.providerRole == \"homegarage\"\n        && request.resource.data.rating is int\n        && request.resource.data.rating >= 1\n        && request.resource.data.rating <= 5\n        && request.resource.data.comment is string\n        && request.resource.data.comment.size() <= 1000\n        && request.resource.data.createdAt == request.time\n        && request.resource.data.updatedAt == request.time;\n    }\n\n    // General account data remains private to its account owner.\n    match /users/{uid} {\n      allow create: if isDocumentOwner(uid)\n        && request.resource.data.uid == uid\n        && request.resource.data.role in [\"owner\", \"onsite-mechanic\", \"shop-owner\", \"towing-company\", \"homegarage\"];\n      allow get: if isDocumentOwner(uid)\n        || (isAdmin() && resource.data.role in [\"onsite-mechanic\", \"shop-owner\", \"towing-company\", \"homegarage\", \"owner\"]);\n      allow list: if isAdmin();\n      allow update: if validAdminAccountStatus(uid);\n      allow update: if isDocumentOwner(uid)\n        && request.resource.data.uid == resource.data.uid\n        && request.resource.data.role == resource.data.role\n        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([\n          \"accountStatus\", \"accountStatusUpdatedAt\", \"accountStatusUpdatedBy\", \"accountStatusNotificationId\"\n        ]);\n      allow delete: if false;\n\n      match /vehicles/{vehicleId} {\n        allow get, list: if isDocumentOwner(uid);\n        allow create: if isDocumentOwner(uid)\n          && validVehicleShape(vehicleId)\n          && request.resource.data.createdAt == request.time\n          && request.resource.data.updatedAt == request.time;\n        allow update: if isDocumentOwner(uid)\n          && validVehicleShape(vehicleId)\n          && request.resource.data.vehicleId == resource.data.vehicleId\n          && request.resource.data.createdAt == resource.data.createdAt\n          && request.resource.data.updatedAt == request.time\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n            \"type\", \"make\", \"model\", \"year\", \"color\", \"plateNumber\", \"updatedAt\"\n          ]);\n        allow delete: if isDocumentOwner(uid);\n      }\n\n      match /notifications/{notificationId} {\n        allow get, list: if isDocumentOwner(uid);\n        allow create: if validCustomerNotificationCreate(uid, notificationId);\n        allow update: if (isDocumentOwner(uid)\n            && resource.data.customerId == uid\n            && resource.data.isRead == false\n            && request.resource.data.isRead == true\n            && request.resource.data.readAt == request.time\n            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"isRead\", \"readAt\"]))\n          || validCustomerNotificationUpdate(uid, notificationId);\n        allow delete: if false;\n      }\n\n      match /mechanicNotifications/{notificationId} {\n        allow get, list: if isDocumentOwner(uid);\n        allow create: if validMechanicNotificationCreate(uid, notificationId);\n        allow update: if (isDocumentOwner(uid)\n            && resource.data.providerId == uid\n            && resource.data.isRead == false\n            && request.resource.data.isRead == true\n            && request.resource.data.readAt == request.time\n            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"isRead\", \"readAt\"]))\n          || validMechanicNotificationUpdate(uid, notificationId);\n        allow delete: if false;\n      }\n\n      match /towingNotifications/{notificationId} {\n        allow get, list: if isDocumentOwner(uid);\n        allow create: if validTowingNotificationCreate(uid, notificationId);\n        allow update: if (isDocumentOwner(uid)\n            && resource.data.providerId == uid\n            && resource.data.isRead == false\n            && request.resource.data.isRead == true\n            && request.resource.data.readAt == request.time\n            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"isRead\", \"readAt\"]))\n          || validTowingNotificationUpdate(uid, notificationId);\n        allow delete: if false;\n      }\n\n      match /shopNotifications/{notificationId} {\n        allow get, list: if isDocumentOwner(uid);\n        allow create: if validShopNotificationCreate(uid, notificationId);\n        allow update: if (isDocumentOwner(uid)\n            && resource.data.providerId == uid\n            && resource.data.isRead == false\n            && request.resource.data.isRead == true\n            && request.resource.data.readAt == request.time\n            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"isRead\", \"readAt\"]))\n          || validShopNotificationUpdate(uid, notificationId);\n        allow delete: if false;\n      }\n\n      match /homeGarageNotifications/{notificationId} {\n        allow get, list: if isDocumentOwner(uid);\n        allow create: if validHomeGarageNotificationCreate(uid, notificationId);\n        allow update: if (isDocumentOwner(uid) && resource.data.providerId == uid\n            && resource.data.isRead == false && request.resource.data.isRead == true\n            && request.resource.data.readAt == request.time\n            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"isRead\", \"readAt\"]))\n          || validHomeGarageNotificationUpdate(uid, notificationId);\n        allow delete: if false;\n      }\n\n      // Account status messages are created by admins in the same batch as a\n      // provider status transition.\n      match /accountStatusNotifications/{notificationId} {\n        allow get, list: if isDocumentOwner(uid);\n        allow create: if request.resource.data.keys().hasOnly([\n            \"notificationId\", \"providerId\", \"providerRole\", \"status\", \"previousStatus\", \"title\", \"message\", \"reason\",\n            \"isRead\", \"readAt\", \"createdAt\", \"updatedAt\"\n          ])\n          && (validAdminVerificationNotification(uid, notificationId)\n            || validAdminAccountStatusNotification(uid, notificationId));\n        allow update: if isDocumentOwner(uid)\n          && resource.data.providerId == uid\n          && resource.data.isRead == false\n          && request.resource.data.isRead == true\n          && request.resource.data.readAt == request.time\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"isRead\", \"readAt\"]);\n        allow update: if isAdmin()\n          && resource.data.providerId == uid\n          && resource.data.status == \"ACTIVE\"\n          && get(/databases/$(database)/documents/users/$(uid)).data.accountStatus == \"active\"\n          && get(/databases/$(database)/documents/users/$(uid)).data.accountStatusNotificationId == notificationId\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"message\", \"updatedAt\"])\n          && request.resource.data.message is string\n          && request.resource.data.updatedAt == request.time;\n        allow delete: if false;\n      }\n\n      // Per-shop idempotency pointer, private to the vehicle owner.\n      match /shopBookingLocks/{providerId} {\n        allow get: if isDocumentOwner(uid);\n        allow list: if false;\n        allow create, update: if validShopBookingLockWrite(uid, providerId);\n        allow delete: if false;\n      }\n\n      match /homeGarageBookingLocks/{providerId} {\n        allow get: if isDocumentOwner(uid);\n        allow list: if false;\n        allow create, update: if validHomeGarageBookingLockWrite(uid, providerId);\n        allow delete: if false;\n      }\n\n      // Providers may submit and resubmit private verification information,\n      // but cannot mark themselves as verified from the client application.\n      match /ownerProfile/profile {\n        allow get: if isDocumentOwner(uid) || isAdmin();\n        allow update: if validAdminReview(uid, \"owner\", false);\n        allow create, update: if isDocumentOwner(uid)\n          && request.resource.data.uid == uid\n          && request.resource.data.role == \"owner\"\n          && isPendingVerificationSubmission();\n        allow update: if isDocumentOwner(uid)\n          && request.resource.data.uid == resource.data.uid\n          && request.resource.data.role == resource.data.role\n          && request.resource.data.verificationStatus == resource.data.verificationStatus\n          && request.resource.data.identification == resource.data.identification\n          && request.resource.data.vehicleDocuments == resource.data.vehicleDocuments\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"personal\", \"updatedAt\"])\n          && request.resource.data.personal.keys().hasOnly([\"fullName\", \"phone\", \"address\", \"cityMunicipality\"])\n          && request.resource.data.personal.fullName is string\n          && request.resource.data.personal.phone is string\n          && request.resource.data.personal.address is string\n          && request.resource.data.personal.cityMunicipality is string;\n        allow delete: if false;\n      }\n\n      match /providerProfile/profile {\n        allow get: if isDocumentOwner(uid) || isAdmin();\n        allow list: if isAdmin() && resource.data.verificationStatus == \"PENDING\";\n        allow create: if isDocumentOwner(uid) && isPendingVerificationSubmission();\n        allow update: if validAdminReview(uid, \"onsite-mechanic\", false)\n          || (isDocumentOwner(uid) && isPendingVerificationSubmission())\n          || validMechanicProfileEdit(uid);\n        allow delete: if false;\n      }\n\n      match /towingCompanyProfile/profile {\n        allow get: if isDocumentOwner(uid) || isAdmin();\n        allow list: if isAdmin() && resource.data.verificationStatus == \"PENDING\";\n        allow create: if isDocumentOwner(uid)\n          && request.resource.data.uid == uid\n          && request.resource.data.role == \"towing-company\"\n          && isPendingVerificationSubmission();\n        allow update: if (isDocumentOwner(uid)\n            && resource.data.uid == uid\n            && resource.data.role == \"towing-company\"\n            && resource.data.verificationStatus in [\"INCOMPLETE\", \"PENDING\", \"REJECTED\"]\n            && isPendingVerificationSubmission())\n          || validAdminReview(uid, \"towing-company\", false)\n          || validTowingCompanyProfileEdit(uid);\n        allow delete: if false;\n      }\n\n      // Auto shops submit private verification documents here. Client writes\n      // are limited to a pending submission; approval remains administrator-controlled.\n      match /shopVerification/profile {\n        allow get: if isDocumentOwner(uid) || isAdmin();\n        allow update: if validAdminReview(uid, \"shop-owner\", false);\n        allow create: if isDocumentOwner(uid)\n          && request.resource.data.uid == uid\n          && request.resource.data.role == \"shop-owner\"\n          && request.resource.data.verificationStatus == \"PENDING\";\n        allow update: if isDocumentOwner(uid)\n            && request.resource.data.uid == uid\n            && request.resource.data.role == \"shop-owner\"\n            && request.resource.data.verificationStatus == \"PENDING\";\n        allow delete: if false;\n      }\n\n      // HomeGarage parking providers submit private business documents here.\n      // Approval is performed by administration, never by the client.\n      match /homeGarageVerification/profile {\n        allow get: if isDocumentOwner(uid) || isAdmin();\n        allow create: if isDocumentOwner(uid)\n          && request.resource.data.uid == uid\n          && request.resource.data.role == \"homegarage\"\n          && request.resource.data.verificationStatus == \"PENDING\";\n        allow update: if validAdminReview(uid, \"homegarage\", false)\n          || (isDocumentOwner(uid)\n            && request.resource.data.uid == uid\n            && request.resource.data.role == \"homegarage\"\n            && request.resource.data.verificationStatus == \"PENDING\");\n        allow delete: if false;\n      }\n\n      match /towingPricing/{pricingId} {\n        allow get: if pricingId == \"config\" && (isDocumentOwner(uid)\n          || (signedIn()\n            && exists(/databases/$(database)/documents/providerListings/$(uid))\n            && get(/databases/$(database)/documents/providerListings/$(uid)).data.role == \"towing-company\"\n            && get(/databases/$(database)/documents/providerListings/$(uid)).data.visibility == \"active\"));\n        allow list: if false;\n        allow create: if pricingId == \"config\"\n          && isDocumentOwner(uid)\n          && verifiedTowingCompany(uid)\n          && validTowingPricingShape()\n          && request.resource.data.createdAt == request.time\n          && request.resource.data.updatedAt == request.time;\n        allow update: if pricingId == \"config\"\n          && isDocumentOwner(uid)\n          && verifiedTowingCompany(uid)\n          && validTowingPricingShape()\n          && request.resource.data.createdAt == resource.data.createdAt\n          && request.resource.data.updatedAt == request.time\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n            \"basePrice\", \"pricePerKm\", \"pricingMode\", \"dispatcherPhone\", \"updatedAt\"\n          ]);\n        allow delete: if false;\n      }\n    }\n\n    // Business profiles stay private. Only trusted administration can approve a\n    // shop; clients cannot set approval, replace an approved doc or delete it.\n    match /providers/{uid} {\n      allow read: if isDocumentOwner(uid) || (isAdmin() && resource.data.role == \"shop-owner\");\n      allow list: if isAdmin() && resource.data.role == \"shop-owner\";\n      allow update: if validShopReview(uid);\n      allow create: if isDocumentOwner(uid)\n        && ((isShopOwner(uid)\n            && request.resource.data.uid == uid\n            && request.resource.data.role == \"shop-owner\"\n            && request.resource.data.verified == false\n            && request.resource.data.rating == 0\n            && request.resource.data.status == \"closed\")\n          || (!isShopOwner(uid) && request.resource.data.role != \"shop-owner\"));\n      allow update: if isDocumentOwner(uid)\n        && ((isShopOwner(uid) && resource.data.role == \"shop-owner\"\n            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n              \"businessName\", \"phone\", \"address\", \"latitude\", \"longitude\", \"status\"\n            ])\n            && request.resource.data.status in [\"open\", \"closed\"])\n          || (isShopOwner(uid) && resource.data.role == \"shop-owner\"\n            && validApprovedShopProfileSync(uid))\n          || (!isShopOwner(uid) && resource.data.role != \"shop-owner\" && request.resource.data.role != \"shop-owner\"));\n      allow delete: if isDocumentOwner(uid) && !isShopOwner(uid) && resource.data.role != \"shop-owner\";\n    }\n\n    // Providers publish the minimal customer-map document directly. If a\n    // provider's verification is later revoked, the trusted admin workflow\n    // must remove or deactivate this existing listing.\n    function isGuestReadablePhoneFreeListing() {\n      return resource.data.get(\"contactPhone\", \"\") == \"\"\n        && resource.data.visibility == \"active\"\n        && (resource.data.availability == \"available\" || resource.data.get(\"acceptsScheduledBookings\", false) == true);\n    }\n\n    match /providerListings/{providerId} {\n      allow get: if isAdmin() || isDocumentOwner(providerId) || (signedIn() && resource.data.visibility == \"active\" && (resource.data.availability == \"available\" || resource.data.get(\"acceptsScheduledBookings\", false) == true)) || isGuestReadablePhoneFreeListing();\n      // Guest list queries must include contactPhone == \"\"; this field is\n      // queryable, unlike a per-document absence check.\n      allow list: if isAdmin() || (signedIn() && resource.data.visibility == \"active\" && (resource.data.availability == \"available\" || resource.data.get(\"acceptsScheduledBookings\", false) == true)) || isGuestReadablePhoneFreeListing();\n      allow create: if accountIsActive(providerId) && validPublicListingCreate(providerId);\n      allow update: if isAdmin()\n        ? ((!request.resource.data.diff(resource.data).affectedKeys().hasAny([\"contactPhone\"]) || request.resource.data.get(\"contactPhone\", \"\") == \"\")\n          && (request.resource.data.visibility == \"active\"\n          ? validAdminListingRestore(providerId)\n          : validAdminListingHide(providerId)))\n        : validProviderListingUpdate(providerId);\n      allow delete: if false;\n    }\n\n    // Published contact numbers are isolated from guest-readable listing data.\n    match /providerContacts/{providerId} {\n      allow get: if signedIn() && accountIsActive(providerId)\n        && exists(/databases/$(database)/documents/providerListings/$(providerId))\n        && get(/databases/$(database)/documents/providerListings/$(providerId)).data.visibility == \"active\";\n      allow list: if false;\n      allow create, update: if isDocumentOwner(providerId)\n        && accountIsActive(providerId)\n        && existsAfter(/databases/$(database)/documents/providerListings/$(providerId))\n        && getAfter(/databases/$(database)/documents/providerListings/$(providerId)).data.visibility == \"active\"\n        && request.resource.data.keys().hasOnly([\"providerId\", \"phone\"])\n        && request.resource.data.providerId == providerId\n        && request.resource.data.phone is string\n        && request.resource.data.phone.size() >= 7\n        && request.resource.data.phone.size() <= 30;\n      allow delete: if isDocumentOwner(providerId) && accountIsActive(providerId);\n    }\n\n    match /providerStatusHistory/{historyId} {\n      allow get, list: if isAdmin();\n      allow create: if validProviderStatusHistory(historyId);\n      allow update: if validAdminListingRestoreHistory(historyId);\n      allow delete: if false;\n    }\n\n    match /providerVerificationHistory/{historyId} {\n      allow get, list: if isAdmin();\n      allow create: if validProviderVerificationHistory();\n      allow update, delete: if false;\n    }\n\n    // Admin review queues use collection-group queries and return only pending submissions.\n    match /{path=**}/ownerProfile/{profileId} {\n      allow list: if isAdmin() && resource.data.verificationStatus == \"PENDING\";\n    }\n    match /{path=**}/providerProfile/{profileId} {\n      allow list: if isAdmin() && resource.data.verificationStatus == \"PENDING\";\n    }\n    match /{path=**}/towingCompanyProfile/{profileId} {\n      allow list: if isAdmin() && resource.data.verificationStatus == \"PENDING\";\n    }\n    match /{path=**}/shopVerification/{profileId} {\n      allow list: if isAdmin() && resource.data.verificationStatus == \"PENDING\";\n    }\n    match /{path=**}/homeGarageVerification/{profileId} {\n      allow list: if isAdmin() && resource.data.verificationStatus == \"PENDING\";\n    }\n\n    // Parking bookings are customer-controlled sessions. Capacity changes are\n    // only accepted alongside the app's Firestore transactions; providers\n    // never need to start or end a customer's parking session.\n    match /parkingBookings/{bookingId} {\n      // Stage 1 stops new sessions while existing sessions remain readable and completable.\n      allow create: if false;\n      allow get, list: if signedIn() && (resource.data.customerId == request.auth.uid || resource.data.providerId == request.auth.uid);\n      allow update: if signedIn() && resource.data.customerId == request.auth.uid\n        && ((resource.data.status == \"reserved\" && request.resource.data.status == \"active\"\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"parkingStartedAt\", \"updatedAt\"])\n          && request.resource.data.parkingStartedAt == request.time && request.resource.data.updatedAt == request.time)\n          || (resource.data.status == \"active\" && request.resource.data.status == \"completed\"\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"parkingEndedAt\", \"updatedAt\"])\n          && request.resource.data.parkingEndedAt == request.time && request.resource.data.updatedAt == request.time\n          && getAfter(/databases/$(database)/documents/parkingSlots/$(resource.data.slotId)).data.status == \"available\"));\n      allow delete: if false;\n    }\n\n    // A slot is the atomic capacity lock. Its state carries no public vehicle\n    // data, and only its reserving customer can release it.\n    match /parkingSlots/{slotId} {\n      allow get, list: if signedIn();\n      allow create: if isDocumentOwner(request.resource.data.providerId)\n        && accountIsActive(request.auth.uid)\n        && request.resource.data.keys().hasOnly([\"providerId\", \"slotNumber\", \"status\", \"customerId\", \"bookingId\"])\n        && request.resource.data.slotNumber is int && request.resource.data.slotNumber >= 1 && request.resource.data.slotNumber <= 500\n        && request.resource.data.status == \"available\" && request.resource.data.customerId == null && request.resource.data.bookingId == null\n        && get(/databases/$(database)/documents/providerListings/$(request.resource.data.providerId)).data.role == \"homegarage\";\n      allow update: if signedIn()\n        && (resource.data.status == \"reserved\" && resource.data.customerId == request.auth.uid\n          && request.resource.data.status == \"available\" && request.resource.data.customerId == null && request.resource.data.bookingId == null\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"customerId\", \"bookingId\", \"updatedAt\"])\n          && request.resource.data.updatedAt == request.time);\n      allow delete: if false;\n    }\n\n    match /providerScheduleReservations/{reservationId} {\n      allow get: if isAdmin() || (signedIn() &&\n        ((!exists(/databases/$(database)/documents/providerScheduleReservations/$(reservationId))\n            && reservationId.matches(\"^.+_[0-9]+$\"))\n          || resource.data.providerId == request.auth.uid\n          || get(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.customerId == request.auth.uid));\n      allow list: if false;\n      allow create: if signedIn()\n        && request.resource.data.keys().hasOnly([\"providerId\", \"bookingId\", \"scheduledAt\", \"createdAt\"])\n        && request.resource.data.providerId == request.auth.uid\n        && request.resource.data.bookingId is string\n        && request.resource.data.scheduledAt is timestamp\n        && request.resource.data.createdAt == request.time\n        && reservationId == request.auth.uid + \"_\" + string(request.resource.data.scheduledAt.toMillis())\n        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.providerId == request.auth.uid\n        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.timingMode == \"scheduled\"\n        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.scheduledAt == request.resource.data.scheduledAt\n        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.status == \"accepted\";\n      allow update: if false;\n      allow delete: if signedIn()\n        && resource.data.bookingId is string\n        && getAfter(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.customerId == request.auth.uid\n        && getAfter(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.status == \"cancelled\";\n    }\n\n    match /bookings/{bookingId} {\n      function providerTransitionAllowed() {\n        return resource.data.bookingType == \"shop-owner\"\n          ? validShopBookingTransition(bookingId)\n          : resource.data.bookingType == \"homegarage\"\n            ? validHomeGarageBookingTransition(bookingId)\n            : resource.data.bookingType in [\"onsite-mechanic\", \"towing-company\"]\n              && validProviderBookingTransition(bookingId);\n      }\n\n      function providerUpdateAllowed() {\n        return resource.data.providerId == request.auth.uid\n          && accountIsActive(request.auth.uid)\n          && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n                \"mechanicLatitude\", \"mechanicLongitude\", \"mechanicLocationUpdatedAt\"\n              ]) && validMechanicLocationUpdate())\n            || ((request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"updatedAt\"])\n                || (resource.data.bookingType in [\"onsite-mechanic\", \"towing-company\"]\n                  && resource.data.status == \"pending\"\n                  && request.resource.data.status == \"rejected\"\n                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"updatedAt\", \"declineReason\", \"riskEventType\", \"riskEventAt\"])\n                  && optionalBookingReasonIsValid(request.resource.data, \"declineReason\"))\n                || (resource.data.bookingType in [\"onsite-mechanic\", \"towing-company\"]\n                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"updatedAt\", \"finalPrice\", \"completedAt\"]))\n                || (resource.data.bookingType == \"homegarage\"\n                  && resource.data.status == \"pending\"\n                  && request.resource.data.status == \"rejected\"\n                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"updatedAt\", \"declineReason\", \"riskEventType\", \"riskEventAt\"])\n                  && optionalBookingReasonIsValid(request.resource.data, \"declineReason\"))\n                || (resource.data.bookingType == \"shop-owner\"\n                  && resource.data.status == \"pending\"\n                  && request.resource.data.status == \"rejected\"\n                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"updatedAt\", \"declineReason\", \"riskEventType\", \"riskEventAt\"])\n                  && optionalBookingReasonIsValid(request.resource.data, \"declineReason\"))\n                || (resource.data.bookingType in [\"shop-owner\", \"homegarage\"]\n                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"updatedAt\", \"finalPrice\", \"completedAt\", \"completionNote\"])))\n              && request.resource.data.updatedAt == request.time\n              && providerTransitionAllowed()));\n      }\n\n      function customerCancellationAllowed() {\n        return resource.data.customerId == request.auth.uid\n          && resource.data.bookingType in [\"onsite-mechanic\", \"towing-company\", \"homegarage\", \"shop-owner\"]\n          && resource.data.status in [\"pending\", \"accepted\"]\n          && request.resource.data.status == \"cancelled\"\n          && optionalRiskEventIsValid(\"owner_cancel_after_acceptance\", \"accepted\")\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"updatedAt\", \"cancellationReason\", \"riskEventType\", \"riskEventAt\"])\n          && optionalBookingReasonIsValid(request.resource.data, \"cancellationReason\")\n          && request.resource.data.updatedAt == request.time\n          && reservationReleasedFor(resource.data);\n      }\n\n      allow get, list: if isAdmin();\n      allow create: if accountIsActive(request.auth.uid)\n        && accountIsActive(request.resource.data.providerId)\n        && (request.resource.data.bookingType == \"homegarage\"\n        ? (validHomeGarageBooking() && validHomeGarageBookingLock(bookingId))\n        : request.resource.data.bookingType == \"towing-company\"\n          ? (validBookingBase() && validTowingBookingProvider())\n          : (validBookingBase()\n            && ((validShopBooking() && validShopBookingLock(bookingId))\n              || (validBookingProvider() && validMechanicBooking()))));\n      allow get, list: if signedIn()\n        && (resource.data.customerId == request.auth.uid\n          || resource.data.providerId == request.auth.uid);\n      allow update: if signedIn() && (providerUpdateAllowed() || customerCancellationAllowed());\n      allow delete: if false;\n    }\n\n    match /providerReviews/{reviewId} {\n      allow get, list: if signedIn();\n      allow create: if validProviderReview(reviewId) || validParkingProviderReview(reviewId);\n      allow update, delete: if false;\n    }\n\n    // Staff requests record manual review only; they never grant an Auth admin claim.\n    match /adminStaffRequests/{requestId} {\n      allow get, list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);\n      allow create: if signedIn()\n        && request.resource.data.keys().hasOnly([\"uid\", \"email\", \"displayName\", \"status\", \"requestedAt\"])\n        && request.resource.data.uid == request.auth.uid\n        && request.resource.data.email == request.auth.token.email\n        && request.resource.data.displayName is string\n        && request.resource.data.displayName.size() <= 120\n        && request.resource.data.status == \"PENDING\"\n        && request.resource.data.requestedAt == request.time;\n      allow update: if isAdmin()\n        && resource.data.status == \"PENDING\"\n        && resource.data.uid != request.auth.uid\n        && request.resource.data.keys().hasOnly([\"uid\", \"email\", \"displayName\", \"status\", \"requestedAt\", \"reviewedBy\", \"reviewedAt\"])\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"reviewedBy\", \"reviewedAt\"])\n        && request.resource.data.uid == resource.data.uid\n        && request.resource.data.email == resource.data.email\n        && request.resource.data.displayName == resource.data.displayName\n        && request.resource.data.requestedAt == resource.data.requestedAt\n        && request.resource.data.status in [\"MANUAL_GRANT_RECORDED\", \"REJECTED\"]\n        && request.resource.data.reviewedBy == request.auth.uid\n        && request.resource.data.reviewedAt == request.time;\n      allow delete: if false;\n    }\n\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n"}]}}
