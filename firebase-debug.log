}\n\n    function hasValidProviderControlledFields() {\n      let latitude = request.resource.data.location.latitude;\n      let longitude = request.resource.data.location.longitude;\n      return request.resource.data.businessName is string\n        && request.resource.data.businessName.size() > 0\n        && request.resource.data.businessName.size() <= 120\n        && latitude is number\n        && latitude >= -90\n        && latitude <= 90\n        && longitude is number\n        && longitude >= -180\n        && longitude <= 180\n        && !(latitude == 0 && longitude == 0)\n        && request.resource.data.availability in [\"available\", \"busy\", \"offline\"]\n        && request.resource.data.serviceAreaLabel is string\n        && request.resource.data.serviceAreaLabel.size() >= 2\n        && request.resource.data.serviceAreaLabel.size() <= 120\n        && request.resource.data.description is string\n        && request.resource.data.description.size() <= 600\n        && (!request.resource.data.keys().hasAny([\"contactPhone\"])\n          || (request.resource.data.contactPhone is string\n            && (request.resource.data.contactPhone.size() == 0\n              || (request.resource.data.contactPhone.size() >= 7\n                && request.resource.data.contactPhone.size() <= 30))))\n        && request.resource.data.operatingHours is string\n        && request.resource.data.operatingHours.size() >= 2\n        && request.resource.data.operatingHours.size() <= 200\n        && request.resource.data.services is list\n        && request.resource.data.services.size() >= 1\n        && ((request.resource.data.role == \"shop-owner\"\n              && request.resource.data.services.size() <= 7)\n          || (request.resource.data.role != \"shop-owner\"\n              && request.resource.data.services.size() <= 6))\n        && request.resource.data.vehicleTypes is list\n        && request.resource.data.vehicleTypes.size() >= 1\n        && request.resource.data.vehicleT