  let after = request.resource.data;\n      return before.providerId == uid\n        && before.role == \"shop-owner\"\n        && before.category == \"Auto Shops\"\n        // The caller's changed-field allowlist below already prevents edits\n        // to providerId, role, category, and ratingSummary.\n        && (after.visibility == before.visibility\n          || (after.visibility == \"active\" && accountIsActive(uid)))\n        && after.location is map\n        && after.location.keys().hasOnly([\"latitude\", \"longitude\"])\n        && hasValidProviderControlledFields()\n        && hasValidRoleSpecificServices()\n        && verifiedShop(uid)\n        && validShopListingProfile(uid);\n    }\n\n    // Availability toggles only change one public field. Keep this narrowly\n    // authorized so older approved listings do not need to pass the full\n    // listing creation schema just to sync open/closed state.\n    function validShopAvailabilitySync(uid) {\n      return verifiedShop(uid)\n        && resource.data.providerId == uid\n        && resource.data.role == \"shop-owner\"\n        && resource.data.category == \"Auto Shops\"\n        && resource.data.visibility == \"active\"\n        && accountIsActive(uid)\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"availability\"])\n        && request.resource.data.availability in [\"available\", \"offline\"]\n        && validShopListingProfile(uid);\n    }\n\n    function validMechanicAvailabilitySync(uid) {\n      return accountIsActive(uid)\n        && verifiedMechanic(uid)\n        && resource.data.providerId == uid\n        && resource.data.role == \"onsite-mechanic\"\n        && resource.data.category == \"Onsite Mechanics\"\n        && resource.data.visibility == \"active\"\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"availability\"])\n        && request.resource.data.availability in [\"available\", \"offline\"];\n    }\n\n    function validHomeGarageAvailabilitySync(uid) {\n      return accountIsActive(uid)\n        && get(/databases/$(database)/documents/users/$(uid)).data.role == \"homegarage\"\n        && verifiedHomeGarage(uid)\n        && validHomeGarageListingProfile(uid)\n        && resource.data.providerId == uid\n        && resource.data.role == \"homegarage\"\n        && resource.data.category == \"Parking Lots\"\n        && resource.data.visibility == \"active\"\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"availability\"])\n        && request.resource.data.availability in [\"available\", \"offline\"];\n    }\n\n    function validTowingAvailabilitySync(uid) {\n      return accountIsActive(uid)\n        && verifiedTowingCompany(uid)\n        && resource.data.providerId == uid\n        && resource.data.role == \"towing-company\"\n        && resource.data.category == \"Towing\"\n        && resource.data.visibility == \"active\"\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"availability\"])\n        && request.resource.data.availability in [\"available\", \"offline\"];\n    }\n    function validProviderListingUpdate(uid) {\n      let role = resource.data.role;\n      let changed = request.resource.data.diff(resource.data).affectedKeys();\n      return signedIn()\n        && request.auth.uid == uid\n        && (!changed.hasAny([\"contactPhone\"]) || request.resource.data.get(\"contactPhone\", \"\") == \"\")\n        && (role == \"shop-owner\"\n          ? (changed.hasOnly([\"availability\"])\n            ? validShopAvailabilitySync(uid)\n            : changed.hasOnly([\"businessName\", \"location\", \"availability\", \"serviceAreaLabel\", \"description\", \"contactPhone\", \"services\", \"vehicleTypes\", \"operatingHours\", \"startingPrice\", \"emergencyServiceAvailable\", \"acceptsScheduledBookings\", \"photoUrls\", \"hoursType\", \"is24Hours\", \"weeklyHours\", \"visibility\"])\n              && validShopPublicListingUpdate(uid))\n    