s().hasOnly([\"status\", \"updatedAt\", \"finalPrice\", \"completedAt\", \"completionNote\"])\n              && (!request.resource.data.keys().hasAny([\"completionNote\"])\n                || (request.resource.data.completionNote is string && request.resource.data.completionNote.size() <= 160))));\n    }\n\n    // One lock per customer/shop pair serializes simultaneous request creates.\n    // The lock must point to the pending booking created in the same commit.\n    function validShopBookingLock(bookingId) {\n      let lockPath = /databases/$(database)/documents/users/$(request.resource.data.customerId)/shopBookingLocks/$(request.resource.data.providerId);\n      return existsAfter(lockPath)\n        && getAfter(lockPath).data.customerId == request.resource.data.customerId\n        && getAfter(lockPath).data.providerId == request.resource.data.providerId\n        && getAfter(lockPath).data.bookingId == bookingId;\n    }\n\n    function validShopBookingLockWrite(uid, providerId) {\n      let bookingPath = /databases/$(database)/documents/bookings/$(request.resource.data.bookingId);\n      return signedIn()\n        && request.resource.data.keys().hasOnly([\"customerId\", \"providerId\", \"bookingId\"])\n        && isDocumentOwner(uid)\n        && request.resource.data.customerId == uid\n        && request.resource.data.providerId == providerId\n        && request.resource.data.bookingId is string\n        && existsAfter(bookingPath)\n        && getAfter(bookingPath).data.bookingType == \"shop-owner\"\n        && getAfter(bookingPath).data.customerId == request.auth.uid\n        && getAfter(bookingPath).data.providerId == request.resource.data.providerId\n        && getAfter(bookingPath).data.status == \"pending\";\n    }\n\n    function validShopBookingTransition(bookingId) {\n      let before = resource.data.status;\n      let after = request.resource.data.status;\n      return isShopOwner(request.auth.uid)\n        && ((before == \"pending\" && after == \"accepted\"\n              && (resource.data.get(\"timingMode\", \"now\") == \"scheduled\" || isOpenShop(request.auth.uid))\n              && verifiedShop(request.auth.uid)\n              && reservationClaimedFor(bookingId, resource.data)\n              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"updatedAt\"]))\n          || (before == \"pending\" && after == \"rejected\"\n              && optionalRiskEventIsValid(\"provider_decline\", \"pending\")\n              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"updatedAt\", \"declineReason\", \"riskEventType\", \"riskEventAt\"])\n              && optionalBookingReasonIsValid(request.resource.data, \"declineReason\"))\n          || (before == \"accepted\" && after == \"vehicle_arrived\"\n              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"updatedAt\"]))\n          || (before == \"vehicle_arrived\" && after == \"diagnosing\"\n              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"updatedAt\"]))\n          || (before == \"diagnosing\" && after == \"repairing\"\n              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"updatedAt\"]))\n          || (before == \"repairing\" && after == \"completed\"\n              && request.resource.data.finalPrice is number\n              && request.resource.data.finalPrice >= 0\n              && request.resource.data.finalPrice <= 100000000\n              && request.resource.data.finalPrice * 100 % 1 == 0\n              && request.resource.data.completedAt == request.time\n              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"updatedAt\", \"finalPrice\", \"completedAt\", \"completionNote\"])\n              && (!request.resource.data.keys().hasAny([\"completionNote\"])\n                || (request.resource.data.completionNote is string && request.resource.data.completionNote.size() <= 160))));\n    }\n\n    function validTowingBooking(listing) {\n      let booking = request.resource.data;\n      let pricing = get(/databases/$(database)/documents/users/$(booking.providerId)/towingPricing/config).data;\n      return booking.keys().hasOnly([\n          \"bookingType\", \"customerId\", \"customerName\", \"customerEmail\", \"customerPhone\",\n          \"providerId\", \"providerName\", \"vehicleId\", \"vehicle\", \"vehicleYear\",\n          \"vehiclePlate\", \"latitude\", \"longitude\", \"providerLatitude\", \"providerLongitude\",\n          \"destinationLatitude\", \"destinationLongitude\", \"providerToPickupDistanceKm\",\n          \"pickupToDestinationDistanceKm\", \"totalDistanceKm\", \"basePrice\",\n          \"pricePerKm\", \"distanceCharge\", \"estimatedTotalPrice\", \"pricingMode\", \"dispatcherPhone\",\n          \"pickupLocation\", \"destination\", \"towingType\",\n          \"vehicleCondition\", \"notes\", \"startingPrice\", \"status\", \"createdAt\",\n          \"updatedAt\", \"timingMode\", \"urgency\", \"scheduledAt\"\n        ])\n        && booking.providerLatitude == listing.location.latitude\n        && booking.providerLongitude == listing.location.longitude\n        && booking.destinationLatitude is number\n        && booking.destinationLatitude >= -90\n        && booking.destinationLatitude <= 90\n        && booking.destinationLongitude is number\n        && booking.destinationLongitude >= -180\n        && booking.destinationLongitude <= 180\n        && !(booking.destinationLatitude == 0 && booking.destinationLongitude == 0)\n        && booking.providerToPickupDistanceKm is number\n        && booking.providerToPickupDistanceKm >= 0\n        && booking.pickupToDestinationDistanceKm is number\n        && booking.pickupToDestinationDistanceKm >= 0\n        && booking.totalDistanceKm is number\n        && booking.totalDistanceKm > 0\n        && booking.totalDistanceKm <= 2000\n        && booking.totalDistanceKm >= booking.providerToPickupDistanceKm + booking.pickupToDestinationDistanceKm - 0.02\n        && booking.totalDistanceKm <= booking.providerToPickupDistanceKm + booking.pickupToDestinationDistanceKm + 0.02\n        && booking.pricingMode in [\"fixed\", \"dispatcher\"]\n        && booking.dispatcherPhone is string\n        && (\n          ((pricing.pricingMode == null || pricing.pricingMode == \"fixed\")\n            && booking.pricingMode == \"fixed\"\n            && booking.dispatcherPhone == \"\"\n            && booking.basePrice is number\n            && booking.basePrice == pricing.basePrice\n            && booking.pricePerKm is number\n            && booking.pricePerKm == pricing.pricePerKm\n            && booking.distanceCharge is number\n            && booking.distanceCharge >= booking.totalDistanceKm * booking.pricePerKm - 0.01\n            && booking.distanceCharge <= booking.totalDistanceKm * booking.pricePerKm + 0.01\n            && booking.estimatedTotalPrice is number\n            && booking.estimatedTotalPrice >= booking.basePrice + booking.distanceCharge - 0.01\n            && booking.estimatedTotalPrice <= booking.basePrice + booking.distanceCharge + 0.01)\n          || (pricing.pricingMode == \"dispatcher\"\n            && booking.pricingMode == \"dispatcher\"\n            && booking.dispatcherPhone == pricing.dispatcherPhone\n            && booking.dispatcherPhone.size() > 0\n            && booking.basePrice == 0\n            && booking.pricePerKm == 0\n            && booking.distanceCharge == 0\n            && booking.estimatedTotalPrice == 0)\n        )\n        && booking.pickupLocation is string\n        && booking.pickupLocation.size() > 0\n        && booking.pickupLocation.size() <= 300\n        && booking.destination is string\n        && booking.destination.size() > 0\n        && booking.destination.size() <= 300\n        && booking.towingType in [\"Flatbed Towing\", \"Wheel-Lift Towing\", \"Motorcycle Towing\", \"Emergency Towing\"]\n        && booking.vehicleCondition in [\"Vehicle can move\", \"Vehicle cannot move\", \"Vehicle badly damaged\", \"Accident vehicle\"];\n    }\n\n    function validTowingPricingShape() {\n      return request.resource.data.keys().hasOnly([\n          \"basePrice\", \"pricePerKm\", \"pricingMode\", \"dispatcherPhone\", \"createdAt\", \"updatedAt\"\n        ])\n        && request.resource.data.basePrice is number\n        && request.resource.data.basePrice >= 0\n        && request.resource.data.basePrice <= 1000000\n        && request.resource.data.pricePerKm is number\n        && request.resource.data.pricePerKm >= 0\n        && request.resource.data.pricePerKm <= 100000\n        && request.resource.data.pricingMode in [\"fixed\", \"dispatcher\"]\n        && request.resource.data.dispatcherPhone is string\n        && request.resource.data.dispatcherPhone.size() <= 50\n        && (request.resource.data.pricingMode == \"fixed\" || request.resource.data.dispatcherPhone.size() > 0);\n    }\n\n    function validVehicleShape(vehicleId) {\n      return request.resource.data.keys().hasOnly([\n          \"vehicleId\", \"type\", \"make\", \"model\", \"year\", \"color\",\n          \"plateNumber\", \"createdAt\", \"updatedAt\"\n        ])\n        && request.resource.data.vehicleId == vehicleId\n        && request.resource.data.type in [\"Car\", \"SUV\", \"Pickup Truck\", \"Van\", \"Motorcycle\", \"Truck\"]\n        && request.resource.data.make is string\n        && request.resource.data.make.size() > 0\n        && request.resource.data.make.size() <= 60\n        && request.resource.data.model is string\n        && request.resource.data.model.size() > 0\n        && request.resource.data.model.size() <= 60\n        && request.resource.data.year is int\n        && request.resource.data.year >= 1900\n        && request.resource.data.year <= 2100\n        && request.resource.data.color is string\n        && request.resource.data.color.size() > 0\n        && request.resource.data.color.size() <= 40\n        && request.resource.data.plateNumber is string\n        && request.resource.data.plateNumber.size() > 0\n        && request.resource.data.plateNumber.size() <= 20;\n    }\n\n    function validProviderBookingTransition(bookingId) {\n      let before = resource.data.status;\n      let after = request.resource.data.status;\n      return (before == \"pending\" && after == \"rejected\"\n          && optionalRiskEventIsValid(\"provider_decline\", \"pending\")\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"updatedAt\", \"declineReason\", \"riskEventType\", \"riskEventAt\"])\n          && optionalBookingReasonIsValid(request.resource.data, \"declineReason\"))\n        || (before == \"pending\" && after in [\"accepted\", \"cancelled\"]\n          && (after != \"accepted\" || reservationClaimedFor(bookingId, resource.data)))\n        || (before == \"accepted\" && after in [\"en_route\", \"cancelled\"])\n        || (before == \"en_route\" && after in [\"arrived\", \"cancelled\"])\n        || (before == \"arrived\" && after == \"in_progress\")\n        || (before == \"in_progress\" && after == \"completed\"\n          && request.resource.data.finalPrice is number\n          && request.resource.data.finalPrice >= 0\n          && request.resource.data.finalPrice <= 100000000\n          && request.resource.data.finalPrice * 100 % 1 == 0\n          && request.resource.data.completedAt == request.time\n          && request.resource.data.diff(resource.data).affectedKeys().hasAll([\"status\", \"updatedAt\", \"finalPrice\", \"completedAt\"]));\n    }\n\n    function validMechanicLocationUpdate() {\n      return resource.data.bookingType == \"onsite-mechanic\"\n        && resource.data.status in [\"accepted\", \"en_route\", \"arrived\", \"in_progress\"]\n        && request.resource.data.mechanicLatitude is number\n        && request.resource.data.mechanicLatitude >= -90\n        && request.resource.data.mechanicLatitude <= 90\n        && request.resource.data.mechanicLongitude is number\n        && request.resource.data.mechanicLongitude >= -180\n        && request.resource.data.mechanicLongitude <= 180\n        && request.resource.data.mechanicLocationUpdatedAt == request.time;\n    }\n\n    function validProviderReview(reviewId) {\n      let bookingPath = /databases/$(database)/documents/bookings/$(reviewId);\n      let booking = get(bookingPath).data;\n      return signedIn()\n        && exists(bookingPath)\n        && request.resource.data.keys().hasOnly([\n          \"bookingId\", \"customerId\", \"providerId\", \"providerRole\", \"rating\",\n          \"comment\", \"createdAt\", \"updatedAt\"\n        ])\n        && request.resource.data.bookingId == reviewId\n        && request.resource.data.customerId == request.auth.uid\n        && booking.customerId == request.auth.uid\n        && booking.status == \"completed\"\n        && request.resource.data.providerId == booking.providerId\n        && request.resource.data.providerId != request.auth.uid\n        && request.resource.data.providerRole == booking.bookingType\n        && request.resource.data.providerRole in [\"onsite-mechanic\", \"towing-company\", \"shop-owner\", \"homegarage\"]\n        && request.resource.data.rating is int\n        && request.resource.data.rating >= 1\n        && request.resource.data.rating <= 5\n        && request.resource.data.comment is string\n        && request.resource.data.comment.size() <= 1000\n        && request.resource.data.createdAt == request.time\n        && request.resource.data.updatedAt == request.time;\n    }\n\n    function validParkingProviderReview(reviewId) {\n      let bookingPath = /databases/$(database)/documents/parkingBookings/$(reviewId);\n      let booking = get(bookingPath).data;\n      return signedIn()\n        && exists(bookingPath)\n        && request.resource.data.keys().hasOnly([\n          \"bookingId\", \"customerId\", \"providerId\", \"providerRole\", \"rating\",\n          \"comment\", \"createdAt\", \"updatedAt\"\n        ])\n        && request.resource.data.bookingId == reviewId\n        && request.resource.data.customerId == request.auth.uid\n        && booking.customerId == request.auth.uid\n        && booking.status == \"completed\"\n        && request.resource.data.providerId == booking.providerId\n        && request.resource.data.providerId != request.auth.uid\n        && request.resource.data.providerRole == \"homegarage\"\n        && request.resource.data.rating is int\n        && request.resource.data.rating >= 1\n        && request.resource.data.rating <= 5\n        && request.resource.data.comment is string\n        && request.resource.data.comment.size() <= 1000\n        && request.resource.data.createdAt == request.time\n        && request.resource.data.updatedAt == request.time;\n    }\n\n    // General account data remains private to its account owner.\n    match /users/{uid} {\n      allow create: if isDocumentOwner(uid)\n        && request.resource.data.uid == uid\n        && request.resource.data.role in [\"owner\", \"onsite-mechanic\", \"shop-owner\", \"towing-company\", \"homegarage\"];\n      allow get: if isDocumentOwner(uid)\n        || (isAdmin() && resource.data.role in [\"onsite-mechanic\", \"shop-owner\", \"towing-company\", \"homegarage\", \"owner\"]);\n      allow list: if isAdmin();\n      allow update: if validAdminAccountStatus(uid);\n      allow update: if isDocumentOwner(uid)\n        && request.resource.data.uid == resource.data.uid\n        && request.resource.data.role == resource.data.role\n        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([\n          \"accountStatus\", \"accountStatusUpdatedAt\", \"accountStatusUpdatedBy\", \"accountStatusNotificationId\"\n        ]);\n      allow delete: if false;\n\n      match /vehicles/{vehicleId} {\n        allow get, list: if isDocumentOwner(uid);\n        allow create: if isDocumentOwner(uid)\n          && validVehicleShape(vehicleId)\n          && request.resource.data.createdAt == request.time\n          && request.resource.data.updatedAt == request.time;\n        allow update: if isDocumentOwner(uid)\n          && validVehicleShape(vehicleId)\n          && request.resource.data.vehicleId == resource.data.vehicleId\n          && request.resource.data.createdAt == resource.data.createdAt\n          && request.resource.data.updatedAt == request.time\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n            \"type\", \"make\", \"model\", \"year\", \"color\", \"plateNumber\", \"updatedAt\"\n          ]);\n        allow delete: if isDocumentOwner(uid);\n      }\n\n      match /notifications/{notificationId} {\n        allow get, list: if isDocumentOwner(uid);\n        allow create: if validCustomerNotificationCreate(uid, notificationId);\n        allow update: if (isDocumentOwner(uid)\n            && resource.data.customerId == uid\n            && resource.data.isRead == false\n            && request.resource.data.isRead == true\n            && request.resource.data.readAt == request.time\n            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"isRead\", \"readAt\"]))\n          || validCustomerNotificationUpdate(uid, notificationId);\n        allow delete: if false;\n      }\n\n      match /mechanicNotifications/{notificationId} {\n        allow get, list: if isDocumentOwner(uid);\n        allow create: if validMechanicNotificationCreate(uid, notificationId);\n        allow update: if (isDocumentOwner(uid)\n            && resource.data.providerId == uid\n            && resource.data.isRead == false\n            && request.resource.data.isRead == true\n            && request.resource.data.readAt == request.time\n            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"isRead\", \"readAt\"]))\n          || validMechanicNotificationUpdate(uid, notificationId);\n        allow delete: if false;\n      }\n\n      match /towingNotifications/{notificationId} {\n        allow get, list: if isDocumentOwner(uid);\n        allow create: if validTowingNotificationCreate(uid, notificationId);\n        allow update: if (isDocumentOwner(uid)\n            && resource.data.providerId == uid\n            && resource.data.isRead == false\n            && request.resource.data.isRead == true\n            && request.resource.data.readAt == request.time\n            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"isRead\", \"readAt\"]))\n          || validTowingNotificationUpdate(uid, notificationId);\n        allow delete: if false;\n      }\n\n      match /shopNotifications/{notificationId} {\n        allow get, list: if isDocumentOwner(uid);\n        allow create: if validShopNotificationCreate(uid, notificationId);\n        allow update: if (isDocumentOwner(uid)\n            && resource.data.providerId == uid\n            && resource.data.isRead == false\n            && request.resource.data.isRead == true\n            && request.resource.data.readAt == request.time\n            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"isRead\", \"readAt\"]))\n          || validShopNotificationUpdate(uid, notificationId);\n        allow delete: if false;\n      }\n\n      match /homeGarageNotifications/{notificationId} {\n        allow get, list: if isDocumentOwner(uid);\n        allow create: if validHomeGarageNotificationCreate(uid, notificationId);\n        allow update: if (isDocumentOwner(uid) && resource.data.providerId == uid\n            && resource.data.isRead == false && request.resource.data.isRead == true\n            && request.resource.data.readAt == request.time\n            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"isRead\", \"readAt\"]))\n          || validHomeGarageNotificationUpdate(uid, notificationId);\n        allow delete: if false;\n      }\n\n      // Account status messages are created by admins in the same batch as a\n      // provider status transition.\n      match /accountStatusNotifications/{notificationId} {\n        allow get, list: if isDocumentOwner(uid);\n        allow create: if request.resource.data.keys().hasOnly([\n            \"notificationId\", \"providerId\", \"providerRole\", \"status\", \"previousStatus\", \"title\", \"message\", \"reason\",\n            \"isRead\", \"readAt\", \"createdAt\", \"updatedAt\"\n          ])\n          && (validAdminVerificationNotification(uid, notificationId)\n            || validAdminAccountStatusNotification(uid, notificationId));\n        allow update: if isDocumentOwner(uid)\n          && resource.data.providerId == uid\n          && resource.data.isRead == false\n          && request.resource.data.isRead == true\n          && request.resource.data.readAt == request.time\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"isRead\", \"readAt\"]);\n        allow update: if isAdmin()\n          && resource.data.providerId == uid\n          && resource.data.status == \"ACTIVE\"\n          && get(/databases/$(database)/documents/users/$(uid)).data.accountStatus == \"active\"\n          && get(/databases/$(database)/documents/users/$(uid)).data.accountStatusNotificationId == notificationId\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"message\", \"updatedAt\"])\n          && request.resource.data.message is string\n          && request.resource.data.updatedAt == request.time;\n        allow delete: if false;\n      }\n\n      // Per-shop idempotency pointer, private to the vehicle owner.\n      match /shopBookingLocks/{providerId} {\n        allow get: if isDocumentOwner(uid);\n        allow list: if false;\n        allow create, update: if validShopBookingLockWrite(uid, providerId);\n        allow delete: if false;\n      }\n\n      match /homeGarageBookingLocks/{providerId} {\n        allow get: if isDocumentOwner(uid);\n        allow list: if false;\n        allow create, update: if validHomeGarageBookingLockWrite(uid, providerId);\n        allow delete: if false;\n      }\n\n      // Providers may submit and resubmit private verification information,\n      // but cannot mark themselves as verified from the client application.\n      match /ownerProfile/profile {\n        allow get: if isDocumentOwner(uid) || isAdmin();\n        allow update: if validAdminReview(uid, \"owner\", false);\n        allow create, update: if isDocumentOwner(uid)\n          && request.resource.data.uid == uid\n          && request.resource.data.role == \"owner\"\n          && isPendingVerificationSubmission();\n        allow update: if isDocumentOwner(uid)\n          && request.resource.data.uid == resource.data.uid\n          && request.resource.data.role == resource.data.role\n          && request.resource.data.verificationStatus == resource.data.verificationStatus\n          && request.resource.data.identification == resource.data.identification\n          && request.resource.data.vehicleDocuments == resource.data.vehicleDocuments\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"personal\", \"updatedAt\"])\n          && request.resource.data.personal.keys().hasOnly([\"fullName\", \"phone\", \"address\", \"cityMunicipality\"])\n          && request.resource.data.personal.fullName is string\n          && request.resource.data.personal.phone is string\n          && request.resource.data.personal.address is string\n          && request.resource.data.personal.cityMunicipality is string;\n        allow delete: if false;\n      }\n\n      match /providerProfile/profile {\n        allow get: if isDocumentOwner(uid) || isAdmin();\n        allow list: if isAdmin() && resource.data.verificationStatus == \"PENDING\";\n        allow create: if isDocumentOwner(uid) && isPendingVerificationSubmission();\n        allow update: if validAdminReview(uid, \"onsite-mechanic\", false)\n          || (isDocumentOwner(uid) && isPendingVerificationSubmission())\n          || validMechanicProfileEdit(uid);\n        allow delete: if false;\n      }\n\n      match /towingCompanyProfile/profile {\n        allow get: if isDocumentOwner(uid) || isAdmin();\n        allow list: if isAdmin() && resource.data.verificationStatus == \"PENDING\";\n        allow create: if isDocumentOwner(uid)\n          && request.resource.data.uid == uid\n          && request.resource.data.role == \"towing-company\"\n          && isPendingVerificationSubmission();\n        allow update: if (isDocumentOwner(uid)\n            && resource.data.uid == uid\n            && resource.data.role == \"towing-company\"\n            && resource.data.verificationStatus in [\"INCOMPLETE\", \"PENDING\", \"REJECTED\"]\n            && isPendingVerificationSubmission())\n          || validAdminReview(uid, \"towing-company\", false)\n          || validTowingCompanyProfileEdit(uid);\n        allow delete: if false;\n      }\n\n      // Auto shops submit private verification documents here. Client writes\n      // are limited to a pending submission; approval remains administrator-controlled.\n      match /shopVerification/profile {\n        allow get: if isDocumentOwner(uid) || isAdmin();\n        allow update: if validAdminReview(uid, \"shop-owner\", false);\n        allow create: if isDocumentOwner(uid)\n          && request.resource.data.uid == uid\n          && request.resource.data.role == \"shop-owner\"\n          && request.resource.data.verificationStatus == \"PENDING\";\n        allow update: if isDocumentOwner(uid)\n            && request.resource.data.uid == uid\n            && request.resource.data.role == \"shop-owner\"\n            && request.resource.data.verificationStatus == \"PENDING\";\n        allow delete: if false;\n      }\n\n      // HomeGarage parking providers submit private business documents here.\n      // Approval is performed by administration, never by the client.\n      match /homeGarageVerification/profile {\n        allow get: if isDocumentOwner(uid) || isAdmin();\n        allow create: if isDocumentOwner(uid)\n          && request.resource.data.uid == uid\n          && request.resource.data.role == \"homegarage\"\n          && request.resource.data.verificationStatus == \"PENDING\";\n        allow update: if validAdminReview(uid, \"homegarage\", false)\n          || (isDocumentOwner(uid)\n            && request.resource.data.uid == uid\n            && request.resource.data.role == \"homegarage\"\n            && request.resource.data.verificationStatus == \"PENDING\");\n        allow delete: if false;\n      }\n\n      match /towingPricing/{pricingId} {\n        allow get: if pricingId == \"config\" && (isDocumentOwner(uid)\n          || (signedIn()\n            && exists(/databases/$(database)/documents/providerListings/$(uid))\n            && get(/databases/$(database)/documents/providerListings/$(uid)).data.role == \"towing-company\"\n            && get(/databases/$(database)/documents/providerListings/$(uid)).data.visibility == \"active\"));\n        allow list: if false;\n        allow create: if pricingId == \"config\"\n          && isDocumentOwner(uid)\n          && verifiedTowingCompany(uid)\n          && validTowingPricingShape()\n          && request.resource.data.createdAt == request.time\n          && request.resource.data.updatedAt == request.time;\n        allow update: if pricingId == \"config\"\n          && isDocumentOwner(uid)\n          && verifiedTowingCompany(uid)\n          && validTowingPricingShape()\n          && request.resource.data.createdAt == resource.data.createdAt\n          && request.resource.data.updatedAt == request.time\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n            \"basePrice\", \"pricePerKm\", \"pricingMode\", \"dispatcherPhone\", \"updatedAt\"\n          ]);\n        allow delete: if false;\n      }\n    }\n\n    // Business profiles stay private. Only trusted administration can approve a\n    // shop; clients cannot set approval, replace an approved doc or delete it.\n    match /providers/{uid} {\n      allow read: if isDocumentOwner(uid) || (isAdmin() && resource.data.role == \"shop-owner\");\n      allow list: if isAdmin() && resource.data.role == \"shop-owner\";\n      allow update: if validShopReview(uid);\n      allow create: if isDocumentOwner(uid)\n        && ((isShopOwner(uid)\n            && request.resource.data.uid == uid\n            && request.resource.data.role == \"shop-owner\"\n            && request.resource.data.verified == false\n            && request.resource.data.rating == 0\n            && request.resource.data.status == \"closed\")\n          || (!isShopOwner(uid) && request.resource.data.role != \"shop-owner\"));\n      allow update: if isDocumentOwner(uid)\n        && ((isShopOwner(uid) && resource.data.role == \"shop-owner\"\n            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n              \"businessName\", \"phone\", \"address\", \"latitude\", \"longitude\", \"status\"\n            ])\n            && request.resource.data.status in [\"open\", \"closed\"])\n          || (isShopOwner(uid) && resource.data.role == \"shop-owner\"\n            && validApprovedShopProfileSync(uid))\n          || (!isShopOwner(uid) && resource.data.role != \"shop-owner\" && request.resource.data.role != \"shop-owner\"));\n      allow delete: if isDocumentOwner(uid) && !isShopOwner(uid) && resource.data.role != \"shop-owner\";\n    }\n\n    // Providers publish the minimal customer-map document directly. If a\n    // provider's verification is later revoked, the trusted admin workflow\n    // must remove or deactivate this existing listing.\n    match /providerListings/{providerId} {\n      allow get: if isAdmin() || isDocumentOwner(providerId) || (signedIn() && resource.data.visibility == \"active\" && (resource.data.availability == \"available\" || resource.data.get(\"acceptsScheduledBookings\", false) == true));\n      allow list: if isAdmin() || (signedIn() && resource.data.visibility == \"active\" && (resource.data.availability == \"available\" || resource.data.get(\"acceptsScheduledBookings\", false) == true));\n      allow update: if validAdminListingRestore(providerId) || validAdminListingHide(providerId);\n      allow create: if accountIsActive(providerId) && validPublicListingCreate(providerId);\n      allow update: if validProviderListingUpdate(providerId);\n      allow delete: if false;\n    }\n\n    match /providerStatusHistory/{historyId} {\n      allow get, list: if isAdmin();\n      allow create: if validProviderStatusHistory(historyId);\n      allow update: if validAdminListingRestoreHistory(historyId);\n      allow delete: if false;\n    }\n\n    match /providerVerificationHistory/{historyId} {\n      allow get, list: if isAdmin();\n      allow create: if validProviderVerificationHistory();\n      allow update, delete: if false;\n    }\n\n    // Admin review queues use collection-group queries and return only pending submissions.\n    match /{path=**}/ownerProfile/{profileId} {\n      allow list: if isAdmin() && resource.data.verificationStatus == \"PENDING\";\n    }\n    match /{path=**}/providerProfile/{profileId} {\n      allow list: if isAdmin() && resource.data.verificationStatus == \"PENDING\";\n    }\n    match /{path=**}/towingCompanyProfile/{profileId} {\n      allow list: if isAdmin() && resource.data.verificationStatus == \"PENDING\";\n    }\n    match /{path=**}/shopVerification/{profileId} {\n      allow list: if isAdmin() && resource.data.verificationStatus == \"PENDING\";\n    }\n    match /{path=**}/homeGarageVerification/{profileId} {\n      allow list: if isAdmin() && resource.data.verificationStatus == \"PENDING\";\n    }\n\n    // Parking bookings are customer-controlled sessions. Capacity changes are\n    // only accepted alongside the app's Firestore transactions; providers\n    // never need to start or end a customer's parking session.\n    match /parkingBookings/{bookingId} {\n      // Stage 1 stops new sessions while existing sessions remain readable and completable.\n      allow create: if false;\n      allow get, list: if signedIn() && (resource.data.customerId == request.auth.uid || resource.data.providerId == request.auth.uid);\n      allow update: if signedIn() && resource.data.customerId == request.auth.uid\n        && ((resource.data.status == \"reserved\" && request.resource.data.status == \"active\"\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"parkingStartedAt\", \"updatedAt\"])\n          && request.resource.data.parkingStartedAt == request.time && request.resource.data.updatedAt == request.time)\n          || (resource.data.status == \"active\" && request.resource.data.status == \"completed\"\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"parkingEndedAt\", \"updatedAt\"])\n          && request.resource.data.parkingEndedAt == request.time && request.resource.data.updatedAt == request.time\n          && getAfter(/databases/$(database)/documents/parkingSlots/$(resource.data.slotId)).data.status == \"available\"));\n      allow delete: if false;\n    }\n\n    // A slot is the atomic capacity lock. Its state carries no public vehicle\n    // data, and only its reserving customer can release it.\n    match /parkingSlots/{slotId} {\n      allow get, list: if signedIn();\n      allow create: if isDocumentOwner(request.resource.data.providerId)\n        && accountIsActive(request.auth.uid)\n        && request.resource.data.keys().hasOnly([\"providerId\", \"slotNumber\", \"status\", \"customerId\", \"bookingId\"])\n        && request.resource.data.slotNumber is int && request.resource.data.slotNumber >= 1 && request.resource.data.slotNumber <= 500\n        && request.resource.data.status == \"available\" && request.resource.data.customerId == null && request.resource.data.bookingId == null\n        && get(/databases/$(database)/documents/providerListings/$(request.resource.data.providerId)).data.role == \"homegarage\";\n      allow update: if signedIn()\n        && (resource.data.status == \"reserved\" && resource.data.customerId == request.auth.uid\n          && request.resource.data.status == \"available\" && request.resource.data.customerId == null && request.resource.data.bookingId == null\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"customerId\", \"bookingId\", \"updatedAt\"])\n          && request.resource.data.updatedAt == request.time);\n      allow delete: if false;\n    }\n\n    match /providerScheduleReservations/{reservationId} {\n      allow get: if isAdmin() || (signedIn() &&\n        ((!exists(/databases/$(database)/documents/providerScheduleReservations/$(reservationId))\n            && reservationId.matches(\"^.+_[0-9]+$\"))\n          || resource.data.providerId == request.auth.uid\n          || get(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.customerId == request.auth.uid));\n      allow list: if false;\n      allow create: if signedIn()\n        && request.resource.data.keys().hasOnly([\"providerId\", \"bookingId\", \"scheduledAt\", \"createdAt\"])\n        && request.resource.data.providerId == request.auth.uid\n        && request.resource.data.bookingId is string\n        && request.resource.data.scheduledAt is timestamp\n        && request.resource.data.createdAt == request.time\n        && reservationId == request.auth.uid + \"_\" + string(request.resource.data.scheduledAt.toMillis())\n        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.providerId == request.auth.uid\n        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.timingMode == \"scheduled\"\n        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.scheduledAt == request.resource.data.scheduledAt\n        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.status == \"accepted\";\n      allow update: if false;\n      allow delete: if signedIn()\n        && resource.data.bookingId is string\n        && getAfter(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.customerId == request.auth.uid\n        && getAfter(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.status == \"cancelled\";\n    }\n\n    match /bookings/{bookingId} {\n      function providerTransitionAllowed() {\n        return resource.data.bookingType == \"shop-owner\"\n          ? validShopBookingTransition(bookingId)\n          : resource.data.bookingType == \"homegarage\"\n            ? validHomeGarageBookingTransition(bookingId)\n            : resource.data.bookingType in [\"onsite-mechanic\", \"towing-company\"]\n              && validProviderBookingTransition(bookingId);\n      }\n\n      function providerUpdateAllowed() {\n        return resource.data.providerId == request.auth.uid\n          && accountIsActive(request.auth.uid)\n          && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n                \"mechanicLatitude\", \"mechanicLongitude\", \"mechanicLocationUpdatedAt\"\n              ]) && validMechanicLocationUpdate())\n            || ((request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"updatedAt\"])\n                || (resource.data.bookingType in [\"onsite-mechanic\", \"towing-company\"]\n                  && resource.data.status == \"pending\"\n                  && request.resource.data.status == \"rejected\"\n                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"updatedAt\", \"declineReason\", \"riskEventType\", \"riskEventAt\"])\n                  && optionalBookingReasonIsValid(request.resource.data, \"declineReason\"))\n                || (resource.data.bookingType in [\"onsite-mechanic\", \"towing-company\"]\n                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"updatedAt\", \"finalPrice\", \"completedAt\"]))\n                || (resource.data.bookingType == \"homegarage\"\n                  && resource.data.status == \"pending\"\n                  && request.resource.data.status == \"rejected\"\n                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"updatedAt\", \"declineReason\", \"riskEventType\", \"riskEventAt\"])\n                  && optionalBookingReasonIsValid(request.resource.data, \"declineReason\"))\n                || (resource.data.bookingType == \"shop-owner\"\n                  && resource.data.status == \"pending\"\n                  && request.resource.data.status == \"rejected\"\n                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"updatedAt\", \"declineReason\", \"riskEventType\", \"riskEventAt\"])\n                  && optionalBookingReasonIsValid(request.resource.data, \"declineReason\"))\n                || (resource.data.bookingType in [\"shop-owner\", \"homegarage\"]\n                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"updatedAt\", \"finalPrice\", \"completedAt\", \"completionNote\"])))\n              && request.resource.data.updatedAt == request.time\n              && providerTransitionAllowed()));\n      }\n\n      function customerCancellationAllowed() {\n        return resource.data.customerId == request.auth.uid\n          && resource.data.bookingType in [\"onsite-mechanic\", \"towing-company\", \"homegarage\", \"shop-owner\"]\n          && resource.data.status in [\"pending\", \"accepted\"]\n          && request.resource.data.status == \"cancelled\"\n          && optionalRiskEventIsValid(\"owner_cancel_after_acceptance\", \"accepted\")\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"updatedAt\", \"cancellationReason\", \"riskEventType\", \"riskEventAt\"])\n          && optionalBookingReasonIsValid(request.resource.data, \"cancellationReason\")\n          && request.resource.data.updatedAt == request.time\n          && reservationReleasedFor(resource.data);\n      }\n\n      allow get, list: if isAdmin();\n      allow create: if accountIsActive(request.auth.uid)\n        && accountIsActive(request.resource.data.providerId)\n        && (request.resource.data.bookingType == \"homegarage\"\n        ? (validHomeGarageBooking() && validHomeGarageBookingLock(bookingId))\n        : request.resource.data.bookingType == \"towing-company\"\n          ? (validBookingBase() && validTowingBookingProvider())\n          : (validBookingBase()\n            && ((validShopBooking() && validShopBookingLock(bookingId))\n              || (validBookingProvider() && validMechanicBooking()))));\n      allow get, list: if signedIn()\n        && (resource.data.customerId == request.auth.uid\n          || resource.data.providerId == request.auth.uid);\n      allow update: if signedIn() && (providerUpdateAllowed() || customerCancellationAllowed());\n      allow delete: if false;\n    }\n\n    match /providerReviews/{reviewId} {\n      allow get, list: if signedIn();\n      allow create: if validProviderReview(reviewId) || validParkingProviderReview(reviewId);\n      allow update, delete: if false;\n    }\n\n    // Staff requests record manual review only; they never grant an Auth admin claim.\n    match /adminStaffRequests/{requestId} {\n      allow get, list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);\n      allow create: if signedIn()\n        && request.resource.data.keys().hasOnly([\"uid\", \"email\", \"displayName\", \"status\", \"requestedAt\"])\n        && request.resource.data.uid == request.auth.uid\n        && request.resource.data.email == request.auth.token.email\n        && request.resource.data.displayName is string\n        && request.resource.data.displayName.size() <= 120\n        && request.resource.data.status == \"PENDING\"\n        && request.resource.data.requestedAt == request.time;\n      allow update: if isAdmin()\n        && resource.data.status == \"PENDING\"\n        && resource.data.uid != request.auth.uid\n        && request.resource.data.keys().hasOnly([\"uid\", \"email\", \"displayName\", \"status\", \"requestedAt\", \"reviewedBy\", \"reviewedAt\"])\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"reviewedBy\", \"reviewedAt\"])\n        && request.resource.data.uid == resource.data.uid\n        && request.resource.data.email == resource.data.email\n        && request.resource.data.displayName == resource.data.displayName\n        && request.resource.data.requestedAt == resource.data.requestedAt\n        && request.resource.data.status in [\"MANUAL_GRANT_RECORDED\", \"REJECTED\"]\n        && request.resource.data.reviewedBy == request.auth.uid\n        && request.resource.data.reviewedAt == request.time;\n      allow delete: if false;\n    }\n\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-10-28T06:37:55.628191Z","metadata":{"services":["cloud.firestore"]}}
