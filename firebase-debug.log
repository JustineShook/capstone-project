/{profileId} {\n      allow list: if isAdmin() && resource.data.verificationStatus == \"PENDING\";\n    }\n    match /{path=**}/homeGarageVerification/{profileId} {\n      allow list: if isAdmin() && resource.data.verificationStatus == \"PENDING\";\n    }\n\n    // Parking bookings are customer-controlled sessions. Capacity changes are\n    // only accepted alongside the app's Firestore transactions; providers\n    // never need to start or end a customer's parking session.\n    match /parkingBookings/{bookingId} {\n      // Stage 1 stops new sessions while existing sessions remain readable and completable.\n      allow create: if false;\n      allow get, list: if signedIn() && (resource.data.customerId == request.auth.uid || resource.data.providerId == request.auth.uid);\n      allow update: if signedIn() && resource.data.customerId == request.auth.uid\n        && ((resource.data.status == \"reserved\" && request.resource.data.status == \"active\"\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"parkingStartedAt\", \"updatedAt\"])\n          && request.resource.data.parkingStartedAt == request.time && request.resource.data.updatedAt == request.time)\n          || (resource.data.status == \"active\" && request.resource.data.status == \"completed\"\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"parkingEndedAt\", \"updatedAt\"])\n          && request.resource.data.parkingEndedAt == request.time && request.resource.data.updatedAt == request.time\n          && getAfter(/databases/$(database)/documents/parkingSlots/$(resource.data.slotId)).data.status == \"available\"));\n      allow delete: if false;\n    }\n\n    // A slot is the atomic capacity lock. Its state carries no public vehicle\n    // data, and only its reserving customer can release it.\n    match /parkingSlots/{slotId} {\n      allow get, list: if signedIn();\n      allow create: if isDocumentOwner(request.resource.data.providerId)\n        && accountIsActive(request.auth.uid)\n        && request.resource.data.keys().hasOnly([\"providerId\", \"slotNumber\", \"status\", \"customerId\", \"bookingId\"])\n        && request.resource.data.slotNumber is int && request.resource.data.slotNumber >= 1 && request.resource.data.slotNumber <= 500\n        && request.resource.data.status == \"available\" && request.resource.data.customerId == null && request.resource.data.bookingId == null\n        && get(/databases/$(database)/documents/providerListings/$(request.resource.data.providerId)).data.role == \"homegarage\";\n      allow update: if signedIn()\n        && (resource.data.status == \"reserved\" && resource.data.customerId == request.auth.uid\n          && request.resource.data.status == \"available\" && request.resource.data.customerId == null && request.resource.data.bookingId == null\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"customerId\", \"bookingId\", \"updatedAt\"])\n          && request.resource.data.updatedAt == request.time);\n      allow delete: if false;\n    }\n\n    match /providerScheduleReservations/{reservationId} {\n      allow get: if isAdmin() || (signedIn() &&\n        ((!exists(/databases/$(database)/documents/providerScheduleReservations/$(reservationId))\n            && reservationId.matches(\"^.+_[0-9]+$\"))\n          || resource.data.providerId == request.auth.uid\n          || get(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.customerId == request.auth.uid));\n      allow list: if false;\n      allow create: if signedIn()\n        && request.resource.data.keys().hasOnly([\"providerId\", \"bookingId\", \"scheduledAt\", \"createdAt\"])\n        && request.resource.data.providerId == request.auth.uid\n        && request.resource.data.bookingId is string\n        && request.resource.data.scheduledAt is timestamp\n        && request.resource.data.createdAt == request.time\n        && reservationId == request.auth.uid + \"_\" + string(request.resource.data.scheduledAt.toMillis())\n        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.providerId == request.auth.uid\n        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.timingMode == \"scheduled\"\n        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.scheduledAt == request.resource.data.scheduledAt\n        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.status == \"accepted\";\n      allow update: if false;\n      allow delete: if signedIn()\n        && resource.data.bookingId is string\n        && getAfter(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.customerId == request.auth.uid\n        && getAfter(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.status == \"cancelled\";\n    }\n\n    match /bookings/{bookingId} {\n      function providerTransitionAllowed() {\n        return resource.data.bookingType == \"shop-owner\"\n          ? validShopBookingTransition(bookingId)\n          : resource.data.bookingType == \"homegarage\"\n            ? validHomeGarageBookingTransition(bookingId)\n            : resource.data.bookingType in [\"onsite-mechanic\", \"towing-company\"]\n              && validProviderBookingTransition(bookingId);\n      }\n\n      function providerUpdateAllowed() {\n        return resource.data.providerId == request.auth.uid\n          && accountIsActive(request.auth.uid)\n          && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n                \"mechanicLatitude\", \"mechanicLongitude\", \"mechanicLocationUpdatedAt\"\n              ]) && validMechanicLocationUpdate())\n            || ((request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"updatedAt\"])\n                || (resource.data.bookingType in [\"onsite-mechanic\", \"towing-company\"]\n                  && resource.data.status == \"pending\"\n                  && request.resource.data.status == \"rejected\"\n                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"updatedAt\", \"declineReason\", \"riskEventType\", \"riskEventAt\"])\n                  && optionalBookingReasonIsValid(request.resource.data, \"declineReason\"))\n                || (resource.data.bookingType in [\"onsite-mechanic\", \"towing-company\"]\n                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"updatedAt\", \"finalPrice\", \"completedAt\"]))\n                || (resource.data.bookingType == \"homegarage\"\n                  && resource.data.status == \"pending\"\n                  && request.resource.data.status == \"rejected\"\n                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"updatedAt\", \"declineReason\", \"riskEventType\", \"riskEventAt\"])\n                  && optionalBookingReasonIsValid(request.resource.data, \"declineReason\"))\n                || (resource.data.bookingType == \"shop-owner\"\n                  && resource.data.status == \"pending\"\n                  && request.resource.data.status == \"rejected\"\n                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"updatedAt\", \"declineReason\", \"riskEventType\", \"riskEventAt\"])\n                  && optionalBookingReasonIsValid(request.resource.data, \"declineReason\"))\n                || (resource.data.bookingType in [\"shop-owner\", \"homegarage\"]\n                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"updatedAt\", \"finalPrice\", \"completedAt\", \"completionNote\"])))\n              && request.resource.data.updatedAt == request.time\n              && providerTransitionAllowed()));\n      }\n\n      function customerCancellationAllowed() {\n        return resource.data.customerId == request.auth.uid\n          && resource.data.bookingType in [\"onsite-mechanic\", \"towing-company\", \"homegarage\", \"shop-owner\"]\n          && resource.data.status in [\"pending\", \"accepted\"]\n          && request.resource.data.status == \"cancelled\"\n          && optionalRiskEventIsValid(\"owner_cancel_after_acceptance\", \"accepted\")\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"updatedAt\", \"cancellationReason\", \"riskEventType\", \"riskEventAt\"])\n          && optionalBookingReasonIsValid(request.resource.data, \"cancellationReason\")\n          && request.resource.data.updatedAt == request.time\n          && reservationReleasedFor(resource.data);\n      }\n\n      allow get, list: if isAdmin();\n      allow create: if accountIsActive(request.auth.uid)\n        && accountIsActive(request.resource.data.providerId)\n        && (request.resource.data.bookingType == \"homegarage\"\n        ? (validHomeGarageBooking() && validHomeGarageBookingLock(bookingId))\n        : request.resource.data.bookingType == \"towing-company\"\n          ? (validBookingBase() && validTowingBookingProvider())\n          : (validBookingBase()\n            && ((validShopBooking() && validShopBookingLock(bookingId))\n              || (validBookingProvider() && validMechanicBooking()))));\n      allow get, list: if signedIn()\n        && (resource.data.customerId == request.auth.uid\n          || resource.data.providerId == request.auth.uid);\n      allow update: if signedIn() && (providerUpdateAllowed() || customerCancellationAllowed());\n      allow delete: if false;\n    }\n\n    match /providerReviews/{reviewId} {\n      allow get, list: if signedIn();\n      allow create: if validProviderReview(reviewId) || validParkingProviderReview(reviewId);\n      allow update, delete: if false;\n    }\n\n    // Staff requests record manual review only; they never grant an Auth admin claim.\n    match /adminStaffRequests/{requestId} {\n      allow get, list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);\n      allow create: if signedIn()\n        && request.resource.data.keys().hasOnly([\"uid\", \"email\", \"displayName\", \"status\", \"requestedAt\"])\n        && request.resource.data.uid == request.auth.uid\n        && request.resource.data.email == request.auth.token.email\n        && request.resource.data.displayName is string\n        && request.resource.data.displayName.size() <= 120\n        && request.resource.data.status == \"PENDING\"\n        && request.resource.data.requestedAt == request.time;\n      allow update: if isAdmin()\n        && resource.data.status == \"PENDING\"\n        && resource.data.uid != request.auth.uid\n        && request.resource.data.keys().hasOnly([\"uid\", \"email\", \"displayName\", \"status\", \"requestedAt\", \"reviewedBy\", \"reviewedAt\"])\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"reviewedBy\", \"reviewedAt\"])\n        && request.resource.data.uid == resource.data.uid\n        && request.resource.data.email == resource.data.email\n        && request.resource.data.displayName == resource.data.displayName\n        && request.resource.data.requestedAt == resource.data.requestedAt\n        && request.resource.data.status in [\"MANUAL_GRANT_RECORDED\", \"REJECTED\"]\n        && request.resource.data.reviewedBy == request.auth.uid\n        && request.resource.data.reviewedAt == request.time;\n      allow delete: if false;\n    }\n\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n"}]}}
