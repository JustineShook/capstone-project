.resource.data.get(\"contactPhone\", \"\") == \"\")\n        && (role == \"shop-owner\"\n          ? (changed.hasOnly([\"availability\"])\n            ? validShopAvailabilitySync(uid)\n            : changed.hasOnly([\"businessName\", \"location\", \"availability\", \"serviceAreaLabel\", \"description\", \"contactPhone\", \"services\", \"vehicleTypes\", \"operatingHours\", \"startingPrice\", \"emergencyServiceAvailable\", \"acceptsScheduledBookings\", \"photoUrls\", \"hoursType\", \"is24Hours\", \"weeklyHours\", \"visibility\"])\n              && validShopPublicListingUpdate(uid))\n          : role == \"onsite-mechanic\"\n            ? (changed.hasOnly([\"availability\"])\n              ? (request.resource.data.availability == \"busy\"\n                ? validActiveServiceAcquisition(uid)\n                : validMechanicAvailabilitySync(uid) || validActiveServiceRelease(uid))\n              : changed.hasOnly([\"businessName\", \"location\", \"availability\", \"serviceAreaLabel\", \"description\", \"contactPhone\", \"services\", \"vehicleTypes\", \"operatingHours\", \"startingPrice\", \"emergencyServiceAvailable\", \"acceptsScheduledBookings\", \"photoUrls\", \"hoursType\", \"is24Hours\", \"weeklyHours\", \"totalSlots\", \"availableSlots\", \"visibility\"])\n                && (!changed.hasAny([\"visibility\"]) || accountIsActive(uid))\n                && validPublicListingUpdate(uid))\n            : role == \"homegarage\"\n              ? (changed.hasOnly([\"availability\"])\n                ? validHomeGarageAvailabilitySync(uid)\n                : changed.hasOnly([\"businessName\", \"location\", \"availability\", \"serviceAreaLabel\", \"description\", \"contactPhone\", \"services\", \"vehicleTypes\", \"operatingHours\", \"startingPrice\", \"emergencyServiceAvailable\", \"acceptsScheduledBookings\", \"photoUrls\", \"hoursType\", \"is24Hours\", \"weeklyHours\", \"totalSlots\", \"availableSlots\", \"visibility\"])\n                  && (!changed.hasAny([\"visibility\"]) || accountIsActive(uid))\n                  && validPublicListingUpdate(uid))\n              : role == \"towing-company\"\n                ? (changed.hasOnly([\"availability\"])\n                  ? (request.resource.data.availability == \"busy\"\n                    ? validActiveServiceAcquisition(uid)\n                    : validTowingAvailabilitySync(uid) || validActiveServiceRelease(uid))\n                  : changed.hasOnly([\"businessName\", \"location\", \"availability\", \"serviceAreaLabel\", \"description\", \"contactPhone\", \"services\", \"vehicleTypes\", \"operatingHours\", \"startingPrice\", \"emergencyServiceAvailable\", \"acceptsScheduledBookings\", \"photoUrls\", \"hoursType\", \"is24Hours\", \"weeklyHours\", \"totalSlots\", \"availableSlots\", \"visibility\"])\n                    && (!changed.hasAny([\"visibility\"]) || accountIsActive(uid))\n                    && validPublicListingUpdate(uid))\n                : false);\n    }\n    function validMechanicProfileEdit(uid) {\n      let profilePath = /databases/$(database)/documents/users/$(uid)/providerProfile/profile;\n      let oldProfile = get(profilePath).data;\n      return signedIn()\n        && request.auth.uid == uid\n        && oldProfile.uid == uid\n        && oldProfile.role == \"onsite-mechanic\"\n        && oldProfile.verificationStatus in [\"INCOMPLETE\", \"PENDING\", \"VERIFIED\", \"REJECTED\"]\n        && request.resource.data.uid == oldProfile.uid\n        && request.resource.data.role == oldProfile.role\n        && request.resource.data.verificationStatus == oldProfile.verificationStatus\n        && request.resource.data.identification == oldProfile.identification\n        && request.resource.data.diff(oldProfile).affectedKeys().hasOnly([\n          \"personal\", \"professional\", \"credentials\", \"serviceInfo\", \"publicListing\", \"updatedAt\"\n        ])\n        && request.resource.data.updatedAt == request.time;\n    }\n\n    function validTowingCompanyProfileEdit(uid) {\n      let profilePath = /databases/$(database)/documents/users/$(uid)/towingCompanyProfile/profile;\n      let oldProfile = get(profilePath).data;\n      return signedIn()\n        && request.auth.uid == uid\n        && oldProfile.uid == uid\n        && oldProfile.role == \"towing-company\"\n        && oldProfile.verificationStatus in [\"INCOMPLETE\", \"PENDING\", \"VERIFIED\", \"REJECTED\"]\n        && request.resource.data.uid == oldProfile.uid\n        && request.resource.data.role == oldProfile.role\n        && request.resource.data.verificationStatus == oldProfile.verificationStatus\n        && request.resource.data.businessDocuments == oldProfile.businessDocuments\n        && request.resource.data.representative.governmentIdType == oldProfile.representative.governmentIdType\n        && request.resource.data.representative.governmentIdNumber == oldProfile.representative.governmentIdNumber\n        && request.resource.data.representative.validIdUrl == oldProfile.representative.validIdUrl\n        && request.resource.data.representative.profilePhotoUrl == oldProfile.representative.profilePhotoUrl\n        && request.resource.data.diff(oldProfile).affectedKeys().hasOnly([\n          \"company\", \"services\", \"representative\", \"updatedAt\"\n        ])\n        && request.resource.data.company.keys().hasOnly([\n          \"companyName\", \"phone\", \"address\", \"cityMunicipality\", \"operatingHours\"\n        ])\n        && request.resource.data.company.companyName is string\n        && request.resource.data.company.companyName.size() > 0\n        && request.resource.data.company.companyName.size() <= 120\n        && request.resource.data.company.phone is string\n        && request.resource.data.company.phone.size() > 0\n        && request.resource.data.company.phone.size() <= 30\n        && request.resource.data.company.address is string\n        && request.resource.data.company.address.size() > 0\n        && request.resource.data.company.address.size() <= 300\