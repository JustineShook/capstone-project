bookingId == bookingId;\n    }\n\n    function validShopBookingLockWrite(uid, providerId) {\n      let bookingPath = /databases/$(database)/documents/bookings/$(request.resource.data.bookingId);\n      return signedIn()\n        && request.resource.data.keys().hasOnly([\"customerId\", \"providerId\", \"bookingId\"])\n        && isDocumentOwner(uid)\n        && request.resource.data.customerId == uid\n        && request.resource.data.providerId == providerId\n        && request.resource.data.bookingId is string\n        && existsAfter(bookingPath)\n        && getAfter(bookingPath).data.bookingType == \"shop-owner\"\n        && getAfter(bookingPath).data.customerId == request.auth.uid\n        && getAfter(bookingPath).data.providerId == request.resource.data.providerId\n        && getAfter(bookingPath).data.status == \"pending\";\n    }\n\n    function validShopBookingTransition(bookingId) {\n      let before = resource.data.status;\n      let after = request.resource.data.status;\n      return isShopOwner(request.auth.uid)\n        && ((before == \"pending\" && after == \"accepted\"\n              && (resource.data.get(\"timingMode\", \"now\") == \"scheduled\" || isOpenShop(request.auth.uid))\n              && verifiedShop(request.auth.uid)\n              && reservationClaimedFor(bookingId, resource.data)\n              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"updatedAt\"]))\n          || (before == \"pending\" && after == \"rejected\"\n              && optionalRiskEventIsValid(\"provider_decline\", \"pending\")\n              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"updatedAt\", \"declineReason\", \"riskEventType\", \"riskEventAt\"])\n              && optionalBookingReasonIsValid(request.resource.data, \"declineReason\"))\n          || (before == \"accepted\" && after == \"vehicle_arrived\"\n              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\"