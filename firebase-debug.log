tingUpdate(uid))\n                : false);\n    }\n    function validMechanicProfileEdit(uid) {\n      let profilePath = /databases/$(database)/documents/users/$(uid)/providerProfile/profile;\n      let oldProfile = get(profilePath).data;\n      return signedIn()\n        && request.auth.uid == uid\n        && oldProfile.uid == uid\n        && oldProfile.role == \"onsite-mechanic\"\n        && oldProfile.verificationStatus in [\"INCOMPLETE\", \"PENDING\", \"VERIFIED\", \"REJECTED\"]\n        && request.resource.data.uid == oldProfile.uid\n        && request.resource.data.role == oldProfile.role\n        && request.resource.data.verificationStatus == oldProfile.verificationStatus\n        && request.resource.data.identification == oldProfile.identification\n        && request.resource.data.diff(oldProfile).affectedKeys().hasOnly([\n          \"personal\", \"professional\", \"credentials\", \"serviceInfo\", \"publicListing\", \"updatedAt\"\n        ])\n        && request.resource.data.updatedAt == request.time;\n    }\n\n    function validTowingCompanyProfileEdit(uid) {\n      let profilePath = /databases/$(database)/documents/users/$(uid)/towingCompanyProfile/profile;\n      let oldProfile = get(profilePath).data;\n      return signedIn()\n        && request.auth.uid == uid\n        && oldProfile.uid == uid\n        && oldProfile.role == \"towing-company\"\n        && oldProfile.verificationStatus in [\"INCOMPLETE\", \"PENDING\", \"VERIFIED\", \"REJECTED\"]\n        && request.resource.data.uid == oldProfile.uid\n        && request.resource.data.role == oldProfile.role\n        && request.resource.data.verificationStatus == oldProfile.verificationStatus\n        && request.resource.data.businessDocuments == oldProfile.businessDocuments\n        && request.resource.data.representative.governmentIdType == oldProfile.representative.governmentIdType\n        && request.resource.data.representative.governmentIdNumber == oldProfile.representative.governmentIdNumber\n     