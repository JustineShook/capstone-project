[debug] [2026-10-29T06:23:51.470Z] >>> [apiv2][body] PUT http://127.0.0.1:18185/emulator/v1/projects/demo-veresc:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function signedIn() {\n      return request.auth != null;\n    }\n\n    // Temporary rollout compatibility: a missing reason is accepted for old\n    // clients, but a supplied reason must contain non-whitespace text.\n    function optionalBookingReasonIsValid(data, field) {\n      return !data.keys().hasAny([field])\n        || (data[field] is string\n          && data[field].matches('(?s).*\\\\S.*')\n          && data[field].size() <= 500);\n    }\n\n    // Compatibility phase: legacy clients may omit both risk fields. Updated\n    // clients must provide the matching event type and server timestamp.\n    function optionalRiskEventIsValid(eventType, previousStatus) {\n      let data = request.resource.data;\n      let hasType = data.keys().hasAny([\"riskEventType\"]);\n      let hasAt = data.keys().hasAny([\"riskEventAt\"]);\n      return (!hasType && !hasAt)\n        || (hasType && hasAt\n          && data.riskEventType == eventType\n          && data.riskEventAt == request.time\n          && resource.data.status == previousStatus);\n    }\n\n    function accountIsActive(uid) {\n      let userPath = /databases/$(database)/documents/users/$(uid);\n      return !exists(userPath)\n        || get(userPath).data.get(\"accountStatus\", \"active\") == \"active\";\n    }\n\n    function isDocumentOwner(uid) {\n      return signedIn() && request.auth.uid == uid;\n    }\n\n    function isAdmin() {\n      return signedIn()\n        && request.auth.token.get(\"admin\", false) == true;\n    }\n\n    function listingHiddenAfterReview(uid) {\n      let listing = /databases/$(database)/documents/providerListings/$(uid);\n      return !existsAfter(listing) || getAfter(listing).data.visibility == \"inactive\";\n    }\n\n    function adminReviewedProfile(path) {\n      return existsAfter(path)\n        && getAfter(path).data.verificationStatus in [\"VERIFIED\", \"REJECTED\"]\n        && getAfter(path).data.reviewedAt == request.time\n        && getAfter(path).data.reviewedBy == request.auth.uid;\n    }\n\n    function validAdminListingHide(uid) {\n      let userPath = /databases/$(database)/documents/users/$(uid);\n      let role = resource.data.role;\n      let reviewedRoleProfile = role == \"owner\"\n        ? adminReviewedProfile(/databases/$(database)/documents/users/$(uid)/ownerProfile/profile)\n        : role == \"onsite-mechanic\"\n          ? adminReviewedProfile(/databases/$(database)/documents/users/$(uid)/providerProfile/profile)\n          : role == \"towing-company\"\n            ? adminReviewedProfile(/databases/$(database)/documents/users/$(uid)/towingCompanyProfile/profile)\n            : role == \"homegarage\"\n              ? adminReviewedProfile(/databases/$(database)/documents/users/$(uid)/homeGarageVerification/profile)\n              : role == \"shop-owner\"\n                ? (adminReviewedProfile(/databases/$(database)/documents/users/$(uid)/shopVerification/profile)\n                  || adminReviewedProfile(/databases/$(database)/documents/providers/$(uid)))\n                : false;\n      return isAdmin()\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"visibility\"])\n        && request.resource.data.visibility == \"inactive\"\n        && (reviewedRoleProfile\n          || (existsAfter(userPath)\n            && getAfter(userPath).data.accountStatus == \"suspended\"\n            && getAfter(userPath).data.accountStatusUpdatedAt == request.time\n            && getAfter(userPath).data.accountStatusUpdatedBy == request.auth.uid))\n        ;\n    }\n\n    function providerWasPublicBeforeSuspension(uid, role) {\n      let userPath = /databases/$(database)/documents/users/$(uid);\n      let suspensionPath = /databases/$(database)/documents/providerStatusHistory/$(get(userPath).data.accountStatusNotificationId);\n      return exists(userPath)\n        && get(userPath).data.get(\"accountStatus\", \"active\") == \"suspended\"\n        && get(userPath).data.accountStatusNotificationId is string\n        && exists(suspensionPath)\n        && get(suspensionPath).data.providerId == uid\n        && get(suspensionPath).data.role == role\n        && get(suspensionPath).data.newStatus == \"suspended\"\n        && get(suspensionPath).data.listingVisibilityBeforeSuspension == \"active\";\n    }\n\n    function adminProviderApprovalIsCurrent(uid, role) {\n      let userPath = /databases/$(database)/documents/users/$(uid);\n      let mechanicPath = /databases/$(database)/documents/users/$(uid)/providerProfile/profile;\n      let towingPath = /databases/$(database)/documents/users/$(uid)/towingCompanyProfile/profile;\n      let garagePath = /databases/$(database)/documents/users/$(uid)/homeGarageVerification/profile;\n      let shopPath = /databases/$(database)/documents/providers/$(uid);\n      let shopVerificationPath = /databases/$(database)/documents/users/$(uid)/shopVerification/profile;\n      return exists(userPath) && get(userPath).data.role == role\n        && (role == \"onsite-mechanic\"\n          ? exists(mechanicPath) && get(mechanicPath).data.uid == uid\n            && get(mechanicPath).data.role == role && get(mechanicPath).data.verificationStatus == \"VERIFIED\"\n          : role == \"towing-company\"\n            ? exists(towingPath) && get(towingPath).data.uid == uid\n              && get(towingPath).data.role == role && get(towingPath).data.verificationStatus == \"VERIFIED\"\n            : role == \"homegarage\"\n              ? exists(garagePath) && get(garagePath).data.uid == uid\n                && get(garagePath).data.role == role && get(garagePath).data.verificationStatus == \"VERIFIED\"\n                && get(garagePath).data.business.name is string\n                && get(garagePath).data.business.name.size() > 0\n              : role == \"shop-owner\"\n                ? exists(shopPath) && get(shopPath).data.uid == uid\n                  && get(shopPath).data.role == role && get(shopPath).data.verified == true\n                  && exists(shopVerificationPath)\n                  && get(shopVerificationPath).data.uid == uid\n                  && get(shopVerificationPath).data.role == role\n                  && get(shopVerificationPath).data.verificationStatus == \"VERIFIED\"\n                : false);\n    }\n\n    function validAdminListingRestore(uid) {\n      let userPath = /databases/$(database)/documents/users/$(uid);\n      let listingPath = /databases/$(database)/documents/providerListings/$(uid);\n      let restorePath = /databases/$(database)/documents/providerStatusHistory/$(get(userPath).data.accountStatusNotificationId);\n      let suspensionPath = /databases/$(database)/documents/providerStatusHistory/$(get(restorePath).data.previousStatusNotificationId);\n      let role = resource.data.role;\n      return isAdmin()\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"visibility\"])\n        && resource.data.visibility == \"inactive\"\n        && request.resource.data.visibility == \"active\"\n        && exists(userPath)\n        && get(userPath).data.accountStatus == \"active\"\n        && get(userPath).data.accountStatusNotificationId is string\n        && exists(restorePath)\n        && get(restorePath).data.providerId == uid\n        && get(restorePath).data.role == role\n        && get(restorePath).data.previousStatus == \"suspended\"\n        && get(restorePath).data.newStatus == \"active\"\n        && get(restorePath).data.listingRestored == false\n        && get(restorePath).data.previousStatusNotificationId is string\n        && exists(suspensionPath)\n        && get(suspensionPath).data.providerId == uid\n        && get(suspensionPath).data.role == role\n        && get(suspensionPath).data.newStatus == \"suspended\"\n        && get(suspensionPath).data.listingVisibilityBeforeSuspension == \"active\"\n        && getAfter(listingPath).data.visibility == \"active\"\n        && adminProviderApprovalIsCurrent(uid, role)\n        && request.resource.data.providerId == uid\n        && request.resource.data.role == role\n        && request.resource.data.category == (role == \"onsite-mechanic\" ? \"Onsite Mechanics\"\n          : role == \"towing-company\" ? \"Towing\"\n          : role == \"homegarage\" ? \"Parking Lots\" : \"Auto Shops\")\n        && hasExactPublicListingShape()\n        && hasValidProviderControlledFields()\n        && hasValidRoleSpecificServices()\n        && (role != \"shop-owner\" || validShopListingProfile(uid))\n        && (role != \"homegarage\" || validHomeGarageListingProfile(uid));\n    }\n\n    function validShopReview(uid) {\n      let shop = request.resource.data;\n      let verification = getAfter(/databases/$(database)/documents/users/$(uid)/shopVerification/profile).data;\n      return validAdminReview(uid, \"shop-owner\", true)\n        && (shop.verificationStatus == \"REJECTED\" || (\n          shop.businessName is string && shop.businessName.size() > 0\n          && shop.businessName != \"Unnamed Auto Shop\"\n          && shop.phone is string && shop.phone.size() > 0\n          && shop.address is string && shop.address.size() > 0\n          && shop.latitude is number && shop.latitude >= -90 && shop.latitude <= 90\n          && shop.longitude is number && shop.longitude >= -180 && shop.longitude <= 180\n          && shop.businessName == verification.business.name\n          && shop.phone == verification.business.phone\n          && shop.address == verification.business.address\n          && shop.latitude == verification.business.latitude\n          && shop.longitude == verification.business.longitude\n          && !(shop.latitude == 0 && shop.longitude == 0)));\n    }\n\n    function validProviderStatusHistory(historyId) {\n      let event = request.resource.data;\n      let account = getAfter(/databases/$(database)/documents/users/$(event.providerId)).data;\n      let listingPath = /databases/$(database)/documents/providerListings/$(event.providerId);\n      return isAdmin()\n        && event.keys().hasOnly([\"providerId\", \"role\", \"previousStatus\", \"newStatus\", \"changedAt\", \"changedBy\", \"listingVisibilityBeforeSuspension\", \"listingRestored\", \"previousStatusNotificationId\"])\n        && event.providerId is string\n        && event.role in [\"onsite-mechanic\", \"shop-owner\", \"towing-company\", \"homegarage\", \"owner\"]\n        && event.previousStatus in [\"active\", \"suspended\"]\n        && event.newStatus in [\"active\", \"suspended\"]\n        && event.newStatus != event.previousStatus\n        && event.changedAt == request.time\n        && event.changedBy == request.auth.uid\n        && account.uid == event.providerId\n        && account.role == event.role\n        && account.accountStatus == event.newStatus\n        && account.accountStatusUpdatedAt == request.time\n        && account.accountStatusUpdatedBy == request.auth.uid\n        && account.accountStatusNotificationId == historyId\n        && (!event.keys().hasAny([\"previousStatusNotificationId\"])\n          || (event.newStatus == \"active\" && event.previousStatus == \"suspended\"\n            && event.previousStatusNotificationId is string\n            && get(/databases/$(database)/documents/users/$(event.providerId)).data.accountStatus == \"suspended\"\n            && get(/databases/$(database)/documents/users/$(event.providerId)).data.accountStatusNotificationId == event.previousStatusNotificationId\n            && exists(/databases/$(database)/documents/providerStatusHistory/$(event.previousStatusNotificationId))\n            && get(/databases/$(database)/documents/providerStatusHistory/$(event.previousStatusNotificationId)).data.providerId == event.providerId\n            && get(/databases/$(database)/documents/providerStatusHistory/$(event.previousStatusNotificationId)).data.role == event.role\n            && get(/databases/$(database)/documents/providerStatusHistory/$(event.previousStatusNotificationId)).data.newStatus == \"suspended\"))\n        && (!event.keys().hasAny([\"listingVisibilityBeforeSuspension\"])\n          || (event.newStatus == \"suspended\" && event.role != \"owner\"\n            && event.listingVisibilityBeforeSuspension in [\"active\", \"inactive\", \"missing\"]\n            && (event.listingVisibilityBeforeSuspension == \"active\"\n              ? exists(listingPath) && get(listingPath).data.visibility == \"active\"\n              : event.listingVisibilityBeforeSuspension == \"inactive\"\n                ? (!exists(listingPath) || get(listingPath).data.visibility != \"active\")\n                : !exists(listingPath))))\n        && (!event.keys().hasAny([\"listingRestored\"])\n          || (event.newStatus == \"active\" && event.listingRestored is bool\n            && (!event.listingRestored || (event.role != \"owner\"\n              && providerWasPublicBeforeSuspension(event.providerId, event.role)\n              && adminProviderApprovalIsCurrent(event.providerId, event.role)\n              && existsAfter(listingPath)\n              && getAfter(listingPath).data.visibility == \"active\"\n              && getAfter(listingPath).data.role == event.role))));\n    }\n\n    function validAdminListingRestoreHistory(historyId) {\n      let event = resource.data;\n      let after = request.resource.data;\n      let userPath = /databases/$(database)/documents/users/$(event.providerId);\n      let listingPath = /databases/$(database)/documents/providerListings/$(event.providerId);\n      let suspensionPath = /databases/$(database)/documents/providerStatusHistory/$(event.previousStatusNotificationId);\n      return isAdmin()\n        && after.diff(event).affectedKeys().hasOnly([\"listingRestored\"])\n        && event.listingRestored == false && after.listingRestored == true\n        && event.newStatus == \"active\" && event.previousStatus == \"suspended\"\n        && event.providerId is string && event.role != \"owner\"\n        && get(userPath).data.accountStatus == \"active\"\n        && get(userPath).data.accountStatusNotificationId == historyId\n        && event.previousStatusNotificationId is string\n        && exists(suspensionPath)\n        && get(suspensionPath).data.providerId == event.providerId\n        && get(suspensionPath).data.role == event.role\n        && get(suspensionPath).data.newStatus == \"suspended\"\n        && get(suspensionPath).data.listingVisibilityBeforeSuspension == \"active\"\n        && adminProviderApprovalIsCurrent(event.providerId, event.role)\n        && existsAfter(listingPath)\n        && getAfter(listingPath).data.visibility == \"active\";\n    }\n\n    function validProviderVerificationHistory() {\n      let event = request.resource.data;\n      return isAdmin()\n        && event.keys().hasOnly([\"providerId\", \"providerName\", \"role\", \"decision\", \"reviewedAt\", \"reviewedBy\"])\n        && event.providerId is string\n        && event.providerName is string\n        && event.role in [\"onsite-mechanic\", \"shop-owner\", \"towing-company\", \"homegarage\", \"owner\"]\n        && event.decision in [\"VERIFIED\", \"REJECTED\"]\n        && event.reviewedAt == request.time\n        && event.reviewedBy == request.auth.uid\n        && ((event.role == \"owner\"\n            && existsAfter(/databases/$(database)/documents/users/$(event.providerId)/ownerProfile/profile)\n            && getAfter(/databases/$(database)/documents/users/$(event.providerId)/ownerProfile/profile).data.verificationStatus == event.decision\n            && getAfter(/databases/$(database)/documents/users/$(event.providerId)/ownerProfile/profile).data.reviewedAt == request.time\n            && getAfter(/databases/$(database)/documents/users/$(event.providerId)/ownerProfile/profile).data.reviewedBy == request.auth.uid)\n          || (event.role == \"onsite-mechanic\"\n            && existsAfter(/databases/$(database)/documents/users/$(event.providerId)/providerProfile/profile)\n            && getAfter(/databases/$(database)/documents/users/$(event.providerId)/providerProfile/profile).data.verificationStatus == event.decision\n            && getAfter(/databases/$(database)/documents/users/$(event.providerId)/providerProfile/profile).data.reviewedAt == request.time\n            && getAfter(/databases/$(database)/documents/users/$(event.providerId)/providerProfile/profile).data.reviewedBy == request.auth.uid)\n          || (event.role == \"towing-company\"\n            && existsAfter(/databases/$(database)/documents/users/$(event.providerId)/towingCompanyProfile/profile)\n            && getAfter(/databases/$(database)/documents/users/$(event.providerId)/towingCompanyProfile/profile).data.verificationStatus == event.decision\n            && getAfter(/databases/$(database)/documents/users/$(event.providerId)/towingCompanyProfile/profile).data.reviewedAt == request.time\n            && getAfter(/databases/$(database)/documents/users/$(event.providerId)/towingCompanyProfile/profile).data.reviewedBy == request.auth.uid)\n          || (event.role == \"shop-owner\"\n            && existsAfter(/databases/$(database)/documents/providers/$(event.providerId))\n            && getAfter(/databases/$(database)/documents/providers/$(event.providerId)).data.verificationStatus == event.decision\n            && getAfter(/databases/$(database)/documents/providers/$(event.providerId)).data.reviewedAt == request.time\n            && getAfter(/databases/$(database)/documents/providers/$(event.providerId)).data.reviewedBy == request.auth.uid)\n          || (event.role == \"homegarage\"\n            && existsAfter(/databases/$(database)/documents/users/$(event.providerId)/homeGarageVerification/profile)\n            && getAfter(/databases/$(database)/documents/users/$(event.providerId)/homeGarageVerification/profile).data.verificationStatus == event.decision\n            && getAfter(/databases/$(database)/documents/users/$(event.providerId)/homeGarageVerification/profile).data.reviewedAt == request.time\n            && getAfter(/databases/$(database)/documents/users/$(event.providerId)/homeGarageVerification/profile).data.reviewedBy == request.auth.uid));\n    }\n\n    function validAdminAccountStatusNotification(uid, notificationId) {\n      let event = request.resource.data;\n      let userPath = /databases/$(database)/documents/users/$(uid);\n      return isAdmin()\n        && event.keys().hasOnly([\n          \"notificationId\", \"providerId\", \"providerRole\", \"status\", \"previousStatus\", \"title\", \"message\", \"reason\",\n          \"isRead\", \"readAt\", \"createdAt\", \"updatedAt\"\n        ])\n        && event.notificationId == notificationId\n        && event.providerId == uid\n        && event.providerRole in [\"onsite-mechanic\", \"shop-owner\", \"towing-company\", \"homegarage\", \"owner\"]\n        && event.status in [\"SUSPENDED\", \"ACTIVE\"]\n        && (!event.keys().hasAny([\"previousStatus\"])\n          || event.previousStatus == null\n          || (event.previousStatus is string && event.previousStatus.size() <= 20))\n        && event.title is string && event.message is string\n        && (event.reason == null || (event.reason is string && event.reason.size() <= 500))\n        && event.isRead == false && event.readAt == null\n        && event.createdAt == request.time && event.updatedAt == request.time\n        && get(userPath).data.role == event.providerRole\n        && get(userPath).data.get(\"accountStatus\", \"active\") != (event.status == \"SUSPENDED\" ? \"suspended\" : \"active\")\n        && getAfter(userPath).data.role == event.providerRole\n        && getAfter(userPath).data.accountStatus == (event.status == \"SUSPENDED\" ? \"suspended\" : \"active\")\n        && getAfter(userPath).data.accountStatusUpdatedAt == request.time\n        && getAfter(userPath).data.accountStatusUpdatedBy == request.auth.uid\n        && getAfter(userPath).data.accountStatusNotificationId == notificationId;\n    }\n\n    function validAdminVerificationNotification(uid, notificationId) {\n      let event = request.resource.data;\n      let profilePath = event.providerRole == \"owner\"\n        ? /databases/$(database)/documents/users/$(uid)/ownerProfile/profile\n        : event.providerRole == \"onsite-mechanic\"\n          ? /databases/$(database)/documents/users/$(uid)/providerProfile/profile\n          : event.providerRole == \"towing-company\"\n            ? /databases/$(database)/documents/users/$(uid)/towingCompanyProfile/profile\n            : event.providerRole == \"homegarage\"\n              ? /databases/$(database)/documents/users/$(uid)/homeGarageVerification/profile\n              : /databases/$(database)/documents/providers/$(uid);\n      let beforeProfile = get(profilePath).data;\n      let afterProfile = getAfter(profilePath).data;\n      return isAdmin()\n        && event.keys().hasOnly([\n          \"notificationId\", \"providerId\", \"providerRole\", \"status\", \"previousStatus\", \"title\", \"message\", \"reason\",\n          \"isRead\", \"readAt\", \"createdAt\", \"updatedAt\"\n        ])\n        && event.notificationId == notificationId\n        && event.providerId == uid\n        && event.providerRole in [\"onsite-mechanic\", \"shop-owner\", \"towing-company\", \"homegarage\", \"owner\"]\n        && event.status in [\"VERIFIED\", \"REJECTED\"]\n        && (!event.keys().hasAny([\"previousStatus\"])\n          || event.previousStatus == null\n          || (event.previousStatus is string && event.previousStatus.size() <= 20))\n        && event.title is string && event.message is string\n        && (event.reason == null || (event.reason is string && event.reason.size() <= 500))\n        && event.isRead == false && event.readAt == null\n        && event.createdAt == request.time && event.updatedAt == request.time\n        && beforeProfile.get(\"verificationStatus\", \"\") != event.status\n        && afterProfile.verificationStatus == event.status\n        && afterProfile.reviewedBy == request.auth.uid\n        && afterProfile.reviewedAt == request.time\n        && afterProfile.lastStatusNotificationId == notificationId;\n    }\n\n    function isPendingVerificationSubmission() {\n      return request.resource.data.verificationStatus == \"PENDING\";\n    }\n\n    function validAdminReview(uid, role, shop) {\n      let before = resource.data;\n      let after = request.resource.data;\n      let notificationPath = /databases/$(database)/documents/users/$(uid)/accountStatusNotifications/$(after.lastStatusNotificationId);\n      return isAdmin()\n        && before.uid == uid && before.role == role\n        && get(/databases/$(database)/documents/users/$(uid)).data.role == role\n        && (before.get(\"verificationStatus\", \"\") == \"PENDING\"\n          || (shop && !(\"verificationStatus\" in before) && before.verified == false))\n        && (!shop || before.verified == false)\n        && after.diff(before).affectedKeys().hasOnly(shop\n          ? [\"verificationStatus\", \"reviewedAt\", \"reviewedBy\", \"rejectionReason\", \"verified\", \"lastStatusNotificationId\",\n            \"businessName\", \"phone\", \"address\", \"latitude\", \"longitude\"]\n          : [\"verificationStatus\", \"reviewedAt\", \"reviewedBy\", \"rejectionReason\", \"verified\", \"lastStatusNotificationId\"])\n        && (shop || !after.diff(before).affectedKeys().hasAny([\"verified\"]))\n        && after.verificationStatus in [\"VERIFIED\", \"REJECTED\"]\n        && after.reviewedAt == request.time && after.reviewedBy == request.auth.uid\n        && after.lastStatusNotificationId is string\n        && existsAfter(notificationPath)\n        && getAfter(notificationPath).data.status == after.verificationStatus\n        && getAfter(notificationPath).data.providerId == uid\n        && getAfter(notificationPath).data.providerRole == role\n        && ((after.verificationStatus == \"VERIFIED\" && after.rejectionReason == \"\")\n          || (after.verificationStatus == \"REJECTED\" && after.rejectionReason is string && after.rejectionReason.size() >= 5 && after.rejectionReason.size() <= 500))\n        && (!shop || after.verified == (after.verificationStatus == \"VERIFIED\"))\n        && listingHiddenAfterReview(uid);\n    }\n\n    function validAdminAccountStatus(uid) {\n      let before = resource.data;\n      let after = request.resource.data;\n      let notificationPath = /databases/$(database)/documents/users/$(uid)/accountStatusNotifications/$(after.accountStatusNotificationId);\n      return isAdmin()\n        && before.uid == uid\n        && before.role in [\"onsite-mechanic\", \"shop-owner\", \"towing-company\", \"homegarage\", \"owner\"]\n        && after.role == before.role && after.uid == before.uid\n        && after.diff(before).affectedKeys().hasOnly([\"accountStatus\", \"accountStatusUpdatedAt\", \"accountStatusUpdatedBy\", \"accountStatusNotificationId\"])\n        && after.accountStatus in [\"active\", \"suspended\"]\n        && after.accountStatus != before.get(\"accountStatus\", \"active\")\n        && after.accountStatusUpdatedAt == request.time\n        && after.accountStatusUpdatedBy == request.auth.uid\n        && after.accountStatusNotificationId is string\n        && existsAfter(notificationPath)\n        && getAfter(notificationPath).data.status == (after.accountStatus == \"suspended\" ? \"SUSPENDED\" : \"ACTIVE\")\n        && getAfter(notificationPath).data.providerId == uid\n        && getAfter(notificationPath).data.providerRole == before.role;\n    }\n\n    function verifiedMechanic(uid) {\n      let profilePath = /databases/$(database)/documents/users/$(uid)/providerProfile/profile;\n      return exists(profilePath)\n        && get(profilePath).data.uid == request.auth.uid\n        && get(profilePath).data.role == \"onsite-mechanic\"\n        && get(profilePath).data.verificationStatus == \"VERIFIED\";\n    }\n\n    function verifiedTowingCompany(uid) {\n      let profilePath = /databases/$(database)/documents/users/$(uid)/towingCompanyProfile/profile;\n      return exists(profilePath)\n        && get(profilePath).data.uid == request.auth.uid\n        && get(profilePath).data.role == \"towing-company\"\n        && get(profilePath).data.verificationStatus == \"VERIFIED\";\n    }\n\n    function verifiedHomeGarage(uid) {\n      let profilePath = /databases/$(database)/documents/users/$(uid)/homeGarageVerification/profile;\n      return exists(profilePath)\n        && get(profilePath).data.uid == request.auth.uid\n        && get(profilePath).data.role == \"homegarage\"\n        && get(profilePath).data.verificationStatus == \"VERIFIED\";\n    }\n\n    function approvedHomeGarage(uid) {\n      let profilePath = /databases/$(database)/documents/users/$(uid)/homeGarageVerification/profile;\n      return exists(profilePath)\n        && get(profilePath).data.uid == uid\n        && get(profilePath).data.role == \"homegarage\"\n        && get(profilePath).data.verificationStatus == \"VERIFIED\";\n    }\n\n    function hasExactPublicListingShape() {\n      return request.resource.data.keys().hasOnly([\n          \"providerId\", \"role\", \"category\", \"businessName\", \"location\",\n          \"availability\", \"visibility\", \"ratingSummary\", \"services\",\n          \"vehicleTypes\", \"serviceAreaLabel\", \"description\", \"startingPrice\", \"operatingHours\",\n          \"emergencyServiceAvailable\", \"acceptsScheduledBookings\", \"photoUrls\", \"hoursType\", \"is24Hours\", \"weeklyHours\", \"totalSlots\", \"availableSlots\", \"contactPhone\"\n        ])\n        && request.resource.data.location.keys().hasOnly([\"latitude\", \"longitude\"])\n        && request.resource.data.ratingSummary.keys().hasOnly([\"average\", \"count\"]);\n    