t.resource.data.providerId == request.auth.uid\n        && request.resource.data.bookingId is string\n        && request.resource.data.scheduledAt is timestamp\n        && request.resource.data.createdAt == request.time\n        && reservationId == request.auth.uid + \"_\" + string(request.resource.data.scheduledAt.toMillis())\n        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.providerId == request.auth.uid\n        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.timingMode == \"scheduled\"\n        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.scheduledAt == request.resource.data.scheduledAt\n        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.status == \"accepted\";\n      allow update: if false;\n      allow delete: if signedIn()\n        && resource.data.bookingId is string\n        && getAfter(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.customerId == request.auth.uid\n        && getAfter(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.status == \"cancelled\";\n    }\n\n    match /bookings/{bookingId} {\n      function providerTransitionAllowed() {\n        return resource.data.bookingType == \"shop-owner\"\n          ? validShopBookingTransition(bookingId)\n          : resource.data.bookingType == \"homegarage\"\n            ? validHomeGarageBookingTransition(bookingId)\n            : resource.data.bookingType in [\"onsite-mechanic\", \"towing-company\"]\n              && validProviderBookingTransition(bookingId);\n      }\n\n      function completionNoteWriteIsValid() {\n        let noteChanged = request.resource.data.diff(resource.data).affectedKeys().hasAny([\"completionNote\"]);\n        return !noteChanged || (resource.data.status != \"completed\"\n          && request.resource.data.status == \"complete