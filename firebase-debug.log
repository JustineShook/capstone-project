ategory == \"Auto Shops\"\n        && resource.data.visibility == \"active\"\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"availability\"])\n        && request.resource.data.availability in [\"available\", \"offline\"]\n        && validShopListingProfile(uid);\n    }\n\n    function validMechanicAvailabilitySync(uid) {\n      return signedIn()\n        && request.auth.uid == uid\n        && verifiedMechanic(uid)\n        && resource.data.providerId == uid\n        && resource.data.role == \"onsite-mechanic\"\n        && resource.data.category == \"Onsite Mechanics\"\n        && resource.data.visibility == \"active\"\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"availability\"])\n        && request.resource.data.availability in [\"available\", \"offline\"];\n    }\n\n    function validProviderListingUpdate(uid) {\n      let role = resource.data.role;\n      let changed = request.resource.data.diff(resource.data).affectedKeys();\n      return role == \"shop-owner\"\n        ? (changed.hasOnly([\"availability\"])\n          ? validShopAvailabilitySync(uid)\n          : (validShopPublicListingUpdate(uid)\n            && changed.hasOnly([\n              \"businessName\", \"location\", \"availability\", \"serviceAreaLabel\", \"description\", \"contactPhone\",\n              \"services\", \"vehicleTypes\", \"operatingHours\", \"startingPrice\",\n              \"emergencyServiceAvailable\", \"acceptsScheduledBookings\", \"photoUrls\", \"hoursType\", \"is24Hours\", \"weeklyHours\", \"visibility\"\n            ])))\n        : role == \"onsite-mechanic\"\n          ? (changed.hasOnly([\"availability\"])\n            ? validMechanicAvailabilitySync(uid)\n            : (validPublicListingWrite(uid)\n              && (!changed.hasAny([\"visibility\"]) || accountIsActive(uid))\n              && changed.hasOnly([\n                \"businessName\", \"location\", \"availability\", \"serviceAreaLabel\", \"description\