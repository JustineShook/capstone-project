me.size() > 0\n        && request.resource.data.representative.fullName.size() <= 120\n        && request.resource.data.updatedAt == request.time;\n    }\n\n    function validHomeGarageListingProfile(uid) {\n      let verification = get(/databases/$(database)/documents/users/$(uid)/homeGarageVerification/profile).data;\n      return verification.business.name is string\n        && verification.business.name.size() > 0;\n    }\n\n    function validShopVehicle() {\n      let vehicle = get(/databases/$(database)/documents/users/$(request.auth.uid)/vehicles/$(request.resource.data.vehicleId)).data;\n      return request.resource.data.vehicle == vehicle.make + \" \" + vehicle.model\n        && request.resource.data.vehicleYear == vehicle.year\n        && request.resource.data.vehiclePlate == vehicle.plateNumber;\n    }\n\n    function validShopBookingListing() {\n      let listing = get(/databases/$(database)/documents/providerListings/$(request.resource.data.providerId)).data;\n      return validBookingProvider()\n        && listing.category == \"Auto Shops\"\n        && listing.emergencyServiceAvailable == true\n        && request.resource.data.shopLatitude == listing.location.latitude\n        && request.resource.data.shopLongitude == listing.location.longitude\n        && request.resource.data.shopAreaLabel == listing.serviceAreaLabel;\n    }\n\n    function isOpenShop(uid) {\n      let shop = get(/databases/$(database)/documents/providers/$(uid)).data;\n      return isShopOwner(uid)\n        && shop.uid == uid\n        && shop.role == \"shop-owner\"\n        && shop.status == \"open\"\n        && shop.businessName is string && shop.businessName.size() > 0\n        && shop.phone is string && shop.phone.size() > 0\n        && shop.address is string && shop.address.size() > 0\n        && shop.latitude is number && shop.latitude >= -90 && shop.latitude <= 90\n        && shop.longitude is number && shop.longitude >= -180 && shop.longitude <= 180\n        && !(shop.latitu