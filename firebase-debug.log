\"shop-owner\";\n    }\n\n    function verifiedShop(uid) {\n      let shop = get(/databases/$(database)/documents/providers/$(uid)).data;\n      return isShopOwner(uid) && shop.uid == uid && shop.role == \"shop-owner\" && shop.verified == true;\n    }\n\n    // The administrator's approval remains on the private verification\n    // document. This narrowly permits its owner to copy the exact approved\n    // business fields to the pre-existing providers/{uid} dashboard profile.\n    function approvedShopVerification(uid) {\n      let verificationPath = /databases/$(database)/documents/users/$(uid)/shopVerification/profile;\n      return exists(verificationPath)\n        && get(verificationPath).data.uid == uid\n        && get(verificationPath).data.role == \"shop-owner\"\n        && get(verificationPath).data.verificationStatus == \"VERIFIED\";\n    }\n\n    function validApprovedShopProfileSync(uid) {\n      let verification = get(/databases/$(database)/documents/users/$(uid)/shopVerification/profile).data;\n      return approvedShopVerification(uid)\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n          \"businessName\", \"phone\", \"address\", \"latitude\", \"longitude\", \"verified\"\n        ])\n        && request.resource.data.verified == true\n        && request.resource.data.businessName == verification.business.name\n        && request.resource.data.phone == verification.business.phone\n        && request.resource.data.address == verification.business.address\n        && request.resource.data.latitude == verification.business.latitude\n        && request.resource.data.longitude == verification.business.longitude;\n    }\n\n    function validShopListingProfile(uid) {\n      // The public map pin can differ from the approved business address.\n      // Ownership, verification, availability, and coordinate bounds are\n      // validated separately; never write the private provider profile here.\n      let shop = get(/database