"phone\", \"address\", \"latitude\", \"longitude\", \"verified\"\n        ])\n        && request.resource.data.verified == true\n        && request.resource.data.businessName == verification.business.name\n        && request.resource.data.phone == verification.business.phone\n        && request.resource.data.address == verification.business.address\n        && request.resource.data.latitude == verification.business.latitude\n        && request.resource.data.longitude == verification.business.longitude;\n    }\n\n    function validShopListingProfile(uid) {\n      // The public map pin can differ from the approved business address.\n      // Ownership, verification, availability, and coordinate bounds are\n      // validated separately; never write the private provider profile here.\n      let shop = getAfter(/databases/$(database)/documents/providers/$(uid)).data;\n      return request.resource.data.emergencyServiceAvailable == true\n        && ((shop.status == \"open\" && request.resource.data.availability == \"available\")\n          || (shop.status == \"closed\" && request.resource.data.availability == \"offline\"));\n    }\n\n    // Existing shop listings may have a non-zero rating summary maintained\n    // by the review workflow. Provider edits must preserve system-owned fields\n    // while still validating all provider-controlled values and shop bindings.\n    function validShopPublicListingUpdate(uid) {\n      let before = resource.data;\n      let after = request.resource.data;\n      return before.providerId == uid\n        && before.role == \"shop-owner\"\n        && before.category == \"Auto Shops\"\n        // The caller's changed-field allowlist below already prevents edits\n        // to providerId, role, category, and ratingSummary.\n        && (after.visibility == before.visibility\n          || (after.visibility == \"active\" && accountIsActive(uid)))\n        && after.location is map\n        && after.location.keys().hasOnly([\"latitude\", \"longitude\"])\n        && hasValidProviderControlledFields()\n        && hasValidRoleSpecificServices()\n        && verifiedShop(uid)\n        && validShopListingProfile(uid);\n    }\n\n    // Availability toggles only change one public field. Keep this narrowly\n    // authorized so older approved listings do not need to pass the full\n    // listing creation schema just to sync open/closed state.\n    function validShopAvailabilitySync(uid) {\n      return verifiedShop(uid)\n        && resource.data.providerId == uid\n        && resource.data.role == \"shop-owner\"\n        && resource.data.category == \"Auto Shops\"\n        && resource.data.visibility == \"active\"\n        && accountIsActive(uid)\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"availability\"])\n        && request.resource.data.availability in [\"available\", \"offline\"]\n        && validShopListingProfile(uid);\n    }\n\n    function validMechanicAvailabilitySync(uid) {\n      return accountIsActive(uid)\n        && verifiedMechanic(uid)\n        && resource.data.providerId == uid\n        && resource.data.role == \"onsite-mechanic\"\n        && resource.data.category == \"Onsite Mechanics\"\n        && resource.data.visibility == \"active\"\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"availability\"])\n        && request.resource.data.availability in [\"available\", \"offline\"];\n    }\n\n    function validHomeGarageAvailabilitySync(uid) {\n      return accountIsActive(uid)\n        && get(/databases/$(database)/documents/users/$(uid)).data.role == \"homegarage\"\n        && verifiedHomeGarage(uid)\n        && validHomeGarageListingProfile(uid)\n        && resource.data.providerId == uid\n        && resource.data.role == \"homegarage\"\n        && resource.data.category == \"Parking Lots\"\n        && resource.data.visibility == \"active\"\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"availability