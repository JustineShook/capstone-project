tatus == \"rejected\"\n                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"updatedAt\", \"declineReason\", \"riskEventType\", \"riskEventAt\"])\n                  && optionalBookingReasonIsValid(request.resource.data, \"declineReason\"))\n                || (resource.data.bookingType in [\"shop-owner\", \"homegarage\"]\n                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"updatedAt\", \"finalPrice\", \"completedAt\", \"completionNote\"])))\n              && request.resource.data.updatedAt == request.time\n              && providerTransitionAllowed()\n              && completionNoteWriteIsValid()));\n      }\n\n      function customerCancellationAllowed() {\n        return resource.data.customerId == request.auth.uid\n          && resource.data.bookingType in [\"onsite-mechanic\", \"towing-company\", \"homegarage\", \"shop-owner\"]\n          && resource.data.status in [\"pending\", \"accepted\"]\n          && request.resource.data.status == \"cancelled\"\n          && optionalRiskEventIsValid(\"owner_cancel_after_acceptance\", \"accepted\")\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"updatedAt\", \"cancellationReason\", \"riskEventType\", \"riskEventAt\"])\n          && optionalBookingReasonIsValid(request.resource.data, \"cancellationReason\")\n          && request.resource.data.updatedAt == request.time\n          && reservationReleasedFor(resource.data);\n      }\n\n      allow get, list: if isAdmin();\n      allow create: if accountIsActive(request.auth.uid)\n        && accountIsActive(request.resource.data.providerId)\n        && (request.resource.data.bookingType == \"homegarage\"\n        ? (validHomeGarageBooking() && validHomeGarageBookingLock(bookingId))\n        : request.resource.data.bookingType == \"towing-company\"\n          ? (validBookingBase() && validTowingBookingProvider())\n          : (validBookingBase()\n            && ((validShopBooking() && validShopBookingLock(bookingId))\n              || (validBookingProvider() && validMechanicBooking()))));\n      allow get, list: if signedIn()\n        && (resource.data.customerId == request.auth.uid\n          || resource.data.providerId == request.auth.uid);\n      allow update: if signedIn() && (providerUpdateAllowed() || customerCancellationAllowed());\n      allow delete: if false;\n    }\n\n    match /providerReviews/{reviewId} {\n      allow get, list: if signedIn();\n      allow create: if validProviderReview(reviewId) || validParkingProviderReview(reviewId);\n      allow update, delete: if false;\n    }\n\n    // Staff requests record manual review only; they never grant an Auth admin claim.\n    // Complaint reports are private to their reporter and admins. Each\n    // booking/party pair has one deterministic ID; report writes never touch bookings.\n    match /complaints/{reportId} {\n      function reportBooking() {\n        return get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data;\n      }\n      function validComplaintCreate() {\n        let data = request.resource.data;\n        let booking = reportBooking();\n        let ownerReport = data.reporterType == \"Vehicle Owner\" && booking.customerId == request.auth.uid\n          && data.reportedUserId == booking.providerId;\n        let providerReport = data.reporterType == \"Provider\" && booking.providerId == request.auth.uid\n          && data.reportedUserId == booking.customerId;\n        let active = booking.status in [\"accepted\", \"en_route\", \"arrived\", \"in_progress\", \"vehicle_arrived\", \"diagnosing\", \"repairing\"];\n        let recentCompletion = booking.status == \"completed\" && booking.completedAt is timestamp\n          && booking.completedAt <= request.time\n          && booking.completedAt >= request.time - duration.value(7, \"d\");\n        return signedIn()\n          && data.keys().hasOnly([\"b