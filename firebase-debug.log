alDistanceKm * booking.pricePerKm + 0.01\n            && booking.estimatedTotalPrice is number\n            && booking.estimatedTotalPrice >= booking.basePrice + booking.distanceCharge - 0.01\n            && booking.estimatedTotalPrice <= booking.basePrice + booking.distanceCharge + 0.01)\n          || (pricing.pricingMode == \"dispatcher\"\n            && booking.pricingMode == \"dispatcher\"\n            && booking.dispatcherPhone == pricing.dispatcherPhone\n            && booking.dispatcherPhone.size() > 0\n            && booking.basePrice == 0\n            && booking.pricePerKm == 0\n            && booking.distanceCharge == 0\n            && booking.estimatedTotalPrice == 0)\n        )\n        && booking.pickupLocation is string\n        && booking.pickupLocation.size() > 0\n        && booking.pickupLocation.size() <= 300\n        && booking.destination is string\n        && booking.destination.size() > 0\n        && booking.destination.size() <= 300\n        && booking.towingType in [\"Flatbed Towing\", \"Wheel-Lift Towing\", \"Motorcycle Towing\", \"Emergency Towing\"]\n        && booking.vehicleCondition in [\"Vehicle can move\", \"Vehicle cannot move\", \"Vehicle badly damaged\", \"Accident vehicle\"];\n    }\n\n    function validTowingPricingShape() {\n      return request.resource.data.keys().hasOnly([\n          \"basePrice\", \"pricePerKm\", \"pricingMode\", \"dispatcherPhone\", \"createdAt\", \"updatedAt\"\n        ])\n        && request.resource.data.basePrice is number\n        && request.resource.data.basePrice >= 0\n        && request.resource.data.basePrice <= 1000000\n        && request.resource.data.pricePerKm is number\n        && request.resource.data.pricePerKm >= 0\n        && request.resource.data.pricePerKm <= 100000\n        && request.resource.data.pricingMode in [\"fixed\", \"dispatcher\"]\n        && request.resource.data.dispatcherPhone is string\n        && request.resource.data.dispatcherPhone.size() <= 50\n        && (request.resource.data.pricingMode == \"fixed\" || request.resource.data.dispatcherPhone.size() > 0);\n    }\n\n    function validVehicleShape(vehicleId) {\n      return request.resource.data.keys().hasOnly([\n          \"vehicleId\", \"type\", \"make\", \"model\", \"year\", \"color\",\n          \"plateNumber\", \"createdAt\", \"updatedAt\"\n        ])\n        && request.resource.data.vehicleId == vehicleId\n        && request.resource.data.type in [\"Car\", \"SUV\", \"Pickup Truck\", \"Van\", \"Motorcycle\", \"Truck\"]\n        && request.resource.data.make is string\n        && request.resource.data.make.size() > 0\n        && request.resource.data.make.size() <= 60\n        && request.resource.data.model is string\n        && request.resource.data.model.size() > 0\n        && request.resource.data.model.size() <= 60\n        && request.resource.data.year is int\n        && request.resource.data.year >= 1900\n        && request.resource.data.year <= 2100\n        && request.resource.data.color is string\n        && request.resource.data.color.size() > 0\n        && request.resource.data.color.size() <= 40\n        && request.resource.data.plateNumber is string\n        && request.resource.data.plateNumber.size() > 0\n        && request.resource.data.plateNumber.size() <= 20;\n    }\n\n    function validProviderBookingTransition(bookingId) {\n      let before = resource.data.status;\n      let after = request.resource.data.status;\n      return (before == \"pending\" && after == \"rejected\"\n          && optionalRiskEventIsValid(\"provider_decline\", \"pending\")\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"updatedAt\", \"declineReason\", \"riskEventType\", \"riskEventAt\"])\n          && optionalBookingReasonIsValid(request.resource.data, \"declineReason\"))\n        || (before == \"pending\" && after in [\"accepted\", \"cancelled\"]\n          && (after != \"accepted\" || reservationClaimedFor(bookingId, resource.data)))\n        || (before == \"accepted\" && after in [\"en_route\", \"cancelled\"])\n        || (before == \"en_route\" && after in [\"arrived\", \"cancelled\"])\n        || (before == \"arrived\" && after == \"in_progress\")\n        || (before == \"in_progress\" && after == \"completed\"\n          && request.resource.data.finalPrice is number\n          && request.resource.data.finalPrice >= 0\n          && request.resource.data.finalPrice <= 100000000\n          && request.resource.data.finalPrice * 100 % 1 == 0\n          && request.resource.data.completedAt == request.time\n          && request.resource.data.diff(resource.data).affectedKeys().hasAll([\"status\", \"updatedAt\", \"finalPrice\", \"completedAt\"]));\n    }\n\n    function validMechanicLocationUpdate() {\n      return resource.data.bookingType == \"onsite-mechanic\"\n        && resource.data.status in [\"accepted\", \"en_route\", \"arrived\", \"in_progress\"]\n        && request.resource.data.mechanicLatitude is number\n        && request.resource.data.mechanicLatitude >= -90\n        && request.resource.data.mechanicLatitude <= 90\n        && request.resource.data.mechanicLongitude is number\n        && request.resource.data.mechanicLongitude >= -180\n        && request.resource.data.mechanicLongitude <= 180\n        && request.resource.data.mechanicLocationUpdatedAt == request.time;\n    }\n\n    function validProviderReview(reviewId) {\n      let bookingPath = /databases/$(database)/documents/bookings/$(reviewId);\n      let booking = get(bookingPath).data;\n      return signedIn()\n        && exists(bookingPath)\n        && request.resource.data.keys().hasOnly([\n          \"bookingId\", \"customerId\", \"providerId\", \"providerRole\", \"rating\",\n          \"comment\", \"createdAt\", \"updatedAt\"\n        ])\n        && request.resource.data.bookingId == reviewId\n        && request.resource.data.customerId == request.auth.uid\n        && booking.customerId == request.auth.uid\n        && booking.status == \"completed\"\n        && request.resource.data.providerId == booking.providerId\n        && request.resource.data.providerId != request.auth.uid\n        && request.resource.data.providerRole == booking.bookingType\n        && request.resource.data.providerRole in [\"onsite-mechanic\", \"towing-company\", \"shop-owner\", \"homegarage\"]\n        && request.resource.data.rating is int\n        && request.resource.data.rating >= 1\n        && request.resource.data.rating <= 5\n        && request.resource.data.comment is string\n        && request.resource.data.comment.size() <= 1000\n        && request.resource.data.createdAt == request.time\n        && request.resource.data.updatedAt == request.time;\n    }\n\n    function validParkingProviderReview(reviewId) {\n      let bookingPath = /databases/$(database)/documents/parkingBookings/$(reviewId);\n      let booking = get(bookingPath).data;\n      return signedIn()\n        && exists(bookingPath)\n        && request.resource.data.keys().hasOnly([\n          \"bookingId\", \"customerId\", \"providerId\", \"providerRole\", \"rating\",\n          \"comment\", \"createdAt\", \"updatedAt\"\n        ])\n        && request.resource.data.bookingId == reviewId\n        && request.resource.data.customerId == request.auth.uid\n        && booking.customerId == request.auth.uid\n        && booking.status == \"completed\"\n        && request.resource.data.providerId == booking.providerId\n        && request.resource.data.providerId != request.auth.uid\n        && request.resource.data.providerRole == \"homegarage\"\n        && request.resource.data.rating is int\n        && request.resource.data.rating >= 1\n        && request.resource.data.rating <= 5\n        && request.resource.data.comment is string\n        && request.resource.data.comment.size() <= 1000\n        && request.resource.data.createdAt == request.time\n        && request.resource.data.updatedAt == request.time;\n    }\n\n    // General account data remains