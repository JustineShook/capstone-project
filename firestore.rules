        && notificationId == request.resource.data.bookingId
        && request.resource.data.providerId == uid
        && request.resource.data.customerId == booking.customerId
        && request.resource.data.customerName == booking.customerName
        && request.resource.data.vehicle == booking.vehicle
        && request.resource.data.problem == booking.problem
        && (request.resource.data.status == booking.status
          || (request.resource.data.status == "assessed" && booking.status == "accepted" && booking.assessmentPrice is number))
        && booking.providerId == uid && booking.bookingType == "homegarage"
        && request.resource.data.title is string && request.resource.data.title.size() <= 100
        && request.resource.data.message is string && request.resource.data.message.size() <= 300
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && existsAfter(bookingPath)
        && ((request.auth.uid == booking.customerId && !exists(bookingPath)
            && booking.status == "pending" && request.resource.data.title == "New Home Garage request"
            && request.resource.data.isRead == false && request.resource.data.readAt == null)
          || (request.auth.uid == uid && exists(bookingPath)
            && get(bookingPath).data.status == booking.status
            && get(bookingPath).data.status == "accepted"
            && request.resource.data.status == "assessed"
            && booking.assessmentPrice is number
            && request.resource.data.title == "Request updated"
            && request.resource.data.isRead == true && request.resource.data.readAt == request.time)
          || (request.auth.uid == uid && exists(bookingPath)
            && get(bookingPath).data.status != booking.status
            && request.resource.data.title == "Request updated"
            && request.resource.data.isRead == true && request.resource.data.readAt == request.time)
          || (request.auth.uid == booking.customerId && exists(bookingPath)
            && get(bookingPath).data.status in ["pending", "accepted"] && booking.status == "cancelled"
            && request.resource.data.title == "Customer cancelled request"
            && request.resource.data.isRead == false && request.resource.data.readAt == null));
    }

    function validHomeGarageNotificationUpdate(uid, notificationId) {
      let bookingPath = /databases/$(database)/documents/bookings/$(request.resource.data.bookingId);
      let before = get(bookingPath).data;
      let after = getAfter(bookingPath).data;
      return signedIn() && resource.data.providerId == uid
        && request.resource.data.providerId == uid
        && notificationId == request.resource.data.bookingId
        && request.resource.data.bookingId == resource.data.bookingId
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.customerName == resource.data.customerName
        && request.resource.data.vehicle == resource.data.vehicle
        && request.resource.data.problem == resource.data.problem
        && (request.resource.data.status == after.status
          || (request.resource.data.status == "assessed" && after.status == "accepted" && after.assessmentPrice is number))
        && after.providerId == uid && after.bookingType == "homegarage"
        && request.resource.data.title is string && request.resource.data.title.size() <= 100
        && request.resource.data.message is string && request.resource.data.message.size() <= 300
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "title", "message", "isRead", "readAt", "createdAt", "updatedAt"])
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && ((request.auth.uid == uid && after.status == before.status
            && after.status == "accepted" && request.resource.data.status == "assessed"
            && after.assessmentPrice is number && request.resource.data.isRead == true
            && request.resource.data.readAt == request.time && request.resource.data.title == "Request updated")
          || (request.auth.uid == uid && after.status != before.status
            && request.resource.data.isRead == true && request.resource.data.readAt == request.time
            && request.resource.data.title == "Request updated")
          || (request.auth.uid == resource.data.customerId && before.status in ["pending", "accepted"]
            && after.status == "cancelled" && request.resource.data.isRead == false
            && request.resource.data.readAt == null && request.resource.data.title == "Customer cancelled request"));
    }

    function validShopNotificationUpdate(uid, notificationId) {
      let bookingPath = /databases/$(database)/documents/bookings/$(request.resource.data.bookingId);
      let before = get(bookingPath).data;
      let after = getAfter(bookingPath).data;
      return signedIn()
        && resource.data.bookingId == request.resource.data.bookingId
        && notificationId == request.resource.data.bookingId
        && resource.data.providerId == uid
        && request.resource.data.providerId == uid
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.customerName == resource.data.customerName
        && request.resource.data.vehicle == resource.data.vehicle
        && request.resource.data.problem == resource.data.problem
        && request.resource.data.status == after.status
        && after.providerId == uid
        && after.bookingType == "shop-owner"
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 300
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "title", "message", "isRead", "readAt", "createdAt", "updatedAt"
        ])
        && before.customerId == resource.data.customerId
        && before.providerId == uid
        && before.status != after.status
        && after.customerId == resource.data.customerId
        && request.auth.uid == uid
        && request.resource.data.isRead == true
        && request.resource.data.readAt == request.time
        && request.resource.data.title == "Request status updated";
    }

    function validMechanicBooking() {
      return request.resource.data.keys().hasOnly([
          "bookingType", "customerId", "customerName", "customerEmail", "customerPhone", "customerAddress",
          "providerId", "providerName", "providerPhone", "vehicleId", "vehicle", "vehicleYear",
          "vehiclePlate", "latitude", "longitude", "problem", "notes", "startingPrice", "status",
          "createdAt", "updatedAt", "timingMode", "urgency", "scheduledAt"
        ])
        && request.resource.data.bookingType == "onsite-mechanic"
        && request.resource.data.providerPhone is string
        && request.resource.data.providerPhone.size() <= 30
        && request.resource.data.providerPhone == get(/databases/$(database)/documents/providerListings/$(request.resource.data.providerId)).data.get("contactPhone", "")
        && request.resource.data.problem is string
        && request.resource.data.problem.size() > 0
        && request.resource.data.problem.size() <= 300;
    }

    // Shop approval is administrator-controlled on the existing providers profile.
    function isShopOwner(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role == "shop-owner";
    }

    function verifiedShop(uid) {
      let shop = getAfter(/databases/$(database)/documents/providers/$(uid)).data;
      return isShopOwner(uid) && shop.uid == uid && shop.role == "shop-owner" && shop.verified == true;
    }

    // The administrator's approval remains on the private verification
    // document. This narrowly permits its owner to copy the exact approved
    // business fields to the pre-existing providers/{uid} dashboard profile.
    function approvedShopVerification(uid) {
      let verificationPath = /databases/$(database)/documents/users/$(uid)/shopVerification/profile;
      return exists(verificationPath)
        && get(verificationPath).data.uid == uid
        && get(verificationPath).data.role == "shop-owner"
        && get(verificationPath).data.verificationStatus == "VERIFIED";
    }

    function validApprovedShopProfileSync(uid) {
      let verification = get(/databases/$(database)/documents/users/$(uid)/shopVerification/profile).data;
      return approvedShopVerification(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "businessName", "phone", "address", "latitude", "longitude", "verified"
        ])
        && request.resource.data.verified == true
        && request.resource.data.businessName == verification.business.name
        && request.resource.data.phone == verification.business.phone
        && request.resource.data.address == verification.business.address
        && request.resource.data.latitude == verification.business.latitude
        && request.resource.data.longitude == verification.business.longitude;
    }

    function validShopListingProfile(uid) {
      // The public map pin can differ from the approved business address.
      // Ownership, verification, availability, and coordinate bounds are
      // validated separately; never write the private provider profile here.
      let shop = getAfter(/databases/$(database)/documents/providers/$(uid)).data;
      return request.resource.data.emergencyServiceAvailable == true
        && ((shop.status == "open" && request.resource.data.availability == "available")
          || (shop.status == "closed" && request.resource.data.availability == "offline"));
    }

    // Existing shop listings may have a non-zero rating summary maintained
    // by the review workflow. Provider edits must preserve system-owned fields
    // while still validating all provider-controlled values and shop bindings.
    function validShopPublicListingUpdate(uid) {
      let before = resource.data;
      let after = request.resource.data;
      return signedIn()
        && request.auth.uid == uid
        && before.providerId == uid
        && before.role == "shop-owner"
        && before.category == "Auto Shops"
        // The caller's changed-field allowlist below already prevents edits
        // to providerId, role, category, and ratingSummary.
        && (after.visibility == before.visibility
          || (after.visibility == "active" && accountIsActive(uid)))
        && before.ratingSummary is map
        && before.ratingSummary.keys().hasOnly(["average", "count"])
        && after.location is map
        && after.location.keys().hasOnly(["latitude", "longitude"])
        && hasValidProviderControlledFields()
        && hasValidRoleSpecificServices()
        && verifiedShop(uid)
        && validShopListingProfile(uid);
    }

    // Availability toggles only change one public field. Keep this narrowly
    // authorized so older approved listings do not need to pass the full
    // listing creation schema just to sync open/closed state.
    function validShopAvailabilitySync(uid) {
      return signedIn()
        && request.auth.uid == uid
        && verifiedShop(uid)
        && resource.data.providerId == uid
        && resource.data.role == "shop-owner"
        && resource.data.category == "Auto Shops"
        && resource.data.visibility == "active"
        && accountIsActive(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["availability"])
        && request.resource.data.availability in ["available", "offline"]
        && validShopListingProfile(uid);
    }

    function validMechanicAvailabilitySync(uid) {
      return signedIn()
        && request.auth.uid == uid
        && verifiedMechanic(uid)
        && resource.data.providerId == uid
        && resource.data.role == "onsite-mechanic"
        && resource.data.category == "Onsite Mechanics"
        && resource.data.visibility == "active"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["availability"])
        && request.resource.data.availability in ["available", "offline"];
    }

    function validHomeGarageAvailabilitySync(uid) {
      return signedIn()
        && request.auth.uid == uid
        && accountIsActive(uid)
        && get(/databases/$(database)/documents/users/$(uid)).data.role == "homegarage"
        && verifiedHomeGarage(uid)
        && validHomeGarageListingProfile(uid)
        && resource.data.providerId == uid
        && resource.data.role == "homegarage"
        && resource.data.category == "Parking Lots"
        && resource.data.visibility == "active"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["availability"])
        && request.resource.data.availability in ["available", "offline"];
    }

    function validProviderListingUpdate(uid) {
      let role = resource.data.role;
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return role == "shop-owner"
        ? (changed.hasOnly(["availability"])
          ? validShopAvailabilitySync(uid)
          : (validShopPublicListingUpdate(uid)
            && changed.hasOnly([
              "businessName", "location", "availability", "serviceAreaLabel", "description", "contactPhone",
              "services", "vehicleTypes", "operatingHours", "startingPrice",
              "emergencyServiceAvailable", "acceptsScheduledBookings", "photoUrls", "hoursType", "is24Hours", "weeklyHours", "visibility"
            ])))
        : role == "onsite-mechanic"
          ? (changed.hasOnly(["availability"])
            ? validMechanicAvailabilitySync(uid)
            : (validPublicListingWrite(uid)
              && (!changed.hasAny(["visibility"]) || accountIsActive(uid))
              && changed.hasOnly([
                "businessName", "location", "availability", "serviceAreaLabel", "description", "contactPhone",
                "services", "vehicleTypes", "operatingHours", "startingPrice",
                "emergencyServiceAvailable", "acceptsScheduledBookings", "photoUrls", "hoursType", "is24Hours", "weeklyHours", "totalSlots", "availableSlots", "visibility"
              ])))
          : role == "homegarage"
            ? (changed.hasOnly(["availability"])
              ? validHomeGarageAvailabilitySync(uid)
              : (validPublicListingWrite(uid)
                && (!changed.hasAny(["visibility"]) || accountIsActive(uid))
                && changed.hasOnly([
                  "businessName", "location", "availability", "serviceAreaLabel", "description", "contactPhone",
                  "services", "vehicleTypes", "operatingHours", "startingPrice",
                  "emergencyServiceAvailable", "acceptsScheduledBookings", "photoUrls", "hoursType", "is24Hours", "weeklyHours", "totalSlots", "availableSlots", "visibility"
                ])))
          : role == "towing-company"
            && validPublicListingWrite(uid)
            && (!changed.hasAny(["visibility"]) || accountIsActive(uid))
            && changed.hasOnly([
              "businessName", "location", "availability", "serviceAreaLabel", "description", "contactPhone",
              "services", "vehicleTypes", "operatingHours", "startingPrice",
              "emergencyServiceAvailable", "acceptsScheduledBookings", "photoUrls", "hoursType", "is24Hours", "weeklyHours", "totalSlots", "availableSlots", "visibility"
            ]);
    }

    function validMechanicProfileEdit(uid) {
      let profilePath = /databases/$(database)/documents/users/$(uid)/providerProfile/profile;
      let oldProfile = get(profilePath).data;
      return signedIn()
        && request.auth.uid == uid
        && oldProfile.uid == uid
        && oldProfile.role == "onsite-mechanic"
        && oldProfile.verificationStatus in ["INCOMPLETE", "PENDING", "VERIFIED", "REJECTED"]
        && request.resource.data.uid == oldProfile.uid
        && request.resource.data.role == oldProfile.role
        && request.resource.data.verificationStatus == oldProfile.verificationStatus
        && request.resource.data.identification == oldProfile.identification
        && request.resource.data.diff(oldProfile).affectedKeys().hasOnly([
          "personal", "professional", "credentials", "serviceInfo", "publicListing", "updatedAt"
        ])
        && request.resource.data.updatedAt == request.time;
    }

    function validTowingCompanyProfileEdit(uid) {
      let profilePath = /databases/$(database)/documents/users/$(uid)/towingCompanyProfile/profile;
      let oldProfile = get(profilePath).data;
      return signedIn()
        && request.auth.uid == uid
        && oldProfile.uid == uid
        && oldProfile.role == "towing-company"
        && oldProfile.verificationStatus in ["INCOMPLETE", "PENDING", "VERIFIED", "REJECTED"]
        && request.resource.data.uid == oldProfile.uid
        && request.resource.data.role == oldProfile.role
        && request.resource.data.verificationStatus == oldProfile.verificationStatus
        && request.resource.data.businessDocuments == oldProfile.businessDocuments
        && request.resource.data.representative.governmentIdType == oldProfile.representative.governmentIdType
        && request.resource.data.representative.governmentIdNumber == oldProfile.representative.governmentIdNumber
        && request.resource.data.representative.validIdUrl == oldProfile.representative.validIdUrl
        && request.resource.data.representative.profilePhotoUrl == oldProfile.representative.profilePhotoUrl
        && request.resource.data.diff(oldProfile).affectedKeys().hasOnly([
          "company", "services", "representative", "updatedAt"
        ])
        && request.resource.data.company.keys().hasOnly([
          "companyName", "phone", "address", "cityMunicipality", "operatingHours"
        ])
        && request.resource.data.company.companyName is string
        && request.resource.data.company.companyName.size() > 0
        && request.resource.data.company.companyName.size() <= 120
        && request.resource.data.company.phone is string
        && request.resource.data.company.phone.size() > 0
        && request.resource.data.company.phone.size() <= 30
        && request.resource.data.company.address is string
        && request.resource.data.company.address.size() > 0
        && request.resource.data.company.address.size() <= 300
        && request.resource.data.company.cityMunicipality is string
        && request.resource.data.company.cityMunicipality.size() > 0
        && request.resource.data.company.cityMunicipality.size() <= 120
        && request.resource.data.company.operatingHours is string
        && request.resource.data.company.operatingHours.size() > 0
        && request.resource.data.company.operatingHours.size() <= 200
        && request.resource.data.services.keys().hasOnly([
          "towingServices", "vehicleTypesSupported", "serviceArea", "emergencyServiceAvailable"
        ])
        && request.resource.data.services.towingServices is list
        && request.resource.data.services.towingServices.size() >= 1
        && request.resource.data.services.towingServices.size() <= 5
        && request.resource.data.services.towingServices.hasOnly([
          "Flatbed Towing", "Wheel-Lift Towing", "Emergency Roadside Assistance",
          "Accident Recovery", "Motorcycle Towing"
        ])
        && request.resource.data.services.vehicleTypesSupported is list
        && request.resource.data.services.vehicleTypesSupported.size() >= 1
        && request.resource.data.services.vehicleTypesSupported.size() <= 6
        && request.resource.data.services.vehicleTypesSupported.hasOnly([
          "Motorcycle", "Car", "SUV", "Pickup Truck", "Van", "Truck"
        ])
        && request.resource.data.services.serviceArea is string
        && request.resource.data.services.serviceArea.size() > 0
        && request.resource.data.services.serviceArea.size() <= 120
        && request.resource.data.services.emergencyServiceAvailable is bool
        && request.resource.data.representative.keys().hasOnly([
          "fullName", "governmentIdType", "governmentIdNumber", "validIdUrl", "profilePhotoUrl"
        ])
        && request.resource.data.representative.fullName is string
        && request.resource.data.representative.fullName.size() > 0
        && request.resource.data.representative.fullName.size() <= 120
        && request.resource.data.updatedAt == request.time;
    }

    function validHomeGarageListingProfile(uid) {
      let verification = get(/databases/$(database)/documents/users/$(uid)/homeGarageVerification/profile).data;
      return verification.business.name is string
        && verification.business.name.size() > 0;
    }

    function validShopVehicle() {
      let vehicle = get(/databases/$(database)/documents/users/$(request.auth.uid)/vehicles/$(request.resource.data.vehicleId)).data;
      return request.resource.data.vehicle == vehicle.make + " " + vehicle.model
        && request.resource.data.vehicleYear == vehicle.year
        && request.resource.data.vehiclePlate == vehicle.plateNumber;
    }

    function validShopBookingListing() {
      let listing = get(/databases/$(database)/documents/providerListings/$(request.resource.data.providerId)).data;
      return validBookingProvider()
        && listing.category == "Auto Shops"
        && listing.emergencyServiceAvailable == true
        && request.resource.data.shopLatitude == listing.location.latitude
        && request.resource.data.shopLongitude == listing.location.longitude
        && request.resource.data.shopAreaLabel == listing.serviceAreaLabel;
    }

    function isOpenShop(uid) {
      let shop = get(/databases/$(database)/documents/providers/$(uid)).data;
      return isShopOwner(uid)
        && shop.uid == uid
        && shop.role == "shop-owner"
        && shop.status == "open"
        && shop.businessName is string && shop.businessName.size() > 0
        && shop.phone is string && shop.phone.size() > 0
        && shop.address is string && shop.address.size() > 0
        && shop.latitude is number && shop.latitude >= -90 && shop.latitude <= 90
        && shop.longitude is number && shop.longitude >= -180 && shop.longitude <= 180
        && !(shop.latitude == 0 && shop.longitude == 0);
    }

    function validShopBooking() {
      return request.resource.data.bookingType == "shop-owner"
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "owner"
        && request.resource.data.keys().hasOnly([
          "bookingType", "customerId", "customerName", "customerEmail", "customerPhone",
          "providerId", "providerName", "vehicleId", "vehicle", "vehicleYear",
          "vehiclePlate", "latitude", "longitude", "problem", "notes", "startingPrice", "status",
          "createdAt", "updatedAt", "shopLatitude", "shopLongitude", "shopAreaLabel", "timingMode", "urgency", "scheduledAt"
        ])
        && request.resource.data.problem is string
        && request.resource.data.problem.size() > 0
        && request.resource.data.problem.size() <= 300
        && verifiedShop(request.resource.data.providerId)
        && (request.resource.data.timingMode == "scheduled"
          ? (isShopOwner(request.resource.data.providerId)
            && get(/databases/$(database)/documents/providers/$(request.resource.data.providerId)).data.uid == request.resource.data.providerId
            && get(/databases/$(database)/documents/providers/$(request.resource.data.providerId)).data.role == "shop-owner")
          : isOpenShop(request.resource.data.providerId))
        && validShopBookingListing()
        && validShopVehicle();
    }

    function validHomeGarageBooking() {
      let listing = get(/databases/$(database)/documents/providerListings/$(request.resource.data.providerId)).data;
      let vehicle = get(/databases/$(database)/documents/users/$(request.auth.uid)/vehicles/$(request.resource.data.vehicleId)).data;
      return signedIn()
        && verifiedVehicleOwner(request.auth.uid)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "owner"
        && request.resource.data.bookingType == "homegarage"
        && request.resource.data.keys().hasOnly([
          "bookingType", "customerId", "customerName", "customerPhone", "providerId", "providerName",
          "vehicleId", "vehicle", "vehicleYear", "vehiclePlate", "problem", "notes",
          "garageLatitude", "garageLongitude", "serviceAreaLabel", "startingPrice", "status",
          "createdAt", "updatedAt", "timingMode", "urgency", "scheduledAt"
        ])
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.customerName is string && request.resource.data.customerName.size() > 0
        && request.resource.data.customerName.size() <= 120
        && request.resource.data.customerPhone is string
        && request.resource.data.customerPhone.size() <= 30
        && request.resource.data.providerId is string && request.resource.data.providerId != request.auth.uid
        && listing.providerId == request.resource.data.providerId
        && listing.role == "homegarage" && listing.category == "Parking Lots"
        && listing.visibility == "active" && validBookingTiming(listing)
        && approvedHomeGarage(request.resource.data.providerId)
        && request.resource.data.providerName == listing.businessName
        && request.resource.data.vehicleId is string
        && request.resource.data.vehicle == vehicle.make + " " + vehicle.model
        && request.resource.data.vehicleYear == vehicle.year
        && request.resource.data.vehiclePlate == vehicle.plateNumber
        && request.resource.data.problem is string && request.resource.data.problem.size() > 0
        && request.resource.data.problem.size() <= 300
        && request.resource.data.notes is string && request.resource.data.notes.size() <= 1000
        && request.resource.data.garageLatitude == listing.location.latitude
        && request.resource.data.garageLongitude == listing.location.longitude
        && request.resource.data.serviceAreaLabel == listing.serviceAreaLabel
        && request.resource.data.startingPrice is string && request.resource.data.startingPrice.size() <= 60
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validHomeGarageBookingLock(bookingId) {
      let lockPath = /databases/$(database)/documents/users/$(request.resource.data.customerId)/homeGarageBookingLocks/$(request.resource.data.providerId);
      return existsAfter(lockPath)
        && getAfter(lockPath).data.customerId == request.resource.data.customerId
        && getAfter(lockPath).data.providerId == request.resource.data.providerId
        && getAfter(lockPath).data.bookingId == bookingId;
    }

    function validHomeGarageBookingLockWrite(uid, providerId) {
      let bookingPath = /databases/$(database)/documents/bookings/$(request.resource.data.bookingId);
      return signedIn()
        && isDocumentOwner(uid)
        && request.resource.data.keys().hasOnly(["customerId", "providerId", "bookingId"])
        && request.resource.data.customerId == uid
        && request.resource.data.providerId == providerId
        && request.resource.data.bookingId is string
        && existsAfter(bookingPath)
        && getAfter(bookingPath).data.bookingType == "homegarage"
        && getAfter(bookingPath).data.customerId == uid
        && getAfter(bookingPath).data.providerId == providerId
        && getAfter(bookingPath).data.status == "pending";
    }

    function validHomeGarageBookingTransition(bookingId) {
      let before = resource.data.status;
      let after = request.resource.data.status;
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "homegarage"
        && approvedHomeGarage(request.auth.uid)
        && ((before == "pending" && after == "rejected"
              && optionalBookingReasonIsValid(request.resource.data, "declineReason")
              && optionalRiskEventIsValid("provider_decline", "pending")
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt", "declineReason", "riskEventType", "riskEventAt"]))
          || (before == "pending" && after == "accepted"
              && reservationClaimedFor(bookingId, resource.data)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"]))
          || (before == "accepted" && after == "accepted"
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["assessmentPrice", "updatedAt"])
              && request.resource.data.assessmentPrice is number
              && request.resource.data.assessmentPrice >= 0
              && request.resource.data.assessmentPrice <= 100000000)
          || (before == "accepted" && after == "vehicle_arrived"
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"]))
          || (before == "vehicle_arrived" && after == "diagnosing"
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"]))
          || (before == "diagnosing" && after == "repairing"
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"]))
          || ((before == "repairing" || before == "in_progress") && after == "completed"
              && request.resource.data.finalPrice is number
              && request.resource.data.finalPrice >= 0
              && request.resource.data.finalPrice <= 100000000
              && request.resource.data.finalPrice * 100 % 1 == 0
              && request.resource.data.completedAt == request.time
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt", "finalPrice", "completedAt", "completionNote"])
              && (!request.resource.data.keys().hasAny(["completionNote"])
                || (request.resource.data.completionNote is string && request.resource.data.completionNote.size() <= 160))));
    }

    // One lock per customer/shop pair serializes simultaneous request creates.
    // The lock must point to the pending booking created in the same commit.
    function validShopBookingLock(bookingId) {
      let lockPath = /databases/$(database)/documents/users/$(request.resource.data.customerId)/shopBookingLocks/$(request.resource.data.providerId);
      return existsAfter(lockPath)
        && getAfter(lockPath).data.customerId == request.resource.data.customerId
        && getAfter(lockPath).data.providerId == request.resource.data.providerId
        && getAfter(lockPath).data.bookingId == bookingId;
    }

    function validShopBookingLockWrite(uid, providerId) {
      let bookingPath = /databases/$(database)/documents/bookings/$(request.resource.data.bookingId);
      return signedIn()
        && request.resource.data.keys().hasOnly(["customerId", "providerId", "bookingId"])
        && isDocumentOwner(uid)
        && request.resource.data.customerId == uid
        && request.resource.data.providerId == providerId
        && request.resource.data.bookingId is string
        && existsAfter(bookingPath)
        && getAfter(bookingPath).data.bookingType == "shop-owner"
        && getAfter(bookingPath).data.customerId == request.auth.uid
        && getAfter(bookingPath).data.providerId == request.resource.data.providerId
        && getAfter(bookingPath).data.status == "pending";
    }

    function validShopBookingTransition(bookingId) {
      let before = resource.data.status;
      let after = request.resource.data.status;
      return isShopOwner(request.auth.uid)
        && ((before == "pending" && after == "accepted"
              && (resource.data.get("timingMode", "now") == "scheduled" || isOpenShop(request.auth.uid))
              && verifiedShop(request.auth.uid)
              && reservationClaimedFor(bookingId, resource.data)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"]))
          || (before == "pending" && after == "rejected"
              && optionalRiskEventIsValid("provider_decline", "pending")
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt", "declineReason", "riskEventType", "riskEventAt"])
              && optionalBookingReasonIsValid(request.resource.data, "declineReason"))
          || (before == "accepted" && after == "vehicle_arrived"
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"]))
          || (before == "vehicle_arrived" && after == "diagnosing"
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"]))
          || (before == "diagnosing" && after == "repairing"
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"]))
          || (before == "repairing" && after == "completed"
              && request.resource.data.finalPrice is number
              && request.resource.data.finalPrice >= 0
              && request.resource.data.finalPrice <= 100000000
              && request.resource.data.finalPrice * 100 % 1 == 0
              && request.resource.data.completedAt == request.time
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt", "finalPrice", "completedAt", "completionNote"])
              && (!request.resource.data.keys().hasAny(["completionNote"])
                || (request.resource.data.completionNote is string && request.resource.data.completionNote.size() <= 160))));
    }

    function validTowingBooking(listing) {
      let booking = request.resource.data;
      let pricing = get(/databases/$(database)/documents/users/$(booking.providerId)/towingPricing/config).data;
      return booking.keys().hasOnly([
          "bookingType", "customerId", "customerName", "customerEmail", "customerPhone",
          "providerId", "providerName", "vehicleId", "vehicle", "vehicleYear",
          "vehiclePlate", "latitude", "longitude", "providerLatitude", "providerLongitude",
          "destinationLatitude", "destinationLongitude", "providerToPickupDistanceKm",
          "pickupToDestinationDistanceKm", "totalDistanceKm", "basePrice",
          "pricePerKm", "distanceCharge", "estimatedTotalPrice", "pricingMode", "dispatcherPhone",
          "pickupLocation", "destination", "towingType",
          "vehicleCondition", "notes", "startingPrice", "status", "createdAt",
          "updatedAt", "timingMode", "urgency", "scheduledAt"
        ])
        && booking.providerLatitude == listing.location.latitude
        && booking.providerLongitude == listing.location.longitude
        && booking.destinationLatitude is number
        && booking.destinationLatitude >= -90
        && booking.destinationLatitude <= 90
        && booking.destinationLongitude is number
        && booking.destinationLongitude >= -180
        && booking.destinationLongitude <= 180
        && !(booking.destinationLatitude == 0 && booking.destinationLongitude == 0)
        && booking.providerToPickupDistanceKm is number
        && booking.providerToPickupDistanceKm >= 0
        && booking.pickupToDestinationDistanceKm is number
        && booking.pickupToDestinationDistanceKm >= 0
        && booking.totalDistanceKm is number
        && booking.totalDistanceKm > 0
        && booking.totalDistanceKm <= 2000
        && booking.totalDistanceKm >= booking.providerToPickupDistanceKm + booking.pickupToDestinationDistanceKm - 0.02
        && booking.totalDistanceKm <= booking.providerToPickupDistanceKm + booking.pickupToDestinationDistanceKm + 0.02
        && booking.pricingMode in ["fixed", "dispatcher"]
        && booking.dispatcherPhone is string
        && (
          ((pricing.pricingMode == null || pricing.pricingMode == "fixed")
            && booking.pricingMode == "fixed"
            && booking.dispatcherPhone == ""
            && booking.basePrice is number
            && booking.basePrice == pricing.basePrice
            && booking.pricePerKm is number
            && booking.pricePerKm == pricing.pricePerKm
            && booking.distanceCharge is number
            && booking.distanceCharge >= booking.totalDistanceKm * booking.pricePerKm - 0.01
            && booking.distanceCharge <= booking.totalDistanceKm * booking.pricePerKm + 0.01
            && booking.estimatedTotalPrice is number
            && booking.estimatedTotalPrice >= booking.basePrice + booking.distanceCharge - 0.01
            && booking.estimatedTotalPrice <= booking.basePrice + booking.distanceCharge + 0.01)
          || (pricing.pricingMode == "dispatcher"
            && booking.pricingMode == "dispatcher"
            && booking.dispatcherPhone == pricing.dispatcherPhone
            && booking.dispatcherPhone.size() > 0
            && booking.basePrice == 0
            && booking.pricePerKm == 0
            && booking.distanceCharge == 0
            && booking.estimatedTotalPrice == 0)
        )
        && booking.pickupLocation is string
        && booking.pickupLocation.size() > 0
        && booking.pickupLocation.size() <= 300
        && booking.destination is string
        && booking.destination.size() > 0
        && booking.destination.size() <= 300
        && booking.towingType in ["Flatbed Towing", "Wheel-Lift Towing", "Motorcycle Towing", "Emergency Towing"]
        && booking.vehicleCondition in ["Vehicle can move", "Vehicle cannot move", "Vehicle badly damaged", "Accident vehicle"];
    }

    function validTowingPricingShape() {
      return request.resource.data.keys().hasOnly([
          "basePrice", "pricePerKm", "pricingMode", "dispatcherPhone", "createdAt", "updatedAt"
        ])
        && request.resource.data.basePrice is number
        && request.resource.data.basePrice >= 0
        && request.resource.data.basePrice <= 1000000
        && request.resource.data.pricePerKm is number
        && request.resource.data.pricePerKm >= 0
        && request.resource.data.pricePerKm <= 100000
        && request.resource.data.pricingMode in ["fixed", "dispatcher"]
        && request.resource.data.dispatcherPhone is string
        && request.resource.data.dispatcherPhone.size() <= 50
        && (request.resource.data.pricingMode == "fixed" || request.resource.data.dispatcherPhone.size() > 0);
    }

    function validVehicleShape(vehicleId) {
      return request.resource.data.keys().hasOnly([
          "vehicleId", "type", "make", "model", "year", "color",
          "plateNumber", "createdAt", "updatedAt"
        ])
        && request.resource.data.vehicleId == vehicleId
        && request.resource.data.type in ["Car", "SUV", "Pickup Truck", "Van", "Motorcycle", "Truck"]
        && request.resource.data.make is string
        && request.resource.data.make.size() > 0
        && request.resource.data.make.size() <= 60
        && request.resource.data.model is string
        && request.resource.data.model.size() > 0
        && request.resource.data.model.size() <= 60
        && request.resource.data.year is int
        && request.resource.data.year >= 1900
        && request.resource.data.year <= 2100
        && request.resource.data.color is string
        && request.resource.data.color.size() > 0
        && request.resource.data.color.size() <= 40
        && request.resource.data.plateNumber is string
        && request.resource.data.plateNumber.size() > 0
        && request.resource.data.plateNumber.size() <= 20;
    }

    function validProviderBookingTransition(bookingId) {
      let before = resource.data.status;
      let after = request.resource.data.status;
      return (before == "pending" && after == "rejected"
          && optionalRiskEventIsValid("provider_decline", "pending")
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt", "declineReason", "riskEventType", "riskEventAt"])
          && optionalBookingReasonIsValid(request.resource.data, "declineReason"))
        || (before == "pending" && after in ["accepted", "cancelled"]
          && (after != "accepted" || reservationClaimedFor(bookingId, resource.data)))
        || (before == "accepted" && after in ["en_route", "cancelled"])
        || (before == "en_route" && after in ["arrived", "cancelled"])
        || (before == "arrived" && after == "in_progress")
        || (before == "in_progress" && after == "completed"
          && request.resource.data.finalPrice is number
          && request.resource.data.finalPrice >= 0
          && request.resource.data.finalPrice <= 100000000
          && request.resource.data.finalPrice * 100 % 1 == 0
          && request.resource.data.completedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasAll(["status", "updatedAt", "finalPrice", "completedAt"]));
    }

    function validMechanicLocationUpdate() {
      return resource.data.bookingType == "onsite-mechanic"
        && resource.data.status in ["accepted", "en_route", "arrived", "in_progress"]
        && request.resource.data.mechanicLatitude is number
        && request.resource.data.mechanicLatitude >= -90
        && request.resource.data.mechanicLatitude <= 90
        && request.resource.data.mechanicLongitude is number
        && request.resource.data.mechanicLongitude >= -180
        && request.resource.data.mechanicLongitude <= 180
        && request.resource.data.mechanicLocationUpdatedAt == request.time;
    }

    function validProviderReview(reviewId) {
      let bookingPath = /databases/$(database)/documents/bookings/$(reviewId);
      let booking = get(bookingPath).data;
      return signedIn()
        && exists(bookingPath)
        && request.resource.data.keys().hasOnly([
          "bookingId", "customerId", "providerId", "providerRole", "rating",
          "comment", "createdAt", "updatedAt"
        ])
        && request.resource.data.bookingId == reviewId
        && request.resource.data.customerId == request.auth.uid
        && booking.customerId == request.auth.uid
        && booking.status == "completed"
        && request.resource.data.providerId == booking.providerId
        && request.resource.data.providerId != request.auth.uid
        && request.resource.data.providerRole == booking.bookingType
        && request.resource.data.providerRole in ["onsite-mechanic", "towing-company", "shop-owner", "homegarage"]
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 1000
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validParkingProviderReview(reviewId) {
      let bookingPath = /databases/$(database)/documents/parkingBookings/$(reviewId);
      let booking = get(bookingPath).data;
      return signedIn()
        && exists(bookingPath)
        && request.resource.data.keys().hasOnly([
          "bookingId", "customerId", "providerId", "providerRole", "rating",
          "comment", "createdAt", "updatedAt"
        ])
        && request.resource.data.bookingId == reviewId
        && request.resource.data.customerId == request.auth.uid
        && booking.customerId == request.auth.uid
        && booking.status == "completed"
        && request.resource.data.providerId == booking.providerId
        && request.resource.data.providerId != request.auth.uid
        && request.resource.data.providerRole == "homegarage"
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 1000
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    // General account data remains private to its account owner.
    match /users/{uid} {
      allow create: if isDocumentOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role in ["owner", "onsite-mechanic", "shop-owner", "towing-company", "homegarage"];
      allow get: if isDocumentOwner(uid)
        || (isAdmin() && resource.data.role in ["onsite-mechanic", "shop-owner", "towing-company", "homegarage", "owner"]);
      allow list: if isAdmin();
      allow update: if validAdminAccountStatus(uid);
      allow update: if isDocumentOwner(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          "accountStatus", "accountStatusUpdatedAt", "accountStatusUpdatedBy", "accountStatusNotificationId"
        ]);
      allow delete: if false;

      match /vehicles/{vehicleId} {
        allow get, list: if isDocumentOwner(uid);
        allow create: if isDocumentOwner(uid)
          && validVehicleShape(vehicleId)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if isDocumentOwner(uid)
          && validVehicleShape(vehicleId)
          && request.resource.data.vehicleId == resource.data.vehicleId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "type", "make", "model", "year", "color", "plateNumber", "updatedAt"
          ]);
        allow delete: if isDocumentOwner(uid);
      }

      match /notifications/{notificationId} {
        allow get, list: if isDocumentOwner(uid);
        allow create: if validCustomerNotificationCreate(uid, notificationId);
        allow update: if (isDocumentOwner(uid)
            && resource.data.customerId == uid
            && resource.data.isRead == false
            && request.resource.data.isRead == true
            && request.resource.data.readAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["isRead", "readAt"]))
          || validCustomerNotificationUpdate(uid, notificationId);
        allow delete: if false;
      }

      match /mechanicNotifications/{notificationId} {
        allow get, list: if isDocumentOwner(uid);
        allow create: if validMechanicNotificationCreate(uid, notificationId);
        allow update: if (isDocumentOwner(uid)
            && resource.data.providerId == uid
            && resource.data.isRead == false
            && request.resource.data.isRead == true
            && request.resource.data.readAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["isRead", "readAt"]))
          || validMechanicNotificationUpdate(uid, notificationId);
        allow delete: if false;
      }

      match /towingNotifications/{notificationId} {
        allow get, list: if isDocumentOwner(uid);
        allow create: if validTowingNotificationCreate(uid, notificationId);
        allow update: if (isDocumentOwner(uid)
            && resource.data.providerId == uid
            && resource.data.isRead == false
            && request.resource.data.isRead == true
            && request.resource.data.readAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["isRead", "readAt"]))
          || validTowingNotificationUpdate(uid, notificationId);
        allow delete: if false;
      }

      match /shopNotifications/{notificationId} {
        allow get, list: if isDocumentOwner(uid);
        allow create: if validShopNotificationCreate(uid, notificationId);
        allow update: if (isDocumentOwner(uid)
            && resource.data.providerId == uid
            && resource.data.isRead == false
            && request.resource.data.isRead == true
            && request.resource.data.readAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["isRead", "readAt"]))
          || validShopNotificationUpdate(uid, notificationId);
        allow delete: if false;
      }

      match /homeGarageNotifications/{notificationId} {
        allow get, list: if isDocumentOwner(uid);
        allow create: if validHomeGarageNotificationCreate(uid, notificationId);
        allow update: if (isDocumentOwner(uid) && resource.data.providerId == uid
            && resource.data.isRead == false && request.resource.data.isRead == true
            && request.resource.data.readAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["isRead", "readAt"]))
          || validHomeGarageNotificationUpdate(uid, notificationId);
        allow delete: if false;
      }

      // Account status messages are created by admins in the same batch as a
      // provider status transition.
      match /accountStatusNotifications/{notificationId} {
        allow get, list: if isDocumentOwner(uid);
        allow create: if request.resource.data.keys().hasOnly([
            "notificationId", "providerId", "providerRole", "status", "previousStatus", "title", "message", "reason",
            "isRead", "readAt", "createdAt", "updatedAt"
          ])
          && (validAdminVerificationNotification(uid, notificationId)
            || validAdminAccountStatusNotification(uid, notificationId));
        allow update: if isDocumentOwner(uid)
          && resource.data.providerId == uid
          && resource.data.isRead == false
          && request.resource.data.isRead == true
          && request.resource.data.readAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["isRead", "readAt"]);
        allow update: if isAdmin()
          && resource.data.providerId == uid
          && resource.data.status == "ACTIVE"
          && get(/databases/$(database)/documents/users/$(uid)).data.accountStatus == "active"
          && get(/databases/$(database)/documents/users/$(uid)).data.accountStatusNotificationId == notificationId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["message", "updatedAt"])
          && request.resource.data.message is string
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      // Per-shop idempotency pointer, private to the vehicle owner.
      match /shopBookingLocks/{providerId} {
        allow get: if isDocumentOwner(uid);
        allow list: if false;
        allow create, update: if validShopBookingLockWrite(uid, providerId);
        allow delete: if false;
      }

      match /homeGarageBookingLocks/{providerId} {
        allow get: if isDocumentOwner(uid);
        allow list: if false;
        allow create, update: if validHomeGarageBookingLockWrite(uid, providerId);
        allow delete: if false;
      }

      // Providers may submit and resubmit private verification information,
      // but cannot mark themselves as verified from the client application.
      match /ownerProfile/profile {
        allow get: if isDocumentOwner(uid) || isAdmin();
        allow update: if validAdminReview(uid, "owner", false);
        allow create, update: if isDocumentOwner(uid)
          && request.resource.data.uid == uid
          && request.resource.data.role == "owner"
          && isPendingVerificationSubmission();
        allow update: if isDocumentOwner(uid)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.verificationStatus == resource.data.verificationStatus
          && request.resource.data.identification == resource.data.identification
          && request.resource.data.vehicleDocuments == resource.data.vehicleDocuments
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["personal", "updatedAt"])
          && request.resource.data.personal.keys().hasOnly(["fullName", "phone", "address", "cityMunicipality"])
          && request.resource.data.personal.fullName is string
          && request.resource.data.personal.phone is string
          && request.resource.data.personal.address is string
          && request.resource.data.personal.cityMunicipality is string;
        allow delete: if false;
      }

      match /providerProfile/profile {
        allow get: if isDocumentOwner(uid) || isAdmin();
        allow list: if isAdmin() && resource.data.verificationStatus == "PENDING";
        allow create: if isDocumentOwner(uid) && isPendingVerificationSubmission();
        allow update: if validAdminReview(uid, "onsite-mechanic", false)
          || (isDocumentOwner(uid) && isPendingVerificationSubmission())
          || validMechanicProfileEdit(uid);
        allow delete: if false;
      }

      match /towingCompanyProfile/profile {
        allow get: if isDocumentOwner(uid) || isAdmin();
        allow list: if isAdmin() && resource.data.verificationStatus == "PENDING";
        allow create: if isDocumentOwner(uid)
          && request.resource.data.uid == uid
          && request.resource.data.role == "towing-company"
          && isPendingVerificationSubmission();
        allow update: if (isDocumentOwner(uid)
            && resource.data.uid == uid
            && resource.data.role == "towing-company"
            && resource.data.verificationStatus in ["INCOMPLETE", "PENDING", "REJECTED"]
            && isPendingVerificationSubmission())
          || validAdminReview(uid, "towing-company", false)
          || validTowingCompanyProfileEdit(uid);
        allow delete: if false;
      }

      // Auto shops submit private verification documents here. Client writes
      // are limited to a pending submission; approval remains administrator-controlled.
      match /shopVerification/profile {
        allow get: if isDocumentOwner(uid) || isAdmin();
        allow update: if validAdminReview(uid, "shop-owner", false);
        allow create: if isDocumentOwner(uid)
          && request.resource.data.uid == uid
          && request.resource.data.role == "shop-owner"
          && request.resource.data.verificationStatus == "PENDING";
        allow update: if isDocumentOwner(uid)
            && request.resource.data.uid == uid
            && request.resource.data.role == "shop-owner"
            && request.resource.data.verificationStatus == "PENDING";
        allow delete: if false;
      }

      // HomeGarage parking providers submit private business documents here.
      // Approval is performed by administration, never by the client.
      match /homeGarageVerification/profile {
        allow get: if isDocumentOwner(uid) || isAdmin();
        allow create: if isDocumentOwner(uid)
          && request.resource.data.uid == uid
          && request.resource.data.role == "homegarage"
          && request.resource.data.verificationStatus == "PENDING";
        allow update: if validAdminReview(uid, "homegarage", false)
          || (isDocumentOwner(uid)
            && request.resource.data.uid == uid
            && request.resource.data.role == "homegarage"
            && request.resource.data.verificationStatus == "PENDING");
        allow delete: if false;
      }

      match /towingPricing/{pricingId} {
        allow get: if pricingId == "config" && (isDocumentOwner(uid)
          || (signedIn()
            && exists(/databases/$(database)/documents/providerListings/$(uid))
            && get(/databases/$(database)/documents/providerListings/$(uid)).data.role == "towing-company"
            && get(/databases/$(database)/documents/providerListings/$(uid)).data.visibility == "active"));
        allow list: if false;
        allow create: if pricingId == "config"
          && isDocumentOwner(uid)
          && verifiedTowingCompany(uid)
          && validTowingPricingShape()
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if pricingId == "config"
          && isDocumentOwner(uid)
          && verifiedTowingCompany(uid)
          && validTowingPricingShape()
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "basePrice", "pricePerKm", "pricingMode", "dispatcherPhone", "updatedAt"
          ]);
        allow delete: if false;
      }
    }

    // Business profiles stay private. Only trusted administration can approve a
    // shop; clients cannot set approval, replace an approved doc or delete it.
    match /providers/{uid} {
      allow read: if isDocumentOwner(uid) || (isAdmin() && resource.data.role == "shop-owner");
      allow list: if isAdmin() && resource.data.role == "shop-owner";
      allow update: if validShopReview(uid);
      allow create: if isDocumentOwner(uid)
        && ((isShopOwner(uid)
            && request.resource.data.uid == uid
            && request.resource.data.role == "shop-owner"
            && request.resource.data.verified == false
            && request.resource.data.rating == 0
            && request.resource.data.status == "closed")
          || (!isShopOwner(uid) && request.resource.data.role != "shop-owner"));
      allow update: if isDocumentOwner(uid)
        && ((isShopOwner(uid) && resource.data.role == "shop-owner"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "businessName", "phone", "address", "latitude", "longitude", "status"
            ])
            && request.resource.data.status in ["open", "closed"])
          || (isShopOwner(uid) && resource.data.role == "shop-owner"
            && validApprovedShopProfileSync(uid))
          || (!isShopOwner(uid) && resource.data.role != "shop-owner" && request.resource.data.role != "shop-owner"));
      allow delete: if isDocumentOwner(uid) && !isShopOwner(uid) && resource.data.role != "shop-owner";
    }

    // Providers publish the minimal customer-map document directly. If a
    // provider's verification is later revoked, the trusted admin workflow
    // must remove or deactivate this existing listing.
    match /providerListings/{providerId} {
      allow get: if isAdmin() || isDocumentOwner(providerId) || (signedIn() && resource.data.visibility == "active" && (resource.data.availability == "available" || resource.data.get("acceptsScheduledBookings", false) == true));
      allow list: if isAdmin() || (signedIn() && resource.data.visibility == "active" && (resource.data.availability == "available" || resource.data.get("acceptsScheduledBookings", false) == true));
      allow update: if validAdminListingRestore(providerId) || validAdminListingHide(providerId);
      allow create: if accountIsActive(providerId) && validPublicListingCreate(providerId);
      allow update: if validProviderListingUpdate(providerId);
      allow delete: if false;
    }

    match /providerStatusHistory/{historyId} {
      allow get, list: if isAdmin();
      allow create: if validProviderStatusHistory(historyId);
      allow update: if validAdminListingRestoreHistory(historyId);
      allow delete: if false;
    }

    match /providerVerificationHistory/{historyId} {
      allow get, list: if isAdmin();
      allow create: if validProviderVerificationHistory();
      allow update, delete: if false;
    }

    // Admin review queues use collection-group queries and return only pending submissions.
    match /{path=**}/ownerProfile/{profileId} {
      allow list: if isAdmin() && resource.data.verificationStatus == "PENDING";
    }
    match /{path=**}/providerProfile/{profileId} {
      allow list: if isAdmin() && resource.data.verificationStatus == "PENDING";
    }
    match /{path=**}/towingCompanyProfile/{profileId} {
      allow list: if isAdmin() && resource.data.verificationStatus == "PENDING";
    }
    match /{path=**}/shopVerification/{profileId} {
      allow list: if isAdmin() && resource.data.verificationStatus == "PENDING";
    }
    match /{path=**}/homeGarageVerification/{profileId} {
      allow list: if isAdmin() && resource.data.verificationStatus == "PENDING";
    }

    // Parking bookings are customer-controlled sessions. Capacity changes are
    // only accepted alongside the app's Firestore transactions; providers
    // never need to start or end a customer's parking session.
    match /parkingBookings/{bookingId} {
      // Stage 1 stops new sessions while existing sessions remain readable and completable.
      allow create: if false;
      allow get, list: if signedIn() && (resource.data.customerId == request.auth.uid || resource.data.providerId == request.auth.uid);
      allow update: if signedIn() && resource.data.customerId == request.auth.uid
        && ((resource.data.status == "reserved" && request.resource.data.status == "active"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "parkingStartedAt", "updatedAt"])
          && request.resource.data.parkingStartedAt == request.time && request.resource.data.updatedAt == request.time)
          || (resource.data.status == "active" && request.resource.data.status == "completed"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "parkingEndedAt", "updatedAt"])
          && request.resource.data.parkingEndedAt == request.time && request.resource.data.updatedAt == request.time
          && getAfter(/databases/$(database)/documents/parkingSlots/$(resource.data.slotId)).data.status == "available"));
      allow delete: if false;
    }

    // A slot is the atomic capacity lock. Its state carries no public vehicle
    // data, and only its reserving customer can release it.
    match /parkingSlots/{slotId} {
      allow get, list: if signedIn();
      allow create: if isDocumentOwner(request.resource.data.providerId)
        && accountIsActive(request.auth.uid)
        && request.resource.data.keys().hasOnly(["providerId", "slotNumber", "status", "customerId", "bookingId"])
        && request.resource.data.slotNumber is int && request.resource.data.slotNumber >= 1 && request.resource.data.slotNumber <= 500
        && request.resource.data.status == "available" && request.resource.data.customerId == null && request.resource.data.bookingId == null
        && get(/databases/$(database)/documents/providerListings/$(request.resource.data.providerId)).data.role == "homegarage";
      allow update: if signedIn()
        && (resource.data.status == "reserved" && resource.data.customerId == request.auth.uid
          && request.resource.data.status == "available" && request.resource.data.customerId == null && request.resource.data.bookingId == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "customerId", "bookingId", "updatedAt"])
          && request.resource.data.updatedAt == request.time);
      allow delete: if false;
    }

    match /providerScheduleReservations/{reservationId} {
      allow get: if isAdmin() || (signedIn() &&
        ((!exists(/databases/$(database)/documents/providerScheduleReservations/$(reservationId))
            && reservationId.matches("^.+_[0-9]+$"))
          || resource.data.providerId == request.auth.uid
          || get(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.customerId == request.auth.uid));
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(["providerId", "bookingId", "scheduledAt", "createdAt"])
        && request.resource.data.providerId == request.auth.uid
        && request.resource.data.bookingId is string
        && request.resource.data.scheduledAt is timestamp
        && request.resource.data.createdAt == request.time
        && reservationId == request.auth.uid + "_" + string(request.resource.data.scheduledAt.toMillis())
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.providerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.timingMode == "scheduled"
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.scheduledAt == request.resource.data.scheduledAt
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.status == "accepted";
      allow update: if false;
      allow delete: if signedIn()
        && resource.data.bookingId is string
        && getAfter(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.customerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.status == "cancelled";
    }

    match /bookings/{bookingId} {
      function providerTransitionAllowed() {
        return resource.data.bookingType == "shop-owner"
          ? validShopBookingTransition(bookingId)
          : resource.data.bookingType == "homegarage"
            ? validHomeGarageBookingTransition(bookingId)
            : resource.data.bookingType in ["onsite-mechanic", "towing-company"]
              && validProviderBookingTransition(bookingId);
      }

      function providerUpdateAllowed() {
        return resource.data.providerId == request.auth.uid
          && accountIsActive(request.auth.uid)
          && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "mechanicLatitude", "mechanicLongitude", "mechanicLocationUpdatedAt"
              ]) && validMechanicLocationUpdate())
            || ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
                || (resource.data.bookingType in ["onsite-mechanic", "towing-company"]
                  && resource.data.status == "pending"
                  && request.resource.data.status == "rejected"
                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt", "declineReason", "riskEventType", "riskEventAt"])
                  && optionalBookingReasonIsValid(request.resource.data, "declineReason"))
                || (resource.data.bookingType in ["onsite-mechanic", "towing-company"]
                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt", "finalPrice", "completedAt"]))
                || (resource.data.bookingType == "homegarage"
                  && resource.data.status == "pending"
                  && request.resource.data.status == "rejected"
                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt", "declineReason", "riskEventType", "riskEventAt"])
                  && optionalBookingReasonIsValid(request.resource.data, "declineReason"))
                || (resource.data.bookingType == "shop-owner"
                  && resource.data.status == "pending"
                  && request.resource.data.status == "rejected"
                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt", "declineReason", "riskEventType", "riskEventAt"])
                  && optionalBookingReasonIsValid(request.resource.data, "declineReason"))
                || (resource.data.bookingType in ["shop-owner", "homegarage"]
                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt", "finalPrice", "completedAt", "completionNote"])))
              && request.resource.data.updatedAt == request.time
              && providerTransitionAllowed()));
      }

      function customerCancellationAllowed() {
        return resource.data.customerId == request.auth.uid
          && resource.data.bookingType in ["onsite-mechanic", "towing-company", "homegarage", "shop-owner"]
          && resource.data.status in ["pending", "accepted"]
          && request.resource.data.status == "cancelled"
          && optionalRiskEventIsValid("owner_cancel_after_acceptance", "accepted")
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt", "cancellationReason", "riskEventType", "riskEventAt"])
          && optionalBookingReasonIsValid(request.resource.data, "cancellationReason")
          && request.resource.data.updatedAt == request.time
          && reservationReleasedFor(resource.data);
      }

      allow get, list: if isAdmin();
      allow create: if accountIsActive(request.auth.uid)
        && accountIsActive(request.resource.data.providerId)
        && (request.resource.data.bookingType == "homegarage"
        ? (validHomeGarageBooking() && validHomeGarageBookingLock(bookingId))
        : request.resource.data.bookingType == "towing-company"
          ? (validBookingBase() && validTowingBookingProvider())
          : (validBookingBase()
            && ((validShopBooking() && validShopBookingLock(bookingId))
              || (validBookingProvider() && validMechanicBooking()))));
      allow get, list: if signedIn()
        && (resource.data.customerId == request.auth.uid
          || resource.data.providerId == request.auth.uid);
      allow update: if signedIn() && (providerUpdateAllowed() || customerCancellationAllowed());
      allow delete: if false;
    }

    match /providerReviews/{reviewId} {
      allow get, list: if signedIn();
      allow create: if validProviderReview(reviewId) || validParkingProviderReview(reviewId);
      allow update, delete: if false;
    }

    // Staff requests record manual review only; they never grant an Auth admin claim.
    match /adminStaffRequests/{requestId} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(["uid", "email", "displayName", "status", "requestedAt"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.status == "PENDING"
        && request.resource.data.requestedAt == request.time;
      allow update: if isAdmin()
        && resource.data.status == "PENDING"
        && resource.data.uid != request.auth.uid
        && request.resource.data.keys().hasOnly(["uid", "email", "displayName", "status", "requestedAt", "reviewedBy", "reviewedAt"])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "reviewedBy", "reviewedAt"])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.displayName == resource.data.displayName
        && request.resource.data.requestedAt == resource.data.requestedAt
        && request.resource.data.status in ["MANUAL_GRANT_RECORDED", "REJECTED"]
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
