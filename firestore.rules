rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Temporary rollout compatibility: a missing reason is accepted for old
    // clients, but a supplied reason must contain non-whitespace text.
    function optionalBookingReasonIsValid(data, field) {
      return !data.keys().hasAny([field])
        || (data[field] is string
          && data[field].matches('(?s).*\\S.*')
          && data[field].size() <= 500);
    }

    // Compatibility phase: legacy clients may omit both risk fields. Updated
    // clients must provide the matching event type and server timestamp.
    function optionalRiskEventIsValid(eventType, previousStatus) {
      let data = request.resource.data;
      let hasType = data.keys().hasAny(["riskEventType"]);
      let hasAt = data.keys().hasAny(["riskEventAt"]);
      return (!hasType && !hasAt)
        || (hasType && hasAt
          && data.riskEventType == eventType
          && data.riskEventAt == request.time
          && resource.data.status == previousStatus);
    }

    function accountIsActive(uid) {
      let userPath = /databases/$(database)/documents/users/$(uid);
      return !exists(userPath)
        || get(userPath).data.get("accountStatus", "active") == "active";
    }

    function isDocumentOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.get("admin", false) == true;
    }

    function listingHiddenAfterReview(uid) {
      let listing = /databases/$(database)/documents/providerListings/$(uid);
      return !existsAfter(listing) || getAfter(listing).data.visibility == "inactive";
    }

    function adminReviewedProfile(path) {
      return existsAfter(path)
        && getAfter(path).data.verificationStatus in ["VERIFIED", "REJECTED"]
        && getAfter(path).data.reviewedAt == request.time
        && getAfter(path).data.reviewedBy == request.auth.uid;
    }

    function validAdminListingHide(uid) {
      let userPath = /databases/$(database)/documents/users/$(uid);
      let role = resource.data.role;
      let reviewedRoleProfile = role == "owner"
        ? adminReviewedProfile(/databases/$(database)/documents/users/$(uid)/ownerProfile/profile)
        : role == "onsite-mechanic"
          ? adminReviewedProfile(/databases/$(database)/documents/users/$(uid)/providerProfile/profile)
          : role == "towing-company"
            ? adminReviewedProfile(/databases/$(database)/documents/users/$(uid)/towingCompanyProfile/profile)
            : role == "homegarage"
              ? adminReviewedProfile(/databases/$(database)/documents/users/$(uid)/homeGarageVerification/profile)
              : role == "shop-owner"
                ? (adminReviewedProfile(/databases/$(database)/documents/users/$(uid)/shopVerification/profile)
                  || adminReviewedProfile(/databases/$(database)/documents/providers/$(uid)))
                : false;
      return isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["visibility"])
        && request.resource.data.visibility == "inactive"
        && (reviewedRoleProfile
          || (existsAfter(userPath)
            && getAfter(userPath).data.accountStatus == "suspended"
            && getAfter(userPath).data.accountStatusUpdatedAt == request.time
            && getAfter(userPath).data.accountStatusUpdatedBy == request.auth.uid));
    }

    function providerWasPublicBeforeSuspension(uid, role) {
      let userPath = /databases/$(database)/documents/users/$(uid);
      let suspensionPath = /databases/$(database)/documents/providerStatusHistory/$(get(userPath).data.accountStatusNotificationId);
      return exists(userPath)
        && get(userPath).data.get("accountStatus", "active") == "suspended"
        && get(userPath).data.accountStatusNotificationId is string
        && exists(suspensionPath)
        && get(suspensionPath).data.providerId == uid
        && get(suspensionPath).data.role == role
        && get(suspensionPath).data.newStatus == "suspended"
        && get(suspensionPath).data.listingVisibilityBeforeSuspension == "active";
    }

    function adminProviderApprovalIsCurrent(uid, role) {
      let userPath = /databases/$(database)/documents/users/$(uid);
      let mechanicPath = /databases/$(database)/documents/users/$(uid)/providerProfile/profile;
      let towingPath = /databases/$(database)/documents/users/$(uid)/towingCompanyProfile/profile;
      let garagePath = /databases/$(database)/documents/users/$(uid)/homeGarageVerification/profile;
      let shopPath = /databases/$(database)/documents/providers/$(uid);
      let shopVerificationPath = /databases/$(database)/documents/users/$(uid)/shopVerification/profile;
      return exists(userPath) && get(userPath).data.role == role
        && (role == "onsite-mechanic"
          ? exists(mechanicPath) && get(mechanicPath).data.uid == uid
            && get(mechanicPath).data.role == role && get(mechanicPath).data.verificationStatus == "VERIFIED"
          : role == "towing-company"
            ? exists(towingPath) && get(towingPath).data.uid == uid
              && get(towingPath).data.role == role && get(towingPath).data.verificationStatus == "VERIFIED"
            : role == "homegarage"
              ? exists(garagePath) && get(garagePath).data.uid == uid
                && get(garagePath).data.role == role && get(garagePath).data.verificationStatus == "VERIFIED"
                && get(garagePath).data.business.name is string
                && get(garagePath).data.business.name.size() > 0
              : role == "shop-owner"
                ? exists(shopPath) && get(shopPath).data.uid == uid
                  && get(shopPath).data.role == role && get(shopPath).data.verified == true
                  && exists(shopVerificationPath)
                  && get(shopVerificationPath).data.uid == uid
                  && get(shopVerificationPath).data.role == role
                  && get(shopVerificationPath).data.verificationStatus == "VERIFIED"
                : false);
    }

    function validAdminListingRestore(uid) {
      let userPath = /databases/$(database)/documents/users/$(uid);
      let listingPath = /databases/$(database)/documents/providerListings/$(uid);
      let restorePath = /databases/$(database)/documents/providerStatusHistory/$(get(userPath).data.accountStatusNotificationId);
      let suspensionPath = /databases/$(database)/documents/providerStatusHistory/$(get(restorePath).data.previousStatusNotificationId);
      let role = resource.data.role;
      return isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["visibility"])
        && resource.data.visibility == "inactive"
        && request.resource.data.visibility == "active"
        && exists(userPath)
        && get(userPath).data.accountStatus == "active"
        && get(userPath).data.accountStatusNotificationId is string
        && exists(restorePath)
        && get(restorePath).data.providerId == uid
        && get(restorePath).data.role == role
        && get(restorePath).data.previousStatus == "suspended"
        && get(restorePath).data.newStatus == "active"
        && get(restorePath).data.listingRestored == false
        && get(restorePath).data.previousStatusNotificationId is string
        && exists(suspensionPath)
        && get(suspensionPath).data.providerId == uid
        && get(suspensionPath).data.role == role
        && get(suspensionPath).data.newStatus == "suspended"
        && get(suspensionPath).data.listingVisibilityBeforeSuspension == "active"
        && getAfter(listingPath).data.visibility == "active"
        && adminProviderApprovalIsCurrent(uid, role)
        && request.resource.data.providerId == uid
        && request.resource.data.role == role
        && request.resource.data.category == (role == "onsite-mechanic" ? "Onsite Mechanics"
          : role == "towing-company" ? "Towing"
          : role == "homegarage" ? "Parking Lots" : "Auto Shops")
        && hasExactPublicListingShape()
        && hasValidProviderControlledFields()
        && hasValidRoleSpecificServices()
        && (role != "shop-owner" || validShopListingProfile(uid))
        && (role != "homegarage" || validHomeGarageListingProfile(uid));
    }

    function validShopReview(uid) {
      let shop = request.resource.data;
      let verification = getAfter(/databases/$(database)/documents/users/$(uid)/shopVerification/profile).data;
      return validAdminReview(uid, "shop-owner", true)
        && (shop.verificationStatus == "REJECTED" || (
          shop.businessName is string && shop.businessName.size() > 0
          && shop.businessName != "Unnamed Auto Shop"
          && shop.phone is string && shop.phone.size() > 0
          && shop.address is string && shop.address.size() > 0
          && shop.latitude is number && shop.latitude >= -90 && shop.latitude <= 90
          && shop.longitude is number && shop.longitude >= -180 && shop.longitude <= 180
          && shop.businessName == verification.business.name
          && shop.phone == verification.business.phone
          && shop.address == verification.business.address
          && shop.latitude == verification.business.latitude
          && shop.longitude == verification.business.longitude
          && !(shop.latitude == 0 && shop.longitude == 0)));
    }

    function validProviderStatusHistory(historyId) {
      let event = request.resource.data;
      let account = getAfter(/databases/$(database)/documents/users/$(event.providerId)).data;
      let listingPath = /databases/$(database)/documents/providerListings/$(event.providerId);
      return isAdmin()
        && event.keys().hasOnly(["providerId", "role", "previousStatus", "newStatus", "changedAt", "changedBy", "listingVisibilityBeforeSuspension", "listingRestored", "previousStatusNotificationId"])
        && event.providerId is string
        && event.role in ["onsite-mechanic", "shop-owner", "towing-company", "homegarage", "owner"]
        && event.previousStatus in ["active", "suspended"]
        && event.newStatus in ["active", "suspended"]
        && event.newStatus != event.previousStatus
        && event.changedAt == request.time
        && event.changedBy == request.auth.uid
        && account.uid == event.providerId
        && account.role == event.role
        && account.accountStatus == event.newStatus
        && account.accountStatusUpdatedAt == request.time
        && account.accountStatusUpdatedBy == request.auth.uid
        && account.accountStatusNotificationId == historyId
        && (!event.keys().hasAny(["previousStatusNotificationId"])
          || (event.newStatus == "active" && event.previousStatus == "suspended"
            && event.previousStatusNotificationId is string
            && get(/databases/$(database)/documents/users/$(event.providerId)).data.accountStatus == "suspended"
            && get(/databases/$(database)/documents/users/$(event.providerId)).data.accountStatusNotificationId == event.previousStatusNotificationId
            && exists(/databases/$(database)/documents/providerStatusHistory/$(event.previousStatusNotificationId))
            && get(/databases/$(database)/documents/providerStatusHistory/$(event.previousStatusNotificationId)).data.providerId == event.providerId
            && get(/databases/$(database)/documents/providerStatusHistory/$(event.previousStatusNotificationId)).data.role == event.role
            && get(/databases/$(database)/documents/providerStatusHistory/$(event.previousStatusNotificationId)).data.newStatus == "suspended"))
        && (!event.keys().hasAny(["listingVisibilityBeforeSuspension"])
          || (event.newStatus == "suspended" && event.role != "owner"
            && event.listingVisibilityBeforeSuspension in ["active", "inactive", "missing"]
            && (event.listingVisibilityBeforeSuspension == "active"
              ? exists(listingPath) && get(listingPath).data.visibility == "active"
              : event.listingVisibilityBeforeSuspension == "inactive"
                ? (!exists(listingPath) || get(listingPath).data.visibility != "active")
                : !exists(listingPath))))
        && (!event.keys().hasAny(["listingRestored"])
          || (event.newStatus == "active" && event.listingRestored is bool
            && (!event.listingRestored || (event.role != "owner"
              && providerWasPublicBeforeSuspension(event.providerId, event.role)
              && adminProviderApprovalIsCurrent(event.providerId, event.role)
              && existsAfter(listingPath)
              && getAfter(listingPath).data.visibility == "active"
              && getAfter(listingPath).data.role == event.role))));
    }

    function validAdminListingRestoreHistory(historyId) {
      let event = resource.data;
      let after = request.resource.data;
      let userPath = /databases/$(database)/documents/users/$(event.providerId);
      let listingPath = /databases/$(database)/documents/providerListings/$(event.providerId);
      let suspensionPath = /databases/$(database)/documents/providerStatusHistory/$(event.previousStatusNotificationId);
      return isAdmin()
        && after.diff(event).affectedKeys().hasOnly(["listingRestored"])
        && event.listingRestored == false && after.listingRestored == true
        && event.newStatus == "active" && event.previousStatus == "suspended"
        && event.providerId is string && event.role != "owner"
        && get(userPath).data.accountStatus == "active"
        && get(userPath).data.accountStatusNotificationId == historyId
        && event.previousStatusNotificationId is string
        && exists(suspensionPath)
        && get(suspensionPath).data.providerId == event.providerId
        && get(suspensionPath).data.role == event.role
        && get(suspensionPath).data.newStatus == "suspended"
        && get(suspensionPath).data.listingVisibilityBeforeSuspension == "active"
        && adminProviderApprovalIsCurrent(event.providerId, event.role)
        && existsAfter(listingPath)
        && getAfter(listingPath).data.visibility == "active";
    }

    function validProviderVerificationHistory() {
      let event = request.resource.data;
      return isAdmin()
        && event.keys().hasOnly(["providerId", "providerName", "role", "decision", "reviewedAt", "reviewedBy"])
        && event.providerId is string
        && event.providerName is string
        && event.role in ["onsite-mechanic", "shop-owner", "towing-company", "homegarage", "owner"]
        && event.decision in ["VERIFIED", "REJECTED"]
        && event.reviewedAt == request.time
        && event.reviewedBy == request.auth.uid
        && ((event.role == "owner"
            && existsAfter(/databases/$(database)/documents/users/$(event.providerId)/ownerProfile/profile)
            && getAfter(/databases/$(database)/documents/users/$(event.providerId)/ownerProfile/profile).data.verificationStatus == event.decision
            && getAfter(/databases/$(database)/documents/users/$(event.providerId)/ownerProfile/profile).data.reviewedAt == request.time
            && getAfter(/databases/$(database)/documents/users/$(event.providerId)/ownerProfile/profile).data.reviewedBy == request.auth.uid)
          || (event.role == "onsite-mechanic"
            && existsAfter(/databases/$(database)/documents/users/$(event.providerId)/providerProfile/profile)
            && getAfter(/databases/$(database)/documents/users/$(event.providerId)/providerProfile/profile).data.verificationStatus == event.decision
            && getAfter(/databases/$(database)/documents/users/$(event.providerId)/providerProfile/profile).data.reviewedAt == request.time
            && getAfter(/databases/$(database)/documents/users/$(event.providerId)/providerProfile/profile).data.reviewedBy == request.auth.uid)
          || (event.role == "towing-company"
            && existsAfter(/databases/$(database)/documents/users/$(event.providerId)/towingCompanyProfile/profile)
            && getAfter(/databases/$(database)/documents/users/$(event.providerId)/towingCompanyProfile/profile).data.verificationStatus == event.decision
            && getAfter(/databases/$(database)/documents/users/$(event.providerId)/towingCompanyProfile/profile).data.reviewedAt == request.time
            && getAfter(/databases/$(database)/documents/users/$(event.providerId)/towingCompanyProfile/profile).data.reviewedBy == request.auth.uid)
          || (event.role == "shop-owner"
            && existsAfter(/databases/$(database)/documents/providers/$(event.providerId))
            && getAfter(/databases/$(database)/documents/providers/$(event.providerId)).data.verificationStatus == event.decision
            && getAfter(/databases/$(database)/documents/providers/$(event.providerId)).data.reviewedAt == request.time
            && getAfter(/databases/$(database)/documents/providers/$(event.providerId)).data.reviewedBy == request.auth.uid)
          || (event.role == "homegarage"
            && existsAfter(/databases/$(database)/documents/users/$(event.providerId)/homeGarageVerification/profile)
            && getAfter(/databases/$(database)/documents/users/$(event.providerId)/homeGarageVerification/profile).data.verificationStatus == event.decision
            && getAfter(/databases/$(database)/documents/users/$(event.providerId)/homeGarageVerification/profile).data.reviewedAt == request.time
            && getAfter(/databases/$(database)/documents/users/$(event.providerId)/homeGarageVerification/profile).data.reviewedBy == request.auth.uid));
    }

    function validAdminAccountStatusNotification(uid, notificationId) {
      let event = request.resource.data;
      let userPath = /databases/$(database)/documents/users/$(uid);
      return isAdmin()
        && event.keys().hasOnly([
          "notificationId", "providerId", "providerRole", "status", "previousStatus", "title", "message", "reason",
          "isRead", "readAt", "createdAt", "updatedAt"
        ])
        && event.notificationId == notificationId
        && event.providerId == uid
        && event.providerRole in ["onsite-mechanic", "shop-owner", "towing-company", "homegarage", "owner"]
        && event.status in ["SUSPENDED", "ACTIVE"]
        && (!event.keys().hasAny(["previousStatus"])
          || event.previousStatus == null
          || (event.previousStatus is string && event.previousStatus.size() <= 20))
        && event.title is string && event.message is string
        && (event.reason == null || (event.reason is string && event.reason.size() <= 500))
        && event.isRead == false && event.readAt == null
        && event.createdAt == request.time && event.updatedAt == request.time
        && get(userPath).data.role == event.providerRole
        && get(userPath).data.get("accountStatus", "active") != (event.status == "SUSPENDED" ? "suspended" : "active")
        && getAfter(userPath).data.role == event.providerRole
        && getAfter(userPath).data.accountStatus == (event.status == "SUSPENDED" ? "suspended" : "active")
        && getAfter(userPath).data.accountStatusUpdatedAt == request.time
        && getAfter(userPath).data.accountStatusUpdatedBy == request.auth.uid
        && getAfter(userPath).data.accountStatusNotificationId == notificationId;
    }

    function validAdminVerificationNotification(uid, notificationId) {
      let event = request.resource.data;
      let profilePath = event.providerRole == "owner"
        ? /databases/$(database)/documents/users/$(uid)/ownerProfile/profile
        : event.providerRole == "onsite-mechanic"
          ? /databases/$(database)/documents/users/$(uid)/providerProfile/profile
          : event.providerRole == "towing-company"
            ? /databases/$(database)/documents/users/$(uid)/towingCompanyProfile/profile
            : event.providerRole == "homegarage"
              ? /databases/$(database)/documents/users/$(uid)/homeGarageVerification/profile
              : /databases/$(database)/documents/providers/$(uid);
      let beforeProfile = get(profilePath).data;
      let afterProfile = getAfter(profilePath).data;
      return isAdmin()
        && event.keys().hasOnly([
          "notificationId", "providerId", "providerRole", "status", "previousStatus", "title", "message", "reason",
          "isRead", "readAt", "createdAt", "updatedAt"
        ])
        && event.notificationId == notificationId
        && event.providerId == uid
        && event.providerRole in ["onsite-mechanic", "shop-owner", "towing-company", "homegarage", "owner"]
        && event.status in ["VERIFIED", "REJECTED"]
        && (!event.keys().hasAny(["previousStatus"])
          || event.previousStatus == null
          || (event.previousStatus is string && event.previousStatus.size() <= 20))
        && event.title is string && event.message is string
        && (event.reason == null || (event.reason is string && event.reason.size() <= 500))
        && event.isRead == false && event.readAt == null
        && event.createdAt == request.time && event.updatedAt == request.time
        && beforeProfile.get("verificationStatus", "") != event.status
        && afterProfile.verificationStatus == event.status
        && afterProfile.reviewedBy == request.auth.uid
        && afterProfile.reviewedAt == request.time
        && afterProfile.lastStatusNotificationId == notificationId;
    }

    function isPendingVerificationSubmission() {
      return request.resource.data.verificationStatus == "PENDING";
    }

    function validAdminReview(uid, role, shop) {
      let before = resource.data;
      let after = request.resource.data;
      let notificationPath = /databases/$(database)/documents/users/$(uid)/accountStatusNotifications/$(after.lastStatusNotificationId);
      return isAdmin()
        && before.uid == uid && before.role == role
        && get(/databases/$(database)/documents/users/$(uid)).data.role == role
        && (before.get("verificationStatus", "") == "PENDING"
          || (shop && !("verificationStatus" in before) && before.verified == false))
        && (!shop || before.verified == false)
        && after.diff(before).affectedKeys().hasOnly(shop
          ? ["verificationStatus", "reviewedAt", "reviewedBy", "rejectionReason", "verified", "lastStatusNotificationId",
            "businessName", "phone", "address", "latitude", "longitude"]
          : ["verificationStatus", "reviewedAt", "reviewedBy", "rejectionReason", "verified", "lastStatusNotificationId"])
        && (shop || !after.diff(before).affectedKeys().hasAny(["verified"]))
        && after.verificationStatus in ["VERIFIED", "REJECTED"]
        && after.reviewedAt == request.time && after.reviewedBy == request.auth.uid
        && after.lastStatusNotificationId is string
        && existsAfter(notificationPath)
        && getAfter(notificationPath).data.status == after.verificationStatus
        && getAfter(notificationPath).data.providerId == uid
        && getAfter(notificationPath).data.providerRole == role
        && ((after.verificationStatus == "VERIFIED" && after.rejectionReason == "")
          || (after.verificationStatus == "REJECTED" && after.rejectionReason is string && after.rejectionReason.size() >= 5 && after.rejectionReason.size() <= 500))
        && (!shop || after.verified == (after.verificationStatus == "VERIFIED"))
        && listingHiddenAfterReview(uid);
    }

    function validAdminAccountStatus(uid) {
      let before = resource.data;
      let after = request.resource.data;
      let notificationPath = /databases/$(database)/documents/users/$(uid)/accountStatusNotifications/$(after.accountStatusNotificationId);
      return isAdmin()
        && before.uid == uid
        && before.role in ["onsite-mechanic", "shop-owner", "towing-company", "homegarage", "owner"]
        && after.role == before.role && after.uid == before.uid
        && after.diff(before).affectedKeys().hasOnly(["accountStatus", "accountStatusUpdatedAt", "accountStatusUpdatedBy", "accountStatusNotificationId"])
        && after.accountStatus in ["active", "suspended"]
        && after.accountStatus != before.get("accountStatus", "active")
        && after.accountStatusUpdatedAt == request.time
        && after.accountStatusUpdatedBy == request.auth.uid
        && after.accountStatusNotificationId is string
        && existsAfter(notificationPath)
        && getAfter(notificationPath).data.status == (after.accountStatus == "suspended" ? "SUSPENDED" : "ACTIVE")
        && getAfter(notificationPath).data.providerId == uid
        && getAfter(notificationPath).data.providerRole == before.role;
    }

    function verifiedMechanic(uid) {
      let profilePath = /databases/$(database)/documents/users/$(uid)/providerProfile/profile;
      return exists(profilePath)
        && get(profilePath).data.uid == request.auth.uid
        && get(profilePath).data.role == "onsite-mechanic"
        && get(profilePath).data.verificationStatus == "VERIFIED";
    }

    function verifiedTowingCompany(uid) {
      let profilePath = /databases/$(database)/documents/users/$(uid)/towingCompanyProfile/profile;
      return exists(profilePath)
        && get(profilePath).data.uid == request.auth.uid
        && get(profilePath).data.role == "towing-company"
        && get(profilePath).data.verificationStatus == "VERIFIED";
    }

    function verifiedHomeGarage(uid) {
      let profilePath = /databases/$(database)/documents/users/$(uid)/homeGarageVerification/profile;
      return exists(profilePath)
        && get(profilePath).data.uid == request.auth.uid
        && get(profilePath).data.role == "homegarage"
        && get(profilePath).data.verificationStatus == "VERIFIED";
    }

    function approvedHomeGarage(uid) {
      let profilePath = /databases/$(database)/documents/users/$(uid)/homeGarageVerification/profile;
      return exists(profilePath)
        && get(profilePath).data.uid == uid
        && get(profilePath).data.role == "homegarage"
        && get(profilePath).data.verificationStatus == "VERIFIED";
    }

    function hasExactPublicListingShape() {
      return request.resource.data.keys().hasOnly([
          "providerId", "role", "category", "businessName", "location",
          "availability", "visibility", "ratingSummary", "services",
          "vehicleTypes", "serviceAreaLabel", "description", "contactPhone", "startingPrice", "operatingHours",
          "emergencyServiceAvailable", "acceptsScheduledBookings", "photoUrls", "hoursType", "is24Hours", "weeklyHours", "totalSlots", "availableSlots"
        ])
        && request.resource.data.location.keys().hasOnly(["latitude", "longitude"])
        && request.resource.data.ratingSummary.keys().hasOnly(["average", "count"]);
    }

    function hasValidProviderControlledFields() {
      let latitude = request.resource.data.location.latitude;
      let longitude = request.resource.data.location.longitude;
      return request.resource.data.businessName is string
        && request.resource.data.businessName.size() > 0
        && request.resource.data.businessName.size() <= 120
        && latitude is number
        && latitude >= -90
        && latitude <= 90
        && longitude is number
        && longitude >= -180
        && longitude <= 180
        && !(latitude == 0 && longitude == 0)
        && request.resource.data.availability in ["available", "busy", "offline"]
        && request.resource.data.serviceAreaLabel is string
        && request.resource.data.serviceAreaLabel.size() >= 2
        && request.resource.data.serviceAreaLabel.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 600
        && (!request.resource.data.keys().hasAny(["contactPhone"])
          || (request.resource.data.contactPhone is string
            && request.resource.data.contactPhone.size() >= 7
            && request.resource.data.contactPhone.size() <= 30))
        && request.resource.data.operatingHours is string
        && request.resource.data.operatingHours.size() >= 2
        && request.resource.data.operatingHours.size() <= 200
        && request.resource.data.services is list
        && request.resource.data.services.size() >= 1
        && ((request.resource.data.role == "shop-owner"
              && request.resource.data.services.size() <= 7)
          || (request.resource.data.role != "shop-owner"
              && request.resource.data.services.size() <= 6))
        && request.resource.data.vehicleTypes is list
        && request.resource.data.vehicleTypes.size() >= 1
        && request.resource.data.vehicleTypes.size() <= 6
        && request.resource.data.vehicleTypes.hasOnly([
          "Car", "Cars", "SUV", "SUVs", "Pickup Truck", "Pickup Trucks",
          "Van", "Vans", "Motorcycle", "Motorcycles", "Truck"
        ])
        && (request.resource.data.startingPrice == null
          || (request.resource.data.startingPrice is number
            && request.resource.data.startingPrice >= 0
            && request.resource.data.startingPrice <= 1000000))
        && request.resource.data.emergencyServiceAvailable is bool
        && (!request.resource.data.keys().hasAny(["acceptsScheduledBookings"])
          || request.resource.data.acceptsScheduledBookings is bool)
        && (!request.resource.data.keys().hasAny(["photoUrls"])
          || (request.resource.data.photoUrls is list
            && request.resource.data.photoUrls.size() <= 3))
        && (request.resource.data.role != "shop-owner"
          || ((!request.resource.data.keys().hasAny(["hoursType", "is24Hours", "weeklyHours"]))
            || (request.resource.data.hoursType in ["24_7", "same_daily", "weekly"]
              && request.resource.data.is24Hours is bool
              && request.resource.data.is24Hours == (request.resource.data.hoursType == "24_7")
              && request.resource.data.weeklyHours is list
              && request.resource.data.weeklyHours.size() == 7
              && request.resource.data.weeklyHours[0].day == "Monday"
              && request.resource.data.weeklyHours[1].day == "Tuesday"
              && request.resource.data.weeklyHours[2].day == "Wednesday"
              && request.resource.data.weeklyHours[3].day == "Thursday"
              && request.resource.data.weeklyHours[4].day == "Friday"
              && request.resource.data.weeklyHours[5].day == "Saturday"
              && request.resource.data.weeklyHours[6].day == "Sunday")))
        && (request.resource.data.role != "homegarage"
          || ((!request.resource.data.keys().hasAny(["totalSlots"])
              && !request.resource.data.keys().hasAny(["availableSlots"]))
            || (request.resource.data.totalSlots is int
              && request.resource.data.totalSlots >= 1
              && request.resource.data.totalSlots <= 500
              && request.resource.data.availableSlots is int
              && request.resource.data.availableSlots >= 0
              && request.resource.data.availableSlots <= request.resource.data.totalSlots)));
    }

    function hasFixedMapCompatibilityFields(uid) {
      return request.resource.data.providerId == uid
        && request.resource.data.visibility == "active"
        && request.resource.data.ratingSummary.average == 0
        && request.resource.data.ratingSummary.count == 0
        ;
    }

    function hasValidRoleSpecificServices() {
      return request.resource.data.role == "onsite-mechanic"
        ? request.resource.data.services.hasOnly([
            "Engine Diagnostics", "Battery Replacement", "Brake Repair",
            "Tire Replacement", "Electrical Repair", "Air Conditioning"
          ])
        : request.resource.data.role == "shop-owner"
          ? request.resource.data.services.hasOnly([
            "Oil change", "Brake service", "Engine repair", "Battery service",
            "Tire service", "Air-conditioning service", "Preventive maintenance"
          ])
          : request.resource.data.role == "towing-company"
            ? request.resource.data.services.hasOnly([
            "Flatbed Towing", "Wheel-Lift Towing", "Emergency Roadside Assistance",
            "Accident Recovery", "Motorcycle Towing"
          ])
          : request.resource.data.role == "homegarage"
              ? request.resource.data.services.hasOnly([
                "Oil change", "Brake service", "Engine repair", "Battery service",
                "Tire service", "Air-conditioning service"
              ])
              : false;
    }

    function hasVerifiedRoleAndCategory(uid) {
      return request.resource.data.role == "onsite-mechanic"
        ? request.resource.data.category == "Onsite Mechanics" && verifiedMechanic(uid)
        : request.resource.data.role == "towing-company"
          ? request.resource.data.category == "Towing" && verifiedTowingCompany(uid)
          : request.resource.data.role == "shop-owner"
            ? request.resource.data.category == "Auto Shops" && verifiedShop(uid) && validShopListingProfile(uid)
            : request.resource.data.role == "homegarage"
              ? request.resource.data.category == "Parking Lots"
                && get(/databases/$(database)/documents/users/$(uid)).data.role == "homegarage"
                && verifiedHomeGarage(uid) && validHomeGarageListingProfile(uid)
              : false;
    }

    function validPublicListingWrite(uid) {
      return signedIn()
        && request.auth.uid == uid
        && hasExactPublicListingShape()
        && hasValidProviderControlledFields()
        && hasFixedMapCompatibilityFields(uid)
        && hasValidRoleSpecificServices()
        && hasVerifiedRoleAndCategory(uid);
    }

    function validPublicListingCreate(uid) {
      return validPublicListingWrite(uid)
        && (request.resource.data.role != "shop-owner"
          || (request.resource.data.keys().hasAll(["photoUrls", "hoursType", "is24Hours", "weeklyHours"])
            && (!request.resource.data.keys().hasAny(["contactPhone"])
              || (request.resource.data.contactPhone is string && request.resource.data.contactPhone.size() >= 7))
            && request.resource.data.photoUrls is list
            && request.resource.data.hoursType in ["24_7", "same_daily", "weekly"]
            && request.resource.data.is24Hours is bool
            && request.resource.data.weeklyHours is list));
    }

    function verifiedVehicleOwner(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role == "owner"
        && get(/databases/$(database)/documents/users/$(uid)/ownerProfile/profile).data.verificationStatus == "VERIFIED";
    }

    function validBookingBase() {
      let booking = request.resource.data;
      return signedIn()
        && verifiedVehicleOwner(request.auth.uid)
        && booking.customerId == request.auth.uid
        && booking.customerId is string
        && booking.providerId is string
        && booking.providerId != request.auth.uid
        && booking.customerName is string
        && booking.customerName.size() > 0
        && booking.customerName.size() <= 120
        && booking.customerEmail is string
        && booking.customerEmail.size() <= 254
        // Towing validates providerName against the active listing below; avoid duplicate shape checks here.
        && (booking.bookingType == "towing-company"
          ? (booking.customerPhone is string
            && booking.customerPhone.size() > 0
            && booking.customerPhone.size() <= 30
            && booking.customerPhone == get(/databases/$(database)/documents/users/$(request.auth.uid)/ownerProfile/profile).data.personal.phone)
          : (!booking.keys().hasAny(["customerPhone"])
            || (booking.customerPhone is string && booking.customerPhone.size() <= 30)))
        && (!booking.keys().hasAny(["customerAddress"])
          || (booking.customerAddress is string
            && booking.customerAddress.size() <= 300))
        && (booking.bookingType == "towing-company"
          || (booking.providerName is string
            && booking.providerName.size() > 0
            && booking.providerName.size() <= 120))
        && booking.vehicleId is string
        && booking.vehicleId.size() > 0
        && booking.vehicle is string
        && booking.vehicle.size() > 0
        && booking.vehicle.size() <= 120
        && booking.vehicleYear is int
        && booking.vehicleYear >= 1900
        && booking.vehicleYear <= 2100
        && booking.vehiclePlate is string
        && booking.vehiclePlate.size() <= 30
        && booking.latitude is number
        && booking.latitude >= -90
        && booking.latitude <= 90
        && booking.longitude is number
        && booking.longitude >= -180
        && booking.longitude <= 180
        && !(booking.latitude == 0 && booking.longitude == 0)
        && booking.notes is string
        && booking.notes.size() <= 1000
        && booking.startingPrice is string
        && booking.startingPrice.size() <= 60
        && booking.status == "pending"
        && booking.createdAt == request.time
        && booking.updatedAt == request.time;
    }

    function validBookingProvider() {
      let listing = get(/databases/$(database)/documents/providerListings/$(request.resource.data.providerId));
      return listing.data.providerId == request.resource.data.providerId
        && listing.data.businessName == request.resource.data.providerName
        && listing.data.visibility == "active"
        && listing.data.role == request.resource.data.bookingType
        && validBookingTiming(listing.data);
    }

    // Towing evaluates its listing binding and timing from the same read used
    // by its route-coordinate checks below.
    function validTowingBookingProvider() {
      let booking = request.resource.data;
      let listing = get(/databases/$(database)/documents/providerListings/$(booking.providerId)).data;
      return listing.providerId == booking.providerId
        && listing.businessName == booking.providerName
        && listing.visibility == "active"
        && listing.role == "towing-company"
        && validBookingTiming(listing)
        && validTowingBooking(listing);
    }

    function validBookingTiming(listing) {
      let booking = request.resource.data;
      let scheduled = booking.timingMode == "scheduled";
      return booking.timingMode in ["now", "scheduled"]
        && booking.urgency in ["standard", "emergency"]
        && ((scheduled
          && booking.urgency == "standard"
          && listing.get("acceptsScheduledBookings", false) == true
          && booking.scheduledAt is timestamp
          && booking.scheduledAt > request.time
          && booking.scheduledAt.toMillis() % 3600000 == 0)
          || (!scheduled
            && !booking.keys().hasAny(["scheduledAt"])
            && listing.availability == "available"
            && (booking.urgency == "standard"
              || (booking.urgency == "emergency" && listing.emergencyServiceAvailable == true))));
    }

    function scheduleReservationPath(booking) {
      return /databases/$(database)/documents/providerScheduleReservations/$(booking.providerId + "_" + string(booking.scheduledAt.toMillis()));
    }

    function reservationClaimedFor(bookingId, booking) {
      return booking.get("timingMode", "now") != "scheduled"
        || (existsAfter(scheduleReservationPath(booking))
          && getAfter(scheduleReservationPath(booking)).data.bookingId == bookingId
          && getAfter(scheduleReservationPath(booking)).data.providerId == booking.providerId
          && getAfter(scheduleReservationPath(booking)).data.scheduledAt == booking.scheduledAt);
    }

    function reservationReleasedFor(booking) {
      return booking.get("timingMode", "now") != "scheduled"
        || !existsAfter(scheduleReservationPath(booking));
    }

    function validCustomerNotificationCreate(uid, notificationId) {
      let bookingPath = /databases/$(database)/documents/bookings/$(request.resource.data.bookingId);
      let previousBooking = get(bookingPath).data;
      let updatedBooking = getAfter(bookingPath).data;
      return signedIn()
        && request.resource.data.keys().hasOnly([
          "customerId", "bookingId", "bookingType", "providerId", "providerName",
          "status", "title", "message", "isRead", "readAt", "createdAt", "updatedAt"
        ])
        && request.resource.data.customerId == uid
        && request.resource.data.bookingId is string
        && request.resource.data.bookingType in ["onsite-mechanic", "towing-company", "shop-owner", "homegarage"]
        && request.resource.data.providerId == updatedBooking.providerId
        && request.resource.data.providerName is string
        && request.resource.data.providerName.size() <= 120
        && request.resource.data.status is string
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 100
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 300
        && request.resource.data.isRead == false
        && request.resource.data.readAt == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (notificationId == request.resource.data.bookingId
          || (request.resource.data.bookingType == "homegarage"
            && notificationId == request.resource.data.bookingId + "_assessment"))
        && exists(bookingPath)
        && existsAfter(bookingPath)
        && previousBooking.customerId == uid
        && previousBooking.providerId == updatedBooking.providerId
        && (previousBooking.status != request.resource.data.status
          || (request.resource.data.bookingType == "homegarage"
            && notificationId == request.resource.data.bookingId + "_assessment"
            && previousBooking.status == "accepted"
            && updatedBooking.status == "accepted"
            && updatedBooking.assessmentPrice is number))
        && updatedBooking.customerId == uid
        && updatedBooking.providerId == request.resource.data.providerId
        && updatedBooking.providerName == request.resource.data.providerName
        && updatedBooking.bookingType == request.resource.data.bookingType
        && updatedBooking.status == request.resource.data.status
        && (request.auth.uid == updatedBooking.providerId
          || (request.auth.uid == uid
            && request.resource.data.bookingType in ["onsite-mechanic", "towing-company", "shop-owner", "homegarage"]
            && previousBooking.status in ["pending", "accepted"]
            && updatedBooking.status == "cancelled"));
    }

